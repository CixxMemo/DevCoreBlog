      SELECT count(*)::int
      FROM "Posts" AS p
      INNER JOIN "Categories" AS c ON p."CategoryId" = c."Id"
      WHERE p."IsActive" AND p."IsPublished" AND p."PublishDate" <= @utcNow AND c."IsActive" AND c."Slug" = @categorySlug AND (p."Title" ILIKE @pattern ESCAPE '\' OR p."Content" ILIKE @pattern ESCAPE '\')

      SELECT p."Id", p."Title", p."Slug", p."Summary", p."ThumbnailUrl", c."Name", p."PublishDate", p."ViewCount"
      FROM "Posts" AS p
      INNER JOIN "Categories" AS c ON p."CategoryId" = c."Id"
      WHERE p."IsActive" AND p."IsPublished" AND p."PublishDate" <= @utcNow AND c."IsActive" AND c."Slug" = @categorySlug AND (p."Title" ILIKE @pattern ESCAPE '\' OR p."Content" ILIKE @pattern ESCAPE '\')
      ORDER BY p."Title" ILIKE @literal ESCAPE '\' DESC, p."Title" ILIKE @pattern ESCAPE '\' DESC, p."PublishDate" DESC, p."Id"
      LIMIT @p11 OFFSET @p

      SELECT p."Id", p."Title", p."Slug", p."Summary", p."ThumbnailUrl", c."Name", p."PublishDate", p."ViewCount"
      FROM "Posts" AS p
      INNER JOIN "Categories" AS c ON p."CategoryId" = c."Id"
      WHERE p."IsActive" AND p."IsPublished" AND p."PublishDate" <= @utcNow AND c."IsActive" AND c."Slug" = @categorySlug AND (p."Title" ILIKE @pattern ESCAPE '\' OR p."Content" ILIKE @pattern ESCAPE '\')
      ORDER BY p."Title" ILIKE @literal ESCAPE '\' DESC, p."Title" ILIKE @pattern ESCAPE '\' DESC, p."PublishDate" DESC, p."Id"
      LIMIT @p OFFSET @p
