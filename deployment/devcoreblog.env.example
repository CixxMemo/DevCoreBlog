# systemd EnvironmentFile syntax, not a dotenv file. Store real values outside the repository.
# /etc/devcoreblog/devcoreblog.env: root-owned mode 600. Empty credentials fail closed.
ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production
DEPLOYMENT_PROFILE=nginx-loopback
ASPNETCORE_URLS=http://127.0.0.1:5000
SITE_URL=https://blog.example
SITE_TIME_ZONE=Europe/Istanbul
DATA_PROTECTION_KEYS_PATH=/var/lib/devcoreblog/keys
DB_CONNECTION_STRING=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_LOGIN_PATH=
ADMIN_SESSION_VERSION=1
ADMIN_SESSION_LIFETIME_SECONDS=1800
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
WEBHOOK_API_SECRET=
ALLOW_WEBHOOK_PUBLISH=false
PORTFOLIO_CORS_ORIGIN=
