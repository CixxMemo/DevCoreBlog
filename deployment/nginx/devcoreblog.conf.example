# Include inside the nginx http block. Replace the domain and certificate paths together.
# Requires an actively supported Nginx with ngx_http_ssl_module (ssl_reject_handshake >= 1.19.4).
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 404;
}
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_reject_handshake on;
}
server {
    listen 80;
    listen [::]:80;
    server_name blog.example;
    return 308 https://blog.example$request_uri;
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name blog.example;
    ssl_certificate /etc/letsencrypt/live/blog.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/blog.example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Overwrite, never append untrusted client headers. No CDN/real_ip trust is configured.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Real-IP "";
        proxy_set_header Connection "";
        proxy_cache off;
        proxy_intercept_errors off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
