# Single-server Docker layout for the app and its own PostgreSQL. Copy to the server, then adapt.
# Nothing is published to the host: the app is reached only by the reverse-proxy container
# (Nginx Proxy Manager) over the "aether_edge" network at a fixed address. n8n and other stacks are untouched.
#
# The proxy joins this network from its own compose file, so recreating it keeps the address
# (DEPLOYMENT_PROXY_IP must match). In the NPM compose service:
#   ports: ['80:80', '127.0.0.1:81:81', '443:443']   # admin panel on loopback only, reached via an SSH tunnel
#   networks: { web-network: {}, aether_edge: { ipv4_address: 172.30.0.10 } }
# and at its top level: aether_edge: { external: true, name: aetherletter_aether_edge }
name: aetherletter
services:
  web:
    image: aetherletter-web:${WEB_TAG:?set WEB_TAG}
    restart: unless-stopped
    env_file: ./web.env            # real values, owner-only file on the server (never in Git)
    environment:
      DEPLOYMENT_PROFILE: nginx-docker
      ASPNETCORE_URLS: http://172.30.0.20:8080
      DEPLOYMENT_PROXY_IP: 172.30.0.10
    networks:
      aether_edge: { ipv4_address: 172.30.0.20 }
      aether_db: {}
    volumes:
      - aether_keys:/var/lib/devcoreblog/keys   # Data Protection key ring: never delete or reset
    depends_on: [db]
    read_only: true
    tmpfs: [/tmp]
    security_opt: [no-new-privileges:true]
    cap_drop: [ALL]
    logging: { driver: json-file, options: { max-size: "10m", max-file: "3" } }
  db:
    image: postgres:16-bookworm
    restart: unless-stopped
    env_file: ./db.env             # POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
    networks: [aether_db]
    volumes:
      - aether_pgdata:/var/lib/postgresql/data
    shm_size: 128mb
    logging: { driver: json-file, options: { max-size: "10m", max-file: "3" } }
networks:
  aether_edge:
    ipam: { config: [{ subnet: 172.30.0.0/24 }] }
  aether_db:
    internal: true
volumes:
  aether_keys: {}
  aether_pgdata: {}
