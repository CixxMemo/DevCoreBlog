# Docker env_file syntax: KEY=VALUE, no quotes. Real file: owner-only (chmod 600), outside Git.
# DEPLOYMENT_PROFILE / ASPNETCORE_URLS / DEPLOYMENT_PROXY_IP / DATA_PROTECTION_KEYS_PATH are set by compose and the image.
SITE_URL=
SITE_TIME_ZONE=Europe/Istanbul
# Host "db" is the PostgreSQL container on the internal aether_db network.
DB_CONNECTION_STRING=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_LOGIN_PATH=
ADMIN_SESSION_VERSION=1
ADMIN_SESSION_LIFETIME_SECONDS=1800
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
WEBHOOK_API_SECRET=
ALLOW_WEBHOOK_PUBLISH=false
PORTFOLIO_CORS_ORIGIN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
RESEND_REPLY_TO=
# Mail features stay closed until F51 acceptance; do not open them earlier.
SUBSCRIPTIONS_ENABLED=false
TRANSACTIONAL_EMAIL_WORKER_ENABLED=false
READER_LOGIN_ENABLED=false
NEWSLETTER_WORKER_ENABLED=false
NEWSLETTER_DELIVERY_READY=false
TEST_EMAIL_ENABLED=false
TEST_EMAIL_RECIPIENT=
RESEND_WEBHOOK_ENABLED=false
RESEND_WEBHOOK_SECRET=
RESEND_WEBHOOK_ALLOWED_SENDERS=
RETENTION_ENABLED=false
RETENTION_APPLY_ENABLED=false
