@* ============================================================================= *@
@* AdminPost/Index.cshtml — Blog Post List View (Tech Minimal — Dark Zinc) *@
@* ============================================================================= *@
@* This view displays a table of all blog posts with their category, publish *@
@* status, and creation date. It includes "Edit" and "Delete" actions per row *@
@* and a "New Post" button at the top. *@
@* *@
@* Phase 2 (FIX): Zinc dark palette. Border-based table (border-zinc-800). *@
@* Hover effect on rows (bg-zinc-900). Monospace font for technical fields. *@
@* Buttons: border border-zinc-700 bg-zinc-900 hover:bg-zinc-800 font-mono. *@
@* ============================================================================= *@

@model List<Post>

@{
    ViewData["Title"] = "Yazılar";
}

<div class="flex justify-between items-center mb-8">
    <h1 class="text-2xl font-bold tracking-tight text-zinc-100 font-mono">
        Yazılar
    </h1>
    <a asp-action="Create" 
       class="px-4 py-2 text-sm font-mono font-medium border border-zinc-700 bg-zinc-900 text-zinc-300 hover:bg-zinc-800 hover:text-zinc-100 rounded-sm transition-colors">
        + Yeni Yazı
    </a>
</div>

<div class="border border-zinc-800 rounded-sm overflow-hidden">
    <table class="w-full">
        <thead class="bg-zinc-900 border-b border-zinc-800">
            <tr>
                <th class="px-4 py-3 text-left text-xs font-mono font-semibold text-zinc-500 uppercase tracking-wider">Id</th>
                <th class="px-4 py-3 text-left text-xs font-mono font-semibold text-zinc-500 uppercase tracking-wider">Başlık</th>
                <th class="px-4 py-3 text-left text-xs font-mono font-semibold text-zinc-500 uppercase tracking-wider">Kategori</th>
                <th class="px-4 py-3 text-left text-xs font-mono font-semibold text-zinc-500 uppercase tracking-wider">Yayında</th>
                <th class="px-4 py-3 text-left text-xs font-mono font-semibold text-zinc-500 uppercase tracking-wider">Tarih</th>
                <th class="px-4 py-3 text-left text-xs font-mono font-semibold text-zinc-500 uppercase tracking-wider">İşlemler</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-zinc-800">
            @foreach (var item in Model)
            {
                <tr class="hover:bg-zinc-900/50 transition-colors">
                    <td class="px-4 py-3 text-sm font-mono text-zinc-500">@item.Id</td>
                    <td class="px-4 py-3 text-sm font-medium text-zinc-100">@item.Title</td>
                    <td class="px-4 py-3 text-sm text-zinc-400">@item.Category.Name</td>
                    <td class="px-4 py-3 text-sm">
                        @if (item.IsActive)
                        {
                            <span class="text-accent font-mono">✓</span>
                        }
                        else
                        {
                            <span class="text-zinc-600 font-mono">✗</span>
                        }
                    </td>
                    <td class="px-4 py-3 text-sm font-mono text-zinc-500">@item.CreatedDate.ToString("dd.MM.yyyy")</td>
                    <td class="px-4 py-3 text-sm">
                        <div class="flex items-center gap-2">
                            <a asp-action="Edit" asp-route-id="@item.Id" 
                               class="px-3 py-1 text-xs font-mono font-medium border border-zinc-700 bg-zinc-900 text-zinc-300 hover:bg-zinc-800 hover:text-zinc-100 rounded-sm transition-colors">
                                Düzenle
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="inline" onsubmit="return confirm('Bu yazıyı silmek istediğinize emin misiniz?');">
                                <button type="submit" 
                                        class="px-3 py-1 text-xs font-mono font-medium border border-zinc-700 bg-zinc-900 text-zinc-300 hover:bg-zinc-800 hover:text-red-400 rounded-sm transition-colors">
                                    Sil
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="border border-zinc-800 rounded-sm p-12 text-center mt-8">
        <p class="text-zinc-500 font-mono text-sm">Henüz yazı yok.</p>
    </div>
}
