@* ============================================================================= *@
@* AdminPost/Index.cshtml — Blog Post List View *@
@* ============================================================================= *@
@* This view displays a table of all blog posts with their category, publish *@
@* status, and creation date. It includes "Edit" and "Delete" actions per row *@
@* and a "New Post" button at the top. *@
@* ============================================================================= *@

@* The view expects a List<Post> passed from AdminPostController.Index() *@
@model List<Post>

@{
    ViewData["Title"] = "Yazılar";
}

@* ---- Page header with "New Post" button ---- *@
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Yazılar</h1>
    @* Green button linking to the Create form *@
    <a asp-action="Create" class="btn btn-success">Yeni Yazı</a>
</div>

@* ---- Post table ---- *@
<table class="table table-striped table-hover table-admin">
    <thead>
        <tr>
            <th>Id</th>
            <th>Başlık</th>
            <th>Kategori</th>
            <th>Yayında mı</th>
            <th>Oluşturulma Tarihi</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @* Loop through each post in the model list *@
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Title</td>
                @* Category name — available because the controller uses .Include(p => p.Category) *@
                <td>@item.Category.Name</td>
                @* Published status: checkmark (✓) for published, cross (✗) for draft *@
                <td>@(item.IsPublished ? "✓" : "✗")</td>
                @* Creation date formatted as day.month.year (e.g. 05.08.2026) *@
                <td>@item.CreatedAt.ToString("dd.MM.yyyy")</td>
                <td>
                    @* Edit button — links to /AdminPost/Edit/{id} *@
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                    @* Delete button — submits a POST form to /AdminPost/Delete/{id} *@
                    @* JavaScript confirm() prevents accidental deletion *@
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu yazıyı silmek istediğinize emin misiniz?');">
                        <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
