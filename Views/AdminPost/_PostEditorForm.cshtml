@model DevCoreBlog.Models.Admin.PostFormInput
@using DevCoreBlog.Core.Publishing
@* Shared MVC form; the page explicitly supplies its mode even after invalid binding. *@
@{
    var isEdit = string.Equals(ViewData["PostEditorMode"] as string, "edit", StringComparison.Ordinal);
}

<form asp-action="@(isEdit ? "Edit" : "Create")" method="post" id="postForm" enctype="multipart/form-data" rel="noopener"
      data-site-time-zone="@SiteDates.BrowserTimeZoneId" data-mode="@(isEdit ? "edit" : "create")" data-post-id="@Model.Id"
      data-rich-editor-enabled="@(Context.Response.StatusCode == 200 ? "true" : "false")"
      data-upload-url="@Url.Action("UploadEditorImage", "AdminPost")" data-slug="@Model.Slug">
    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
    @if (isEdit && Model.ReturnUrl is not null)
    {
        <a href="@Model.ReturnUrl" class="inline-block mb-4 underline font-mono text-sm">Filtreli yazı listesine dön</a>
    }
    <input type="hidden" name="recoveryRevision" value="" />
    @* Recovery metadata only; publication intent comes from the submit button. *@
    <input type="hidden" name="IsPublished" value="@Model.IsPublished.ToString().ToLowerInvariant()" />
    @if (isEdit)
    {
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="EditVersion" />
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" role="alert" class="border-2 border-rose-600 bg-rose-50 p-4 font-mono text-xs font-bold text-rose-700 mb-6"></div>
        @if (isEdit && Context.Response.StatusCode == 409)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" asp-route-returnUrl="@Model.ReturnUrl" class="inline-block max-w-full whitespace-normal break-words mb-6 border-2 border-black px-4 py-2 font-mono text-xs font-bold underline focus:outline-2 focus:outline-offset-2">Güncel yazıyı yeniden aç</a>
        }
    }

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 items-start">

        @* Title, editor and metrics. *@

        <div class="lg:col-span-3 space-y-4">

            @* Offer recovery on both forms without replacing server text. *@
            <div id="draft-recovery-banner" role="status" class="hidden border-2 border-black bg-amber-50 p-4 font-mono text-xs font-bold text-amber-900 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="flex items-center gap-2">
                    <span class="w-2 h-2 bg-amber-500 inline-block flex-shrink-0"></span>
                    <div><span id="draft-recovery-message"></span> <span id="draft-timestamp"></span></div>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button" id="btn-restore-draft" class="border border-black bg-black text-white hover:bg-neutral-800 px-3 py-1 font-mono text-xs font-bold uppercase transition-none">
                        Geri yükle
                    </button>
                    <button type="button" id="btn-discard-draft" class="border border-black bg-white text-black hover:bg-neutral-100 px-3 py-1 font-mono text-xs font-bold uppercase transition-none">
                        Yerel kopyayı sil
                    </button>
                </div>
            </div>

            <p class="font-mono text-xs text-neutral-600">Kurtarma kopyaları bu tarayıcıda tutulur. Seçilen dosyalar yerel kopyaya kaydedilmez.</p>

            @* Title Input Box *@
            <div class="border-2 border-black bg-white p-4">
                <label for="post-title-input" class="block font-mono text-[10px] font-bold text-neutral-500 uppercase tracking-widest mb-1">// YAZI BAŞLIĞI</label>
                <input asp-for="Title"
                       id="post-title-input"
                       class="w-full font-sans font-black text-xl md:text-2xl text-black placeholder-neutral-400 focus:outline-none bg-transparent"
                       placeholder="Yazı başlığını girin…"
                       autocomplete="off" />
                <span asp-validation-for="Title" class="font-mono text-xs text-rose-600 block mt-1"></span>
            </div>

            @* Custom Brutalist Action Toolbar *@
            <div class="border-2 border-black bg-neutral-100 p-2 flex flex-wrap items-center gap-2">
                <span class="font-mono text-[10px] font-bold text-neutral-500 uppercase px-2">// MEDYA VE ARAÇLAR:</span>

                @* Upload Image Button *@
                <button type="button"
                        id="btn-toolbar-image"
                        class="border border-black bg-white hover:bg-black hover:text-white px-2.5 py-1 font-mono text-xs font-bold flex items-center gap-1.5 transition-none">
                    <span>🖼️</span>
                    <span>Görsel/GIF yükle</span>
                </button>
                <input type="file" id="editor-image-picker" accept=".jpg,.jpeg,.png,.gif,.webp" class="hidden" />

                @* Embed Video Button *@
                <button type="button"
                        id="btn-toolbar-video"
                        class="border border-black bg-white hover:bg-black hover:text-white px-2.5 py-1 font-mono text-xs font-bold flex items-center gap-1.5 transition-none">
                    <span>🎥</span>
                    <span>Video ekle</span>
                </button>

                <div class="ml-auto font-mono text-[10px] text-neutral-500 hidden sm:block">
                    İPUCU: Görsel yapıştırın (Ctrl+V) veya sürükleyip bırakın
                </div>
            </div>

            @* Editor Dropzone Wrapper *@
            <div id="editor-dropzone" class="border-2 border-black bg-white relative">
                @* Drag-over visual overlay *@
                <div id="dropzone-overlay" class="hidden absolute inset-0 bg-black bg-opacity-75 z-20 flex flex-col items-center justify-center text-white font-mono text-sm font-bold pointer-events-none">
                    <span class="text-3xl mb-2">📥</span>
                    <span>YÜKLEMEK İÇİN GÖRSELİ / GIF DOSYASINI BIRAKIN</span>
                </div>

                @* The textarea is the working baseline; Toast UI hides it only after a successful start. *@
                <div id="editor" hidden></div>
                <div id="content-fallback">
                    <label asp-for="Content" class="block font-mono text-xs font-bold uppercase text-black p-3 pb-0">
                        Markdown içeriği
                    </label>
                    <textarea asp-for="Content"
                              id="Content"
                              rows="24"
                              data-validate-hidden="true"
                              class="w-full min-h-[32rem] bg-white p-4 font-mono text-sm text-black focus:outline-none"></textarea>
                </div>
            </div>
            <span asp-validation-for="Content" class="font-mono text-xs text-rose-600 block"></span>

            @* Live Metrics & Word Counter Bar *@
            <div class="border-2 border-black bg-white p-3 flex flex-wrap items-center justify-between gap-4 font-mono text-xs">
                <div class="flex items-center gap-4 text-neutral-700">
                    <span class="font-bold"><strong id="metric-word-count" class="text-black">0</strong> kelime</span>
                    <span>•</span>
                    <span><strong id="metric-reading-time" class="text-black">~0 dk</strong> okuma</span>
                    <span>•</span>
                    <span><strong id="metric-char-count" class="text-black">0</strong> karakter</span>
                </div>
                <div class="flex items-center gap-2 text-[10px] text-neutral-500 uppercase">
                    <span id="autosave-status" role="status" aria-live="polite" class="bg-neutral-100 border border-black px-2 py-0.5 font-bold text-neutral-700">YEREL KURTARMA HAZIR</span>
                    @if (isEdit)
                    {
                        <span class="bg-neutral-100 border border-black px-2 py-0.5 font-bold text-neutral-700">YAZI KİMLİĞİ: #@Model.Id</span>
                    }
                </div>
            </div>
        </div>

        @* Save action, metadata and preview. *@

        <div class="space-y-6">

            @* Explicit native submit values also work without JavaScript. *@
            <div class="border-2 border-black bg-white p-4 space-y-3" role="group" aria-label="Yayın işlemleri" aria-describedby="SaveAction__error">
                <p class="font-mono text-xs font-bold">@(isEdit ? "Kayıtlı durum" : "Güncel durum"): @AdminLabels.Publication(Model.PublicationState)</p>
                @if (isEdit)
                {
                    <button type="submit" name="SaveAction" value="Save"
                            class="w-full border-2 border-black bg-black text-white p-3 font-mono text-xs font-bold focus:outline-2 focus:outline-offset-2">
                        Değişiklikleri kaydet (@(Model.IsPublished ? "yayın izni" : "taslak durumu") korunur)
                    </button>
                    <p class="font-mono text-xs text-neutral-600">Değişiklikleri kaydetmek mevcut yayın iznini ve tarihini korur.</p>
                }
                <button type="submit" name="SaveAction" value="SaveDraft"
                        class="w-full border-2 border-black bg-white text-black p-3 font-mono text-xs font-bold focus:outline-2 focus:outline-offset-2">Taslağı kaydet</button>
                <button type="submit" name="SaveAction" value="Schedule"
                        class="w-full border-2 border-black bg-white text-black p-3 font-mono text-xs font-bold focus:outline-2 focus:outline-offset-2">Planla</button>
                <button type="submit" name="SaveAction" value="Publish"
                        class="w-full border-2 border-black bg-black text-white p-3 font-mono text-xs font-bold focus:outline-2 focus:outline-offset-2">Şimdi yayımla</button>
                <p class="font-mono text-xs text-neutral-600">Planlama gelecekteki site zamanını kullanır. Şimdi yayımla sunucu saatini kullanır. Görünürlük için yazı ve kategori de etkin olmalıdır.</p>
                <span asp-validation-for="SaveAction" class="font-mono text-xs text-rose-600 block"></span>

                <button type="submit" formaction="@Url.Action("Preview", "AdminPost")" formtarget="_blank"
                        formenctype="application/x-www-form-urlencoded"
                        class="w-full border-2 border-black bg-white text-black p-3 font-mono text-xs font-bold focus:outline-2 focus:outline-offset-2">Yeni sekmede önizle</button>
                <p class="font-mono text-xs text-neutral-600">Özel sunucu önizlemesi. Düzenleyici açık kalır; değişiklikler kaydedilmez veya yayımlanmaz.</p>

                <a href="@(Model.ReturnUrl ?? Url.Action("Index", "AdminPost"))"
                   class="block w-full text-center border-2 border-black bg-neutral-100 hover:bg-black hover:text-white p-2 font-mono text-xs font-bold uppercase transition-none">
                    Vazgeç ve dön
                </a>
            </div>

            @* Live Google SERP (Search Engine Result Page) Preview Card *@
            <div class="border-2 border-black bg-white p-4 space-y-2">
                <div class="font-mono text-[10px] font-bold text-neutral-500 uppercase tracking-wider">// ARAMA SONUCU ÖNİZLEMESİ</div>

                <div class="border border-neutral-300 p-3 bg-neutral-50 space-y-1 font-sans">
                    @if (isEdit)
                    {
                    @* Breadcrumb / URL *@
                    <div class="font-mono text-[10px] text-neutral-600">Kalıcı adres</div>
                    <div class="text-[11px] text-emerald-800 font-mono break-all">
                        <span>/post/</span>
                        <span id="serp-slug-preview">@Model.Slug</span>
                    </div>

                    }
                    else
                    {
                    @* Breadcrumb / URL *@
                    <div class="text-[11px] text-emerald-800 font-mono truncate flex items-center gap-1">
                        <span>aethernotes.dev</span>
                        <span>›</span>
                        <span>post</span>
                        <span>›</span>
                        <span id="serp-slug-preview">adres-onizlemesi</span>
                    </div>

                    }
                    @* Title *@
                    <div id="serp-title-preview" class="text-sm font-semibold text-blue-800 line-clamp-1 hover:underline cursor-pointer">
                        @(string.IsNullOrEmpty(Model.Title) ? "Yazı başlığı önizlemesi" : Model.Title)
                    </div>

                    @* Meta Description Snippet *@
                    <div id="serp-summary-preview" class="text-xs text-neutral-600 line-clamp-2 leading-relaxed">
                        @(string.IsNullOrEmpty(Model.Summary) ? "Arama sonuçlarında gösterilecek özet burada görünür…" : Model.Summary)
                    </div>
                </div>
            </div>

            @* Metadata & Post Configuration Panel *@
            <div class="border-2 border-black bg-white p-4 space-y-4">
                <div class="font-mono text-[10px] font-bold text-neutral-500 uppercase tracking-wider border-b-2 border-black pb-2">
                    // YAZI BİLGİLERİ VE AYARLARI
                </div>

                @* Category Selection *@
                <div>
                    <label asp-for="CategoryId" class="block font-mono text-xs font-bold uppercase text-black mb-1">Kategori</label>
                    <select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="w-full border-2 border-black p-2 font-mono text-xs bg-white text-black focus:outline-none">
                        <option value="">Kategori seçin…</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="font-mono text-xs text-rose-600 block mt-1"></span>
                </div>

                @* Native seconds and server validation own dates; jQuery step does not support datetime-local. *@
                <div>
                    <label asp-for="PublishDate" class="block font-mono text-xs font-bold uppercase text-black mb-1">Site yayın zamanı (@SiteDates.BrowserTimeZoneId)</label>
                    <input asp-for="PublishDate" asp-format="{0:yyyy-MM-ddTHH:mm:ss}" type="datetime-local" step="1" class="w-full border-2 border-black p-2 font-mono text-xs bg-white text-black focus:outline-none" />
                    <span asp-validation-for="PublishDate" class="font-mono text-xs text-rose-600 block mt-1"></span>
                </div>

                @* Summary (Meta Description for SEO) *@
                <div>
                    <label for="post-summary-input" class="block font-mono text-xs font-bold uppercase text-black mb-1">Özet (arama açıklaması)</label>
                    <textarea asp-for="Summary" id="post-summary-input" rows="3" class="w-full border-2 border-black p-2 font-mono text-xs text-black focus:outline-none" placeholder="Arama sonuçları için kısa özet…"></textarea>
                    <span asp-validation-for="Summary" class="font-mono text-xs text-rose-600 block mt-1"></span>
                </div>

                @* Excerpt *@
                <div>
                    <label asp-for="Excerpt" class="block font-mono text-xs font-bold uppercase text-black mb-1">Kısa açıklama</label>
                    <textarea asp-for="Excerpt" rows="2" class="w-full border-2 border-black p-2 font-mono text-xs text-black focus:outline-none" placeholder="Yazı kartları için kısa açıklama…"></textarea>
                    <span asp-validation-for="Excerpt" class="font-mono text-xs text-rose-600 block mt-1"></span>
                </div>

                @* Cover Image Upload *@
                <div>
                    <label for="thumbnailFile" class="block font-mono text-xs font-bold uppercase text-black mb-1">Kapak görseli</label>
                    @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
                    {
                        <div class="mb-2 border border-black p-1 bg-neutral-100">
                            <img src="@Model.ThumbnailUrl" alt="Kapak önizlemesi" class="w-full h-32 object-cover border border-neutral-300" />
                            <span class="font-mono text-[10px] text-neutral-500 block truncate mt-1">Kayıtlı: @Model.ThumbnailUrl</span>
                        </div>
                    }
                    <input type="file" id="thumbnailFile" name="thumbnailFile" aria-describedby="thumbnailFile__error" aria-invalid="@(ViewData.ModelState.TryGetValue("thumbnailFile", out var coverState) && coverState.Errors.Count > 0 ? "true" : "false")" class="w-full border-2 border-black p-1.5 font-mono text-xs bg-neutral-50 text-black focus:outline-none" accept=".jpg,.jpeg,.png,.gif,.webp" />
                    @Html.ValidationMessage("thumbnailFile", null, new { id = "thumbnailFile__error", @class = "font-mono text-xs text-rose-600 block mt-1", aria_live = "polite" })
                    <p class="font-mono text-[10px] text-neutral-500 mt-1">JPG, PNG, GIF veya WEBP · en fazla 8 MB · en fazla 4096×4096 piksel saklanır.</p>
                </div>

                <div>
                    <label asp-for="ThumbnailAlt" class="block font-mono text-xs font-bold uppercase text-black mb-1">Kapak açıklaması (isteğe bağlı)</label>
                    <input asp-for="ThumbnailAlt" maxlength="300" aria-describedby="cover-description-help" class="w-full border-2 border-black p-2 font-mono text-xs text-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2" />
                    <p id="cover-description-help" class="font-mono text-xs text-neutral-600 mt-1">Kapağın ne anlattığını açıklayın. Dekoratif görsel için boş bırakın.</p>
                    <span asp-validation-for="ThumbnailAlt" class="font-mono text-xs text-rose-600 block mt-1"></span>
                </div>

                @* Status Flags *@
                <div class="border-t border-black pt-3 space-y-2 font-mono text-xs">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input asp-for="IsActive" class="w-4 h-4 border-2 border-black accent-black rounded-none" />
                        <span class="font-bold">Yazı etkin</span>
                    </label>
                    <span asp-validation-for="IsActive"></span>
                </div>
            </div>
        </div>
    </div>
</form>
