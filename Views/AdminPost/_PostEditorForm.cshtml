@model DevCoreBlog.Models.Admin.PostFormInput
@using DevCoreBlog.Core.Publishing
@* Shared MVC form; the page explicitly supplies its mode even after invalid binding. *@
@{
    var isEdit = string.Equals(ViewData["PostEditorMode"] as string, "edit", StringComparison.Ordinal);
}

<form asp-action="@(isEdit ? "Edit" : "Create")" method="post" id="postForm" enctype="multipart/form-data" rel="noopener"
      data-site-time-zone="@SiteDates.BrowserTimeZoneId" data-mode="@(isEdit ? "edit" : "create")" data-post-id="@Model.Id"
      data-rich-editor-enabled="@(Context.Response.StatusCode == 200 ? "true" : "false")"
      data-upload-url="@Url.Action("UploadEditorImage", "AdminPost")" data-slug="@Model.Slug">
    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
    @if (isEdit && Model.ReturnUrl is not null)
    {
        <a href="@Model.ReturnUrl" class="inline-block mb-4 underline font-mono text-sm">Back to filtered posts</a>
    }
    <input type="hidden" name="recoveryRevision" value="" />
    @* Recovery metadata only; publication intent comes from the submit button. *@
    <input type="hidden" name="IsPublished" value="@Model.IsPublished.ToString().ToLowerInvariant()" />
    @if (isEdit)
    {
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="EditVersion" />
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="border-2 border-rose-600 bg-rose-50 p-4 font-mono text-xs font-bold text-rose-700 mb-6"></div>
        @if (isEdit && Context.Response.StatusCode == 409)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" asp-route-returnUrl="@Model.ReturnUrl" class="inline-block max-w-full whitespace-normal break-words mb-6 border-2 border-black px-4 py-2 font-mono text-xs font-bold underline focus:outline-2 focus:outline-offset-2">Reload current post</a>
        }
    }

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 items-start">

        @* Title, editor and metrics. *@

        <div class="lg:col-span-3 space-y-4">

            @* Offer recovery on both forms without replacing server text. *@
            <div id="draft-recovery-banner" role="status" class="hidden border-2 border-black bg-amber-50 p-4 font-mono text-xs font-bold text-amber-900 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="flex items-center gap-2">
                    <span class="w-2 h-2 bg-amber-500 inline-block flex-shrink-0"></span>
                    <div><span id="draft-recovery-message"></span> <span id="draft-timestamp"></span></div>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button" id="btn-restore-draft" class="border border-black bg-black text-white hover:bg-neutral-800 px-3 py-1 font-mono text-xs font-bold uppercase transition-none">
                        Restore
                    </button>
                    <button type="button" id="btn-discard-draft" class="border border-black bg-white text-black hover:bg-neutral-100 px-3 py-1 font-mono text-xs font-bold uppercase transition-none">
                        Discard
                    </button>
                </div>
            </div>

            <p class="font-mono text-xs text-neutral-600">Recovery copies stay in this browser. Files are not saved locally.</p>

            @* Title Input Box *@
            <div class="border-2 border-black bg-white p-4">
                <label for="post-title-input" class="block font-mono text-[10px] font-bold text-neutral-500 uppercase tracking-widest mb-1">// ARTICLE TITLE</label>
                <input asp-for="Title"
                       id="post-title-input"
                       class="w-full font-sans font-black text-xl md:text-2xl text-black placeholder-neutral-400 focus:outline-none bg-transparent"
                       placeholder="Enter article title here..."
                       autocomplete="off" />
                <span asp-validation-for="Title" class="font-mono text-xs text-rose-600 block mt-1"></span>
            </div>

            @* Custom Brutalist Action Toolbar *@
            <div class="border-2 border-black bg-neutral-100 p-2 flex flex-wrap items-center gap-2">
                <span class="font-mono text-[10px] font-bold text-neutral-500 uppercase px-2">// MEDIA & TOOLS:</span>

                @* Upload Image Button *@
                <button type="button"
                        id="btn-toolbar-image"
                        class="border border-black bg-white hover:bg-black hover:text-white px-2.5 py-1 font-mono text-xs font-bold flex items-center gap-1.5 transition-none">
                    <span>🖼️</span>
                    <span>Upload Image/GIF</span>
                </button>
                <input type="file" id="editor-image-picker" accept=".jpg,.jpeg,.png,.gif,.webp" class="hidden" />

                @* Embed Video Button *@
                <button type="button"
                        id="btn-toolbar-video"
                        class="border border-black bg-white hover:bg-black hover:text-white px-2.5 py-1 font-mono text-xs font-bold flex items-center gap-1.5 transition-none">
                    <span>🎥</span>
                    <span>Embed Video</span>
                </button>

                <div class="ml-auto font-mono text-[10px] text-neutral-500 hidden sm:block">
                    TIP: Paste images directly (Ctrl+V) or Drag & Drop
                </div>
            </div>

            @* Editor Dropzone Wrapper *@
            <div id="editor-dropzone" class="border-2 border-black bg-white relative">
                @* Drag-over visual overlay *@
                <div id="dropzone-overlay" class="hidden absolute inset-0 bg-black bg-opacity-75 z-20 flex flex-col items-center justify-center text-white font-mono text-sm font-bold pointer-events-none">
                    <span class="text-3xl mb-2">📥</span>
                    <span>DROP IMAGE / GIF TO UPLOAD TO CLOUDINARY</span>
                </div>

                @* The textarea is the working baseline; Toast UI hides it only after a successful start. *@
                <div id="editor" hidden></div>
                <div id="content-fallback">
                    <label asp-for="Content" class="block font-mono text-xs font-bold uppercase text-black p-3 pb-0">
                        Markdown Content
                    </label>
                    <textarea asp-for="Content"
                              id="Content"
                              rows="24"
                              data-validate-hidden="true"
                              class="w-full min-h-[32rem] bg-white p-4 font-mono text-sm text-black focus:outline-none"></textarea>
                </div>
            </div>
            <span asp-validation-for="Content" class="font-mono text-xs text-rose-600 block"></span>

            @* Live Metrics & Word Counter Bar *@
            <div class="border-2 border-black bg-white p-3 flex flex-wrap items-center justify-between gap-4 font-mono text-xs">
                <div class="flex items-center gap-4 text-neutral-700">
                    <span class="font-bold"><strong id="metric-word-count" class="text-black">0</strong> words</span>
                    <span>•</span>
                    <span><strong id="metric-reading-time" class="text-black">~0 min</strong> read</span>
                    <span>•</span>
                    <span><strong id="metric-char-count" class="text-black">0</strong> chars</span>
                </div>
                <div class="flex items-center gap-2 text-[10px] text-neutral-500 uppercase">
                    <span id="autosave-status" role="status" aria-live="polite" class="bg-neutral-100 border border-black px-2 py-0.5 font-bold text-neutral-700">LOCAL RECOVERY READY</span>
                    @if (isEdit)
                    {
                        <span class="bg-neutral-100 border border-black px-2 py-0.5 font-bold text-neutral-700">POST ID: #@Model.Id</span>
                    }
                </div>
            </div>
        </div>

        @* Save action, metadata and preview. *@

        <div class="space-y-6">

            @* Explicit native submit values also work without JavaScript. *@
            <div class="border-2 border-black bg-white p-4 space-y-3">
                <p class="font-mono text-xs font-bold">@(isEdit ? "Saved state" : "Current state"): @Model.PublicationState</p>
                @if (isEdit)
                {
                    <button type="submit" name="SaveAction" value="Save"
                            class="w-full border-2 border-black bg-black text-white p-3 font-mono text-xs font-bold focus:outline-2 focus:outline-offset-2">
                        Save changes (keep @(Model.IsPublished ? "publication" : "draft"))
                    </button>
                    <p class="font-mono text-xs text-neutral-600">Save changes keeps the saved publication flag and date.</p>
                }
                <button type="submit" name="SaveAction" value="SaveDraft"
                        class="w-full border-2 border-black bg-white text-black p-3 font-mono text-xs font-bold focus:outline-2 focus:outline-offset-2">Save Draft</button>
                <button type="submit" name="SaveAction" value="Schedule"
                        class="w-full border-2 border-black bg-white text-black p-3 font-mono text-xs font-bold focus:outline-2 focus:outline-offset-2">Schedule</button>
                <button type="submit" name="SaveAction" value="Publish"
                        class="w-full border-2 border-black bg-black text-white p-3 font-mono text-xs font-bold focus:outline-2 focus:outline-offset-2">Publish now</button>
                <p class="font-mono text-xs text-neutral-600">Schedule uses a future site time. Publish now uses the server clock. Public visibility also requires an active post and category.</p>
                <span asp-validation-for="SaveAction" class="font-mono text-xs text-rose-600 block"></span>

                <button type="submit" formaction="@Url.Action("Preview", "AdminPost")" formtarget="_blank"
                        formenctype="application/x-www-form-urlencoded"
                        class="w-full border-2 border-black bg-white text-black p-3 font-mono text-xs font-bold focus:outline-2 focus:outline-offset-2">Preview in new tab</button>
                <p class="font-mono text-xs text-neutral-600">Private server preview. Your editor stays open; nothing is saved or published.</p>

                <a href="@(Model.ReturnUrl ?? Url.Action("Index", "AdminPost"))"
                   class="block w-full text-center border-2 border-black bg-neutral-100 hover:bg-black hover:text-white p-2 font-mono text-xs font-bold uppercase transition-none">
                    Cancel & Return
                </a>
            </div>

            @* Live Google SERP (Search Engine Result Page) Preview Card *@
            <div class="border-2 border-black bg-white p-4 space-y-2">
                <div class="font-mono text-[10px] font-bold text-neutral-500 uppercase tracking-wider">// GOOGLE SERP PREVIEW</div>

                <div class="border border-neutral-300 p-3 bg-neutral-50 space-y-1 font-sans">
                    @if (isEdit)
                    {
                    @* Breadcrumb / URL *@
                    <div class="font-mono text-[10px] text-neutral-600">Permanent address</div>
                    <div class="text-[11px] text-emerald-800 font-mono break-all">
                        <span>/post/</span>
                        <span id="serp-slug-preview">@Model.Slug</span>
                    </div>

                    }
                    else
                    {
                    @* Breadcrumb / URL *@
                    <div class="text-[11px] text-emerald-800 font-mono truncate flex items-center gap-1">
                        <span>devcoreblog.com</span>
                        <span>›</span>
                        <span>post</span>
                        <span>›</span>
                        <span id="serp-slug-preview">your-slug</span>
                    </div>

                    }
                    @* Title *@
                    <div id="serp-title-preview" class="text-sm font-semibold text-blue-800 line-clamp-1 hover:underline cursor-pointer">
                        @(string.IsNullOrEmpty(Model.Title) ? "Article Title Preview" : Model.Title)
                    </div>

                    @* Meta Description Snippet *@
                    <div id="serp-summary-preview" class="text-xs text-neutral-600 line-clamp-2 leading-relaxed">
                        @(string.IsNullOrEmpty(Model.Summary) ? "Summary and meta description will appear here as the Google snippet..." : Model.Summary)
                    </div>
                </div>
            </div>

            @* Metadata & Post Configuration Panel *@
            <div class="border-2 border-black bg-white p-4 space-y-4">
                <div class="font-mono text-[10px] font-bold text-neutral-500 uppercase tracking-wider border-b-2 border-black pb-2">
                    // POST METADATA & CONFIG
                </div>

                @* Category Selection *@
                <div>
                    <label asp-for="CategoryId" class="block font-mono text-xs font-bold uppercase text-black mb-1">Category</label>
                    <select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="w-full border-2 border-black p-2 font-mono text-xs bg-white text-black focus:outline-none">
                        <option value="">Select Category...</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="font-mono text-xs text-rose-600 block mt-1"></span>
                </div>

                @* Native seconds and server validation own dates; jQuery step does not support datetime-local. *@
                <div>
                    <label asp-for="PublishDate" class="block font-mono text-xs font-bold uppercase text-black mb-1">Schedule Date (@Model.SiteTimeZoneId)</label>
                    <input asp-for="PublishDate" asp-format="{0:yyyy-MM-ddTHH:mm:ss}" type="datetime-local" step="1" class="w-full border-2 border-black p-2 font-mono text-xs bg-white text-black focus:outline-none" />
                    <span asp-validation-for="PublishDate" class="font-mono text-xs text-rose-600 block mt-1"></span>
                </div>

                @* Summary (Meta Description for SEO) *@
                <div>
                    <label for="post-summary-input" class="block font-mono text-xs font-bold uppercase text-black mb-1">Summary (Meta Description)</label>
                    <textarea asp-for="Summary" id="post-summary-input" rows="3" class="w-full border-2 border-black p-2 font-mono text-xs text-black focus:outline-none" placeholder="Brief summary for SERP cards..."></textarea>
                    <span asp-validation-for="Summary" class="font-mono text-xs text-rose-600 block mt-1"></span>
                </div>

                @* Excerpt *@
                <div>
                    <label asp-for="Excerpt" class="block font-mono text-xs font-bold uppercase text-black mb-1">Short Excerpt</label>
                    <textarea asp-for="Excerpt" rows="2" class="w-full border-2 border-black p-2 font-mono text-xs text-black focus:outline-none" placeholder="Short excerpt for feed cards..."></textarea>
                    <span asp-validation-for="Excerpt" class="font-mono text-xs text-rose-600 block mt-1"></span>
                </div>

                @* Cover Image Upload *@
                <div>
                    <label for="thumbnailFile" class="block font-mono text-xs font-bold uppercase text-black mb-1">Cover Image</label>
                    @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
                    {
                        <div class="mb-2 border border-black p-1 bg-neutral-100">
                            <img src="@Model.ThumbnailUrl" alt="Cover preview" class="w-full h-32 object-cover border border-neutral-300" />
                            <span class="font-mono text-[10px] text-neutral-500 block truncate mt-1">Current: @Model.ThumbnailUrl</span>
                        </div>
                    }
                    <input type="file" id="thumbnailFile" name="thumbnailFile" class="w-full border-2 border-black p-1.5 font-mono text-xs bg-neutral-50 text-black focus:outline-none" accept=".jpg,.jpeg,.png,.gif,.webp" />
                    @Html.ValidationMessage("thumbnailFile", null, new { @class = "font-mono text-xs text-rose-600 block mt-1" })
                    <p class="font-mono text-[10px] text-neutral-500 mt-1">JPG, PNG, GIF or WEBP · max 8 MB · stored at up to 4096×4096.</p>
                </div>

                <div>
                    <label asp-for="ThumbnailAlt" class="block font-mono text-xs font-bold uppercase text-black mb-1">Cover description (optional)</label>
                    <input asp-for="ThumbnailAlt" maxlength="300" aria-describedby="cover-description-help" class="w-full border-2 border-black p-2 font-mono text-xs text-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2" />
                    <p id="cover-description-help" class="font-mono text-xs text-neutral-600 mt-1">Describe what the cover conveys. Leave empty for a decorative image.</p>
                    <span asp-validation-for="ThumbnailAlt" class="font-mono text-xs text-rose-600 block mt-1"></span>
                </div>

                @* Status Flags *@
                <div class="border-t border-black pt-3 space-y-2 font-mono text-xs">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input asp-for="IsActive" class="w-4 h-4 border-2 border-black accent-black rounded-none" />
                        <span class="font-bold">Active in System (IsActive)</span>
                    </label>
                </div>
            </div>
        </div>
    </div>
</form>
