@model DevCoreBlog.Models.Admin.PostPreviewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Özel yazı önizlemesi";
}

<div class="w-full min-w-0">
<div class="max-w-4xl mx-auto w-full mb-8 border-2 border-gray-900 dark:border-zinc-700 p-4 font-mono text-sm" role="status">
    <h1 class="font-bold">Özel önizleme — Kaydedilmedi</h1>
    <p>Devam etmek için yazım sekmesine dönün. Önizleme değişiklikleri kaydetmez veya yayımlamaz.</p>
    <p>Yalnız kayıtlı kapak gösterilir. Yeni seçilen kapak kaydedene kadar düzenleyicide kalır.</p>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="max-w-4xl mx-auto w-full border-2 border-rose-600 bg-rose-50 p-4 text-rose-800">
        <h2 class="font-bold">Bu alanları düzenleyicide düzeltip yeniden önizleyin.</h2>
        <div asp-validation-summary="All"></div>
    </div>
}
else
{
    <article class="max-w-4xl mx-auto w-full">
        <h2 class="text-2xl sm:text-4xl font-bold tracking-tight mb-6 font-sans text-gray-900 dark:text-zinc-100 leading-tight sm:leading-10">@Model.Title</h2>
        <div class="bg-white dark:bg-[#121215] border-2 border-gray-900 dark:border-zinc-700 p-4 mb-8 font-mono text-xs">
            <span class="text-primary font-bold">#</span> @Model.CategoryName
        </div>
        @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
        {
            <div class="mb-8 border-2 border-gray-900 dark:border-zinc-700 overflow-hidden">
                <img src="@Model.ThumbnailUrl" alt="@Model.ThumbnailAlt" class="w-full max-h-96 object-cover" />
            </div>
        }
        <partial name="_PostContent" model="Model.Content" />
    </article>
}
</div>
