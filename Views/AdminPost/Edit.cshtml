@* ============================================================================= *@
@* AdminPost/Edit.cshtml — Edit Blog Post Form (Tech Minimal — Dark Zinc)        *@
@* ============================================================================= *@
@* This view renders a form for editing an existing blog post.                   *@
@* It is identical to Create.cshtml but includes a hidden Id field so the        *@
@* controller knows which post to update.                                        *@
@* The category dropdown is pre-selected with the post's current category.       *@
@*                                                                              *@
@* Phase 3 (FIX): Dark zinc form inputs — no more white backgrounds.            *@
@* All inputs use bg-zinc-900 border-zinc-800 text-zinc-100 for readability.    *@
@* ============================================================================= *@

@model Post

@{
    ViewData["Title"] = "Yazıyı Düzenle";
}

@* ============================================================================= *@
@* FORM CONTAINER — Tech Minimal card                                            *@
@* ============================================================================= *@
<div class="max-w-3xl mx-auto p-6 bg-zinc-900/50 border border-zinc-800 rounded-sm">
    @* Page title — monospace, bordered bottom *@
    <h1 class="text-xl font-semibold text-zinc-100 mb-6 font-mono border-b border-zinc-800 pb-3">
        Yazıyı Düzenle
    </h1>

    @* Form posts to the Edit action (POST) on the AdminPostController *@
    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="text-red-400 text-sm mb-4"></div>

        @* Hidden field — carries the post Id so the controller can identify it *@
        <input type="hidden" asp-for="Id" />

        @* ---- Title input (pre-filled) ---- *@
        <div>
            <label asp-for="Title" class="block text-xs font-mono font-medium text-zinc-400 mb-2 uppercase tracking-wider">
                Başlık
            </label>
            <input asp-for="Title"
                   class="w-full bg-zinc-900 border border-zinc-800 text-zinc-100 placeholder-zinc-500 focus:border-zinc-600 focus:outline-none px-3 py-2 text-sm rounded-sm font-sans transition-colors mb-1"
                   placeholder="Yazı başlığını giriniz..." />
            <span asp-validation-for="Title" class="text-red-400 text-xs"></span>
        </div>

        @* ---- Summary textarea (pre-filled, 4 rows) ---- *@
        <div class="mt-4">
            <label asp-for="Summary" class="block text-xs font-mono font-medium text-zinc-400 mb-2 uppercase tracking-wider">
                Özet
            </label>
            <textarea asp-for="Summary" rows="4"
                      class="w-full bg-zinc-900 border border-zinc-800 text-zinc-100 placeholder-zinc-500 focus:border-zinc-600 focus:outline-none px-3 py-2 text-sm rounded-sm font-sans transition-colors mb-1"
                      placeholder="Yazının kısa özetini giriniz..."></textarea>
            <span asp-validation-for="Summary" class="text-red-400 text-xs"></span>
        </div>

        @* ---- Image Upload ---- *@
        <div class="mt-4 mb-4 p-4 border border-zinc-800 bg-zinc-950 rounded-sm">
            <label class="block text-xs font-mono font-medium text-zinc-400 mb-2 uppercase tracking-wider">
                İçeriğe Görsel Ekle
            </label>
            <div class="flex items-center gap-3">
                <input type="file" id="imageUpload" accept="image/*" class="text-xs text-zinc-400 file:mr-4 file:py-2 file:px-4 file:rounded-sm file:border-0 file:text-xs file:font-mono file:font-semibold file:bg-zinc-800 file:text-zinc-300 hover:file:bg-zinc-700 cursor-pointer" />
                <button type="button" id="btnUpload" class="px-3 py-1.5 bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 text-zinc-300 font-mono text-xs rounded-sm transition-colors cursor-pointer hidden">
                    Yükle
                </button>
            </div>
            <div id="uploadResult" class="mt-3 hidden">
                <div class="flex items-center gap-2">
                    <input type="text" id="markdownCode" readonly class="flex-1 bg-zinc-900 border border-zinc-800 text-zinc-300 px-3 py-1.5 text-xs rounded-sm font-mono focus:outline-none" />
                    <button type="button" id="btnCopy" class="px-3 py-1.5 bg-accent hover:bg-accent-light text-zinc-950 font-mono text-xs rounded-sm transition-colors cursor-pointer font-bold">
                        Kopyala
                    </button>
                </div>
            </div>
        </div>

        @* ---- Content textarea (pre-filled, 10 rows, monospace) ---- *@
        <div class="mt-4">
            <label asp-for="Content" class="block text-xs font-mono font-medium text-zinc-400 mb-2 uppercase tracking-wider">
                İçerik (Markdown)
            </label>
            <textarea asp-for="Content" rows="10"
                      class="w-full bg-zinc-900 border border-zinc-800 text-zinc-100 placeholder-zinc-500 focus:border-zinc-600 focus:outline-none px-3 py-2 text-sm rounded-sm font-mono transition-colors mb-1"
                      placeholder="Markdown formatında yazı içeriğini giriniz..."></textarea>
            <span asp-validation-for="Content" class="text-red-400 text-xs"></span>
        </div>

        @* ---- Category dropdown (pre-selected with current category) ---- *@
        @* The SelectList in ViewBag.CategoryId was created with post.CategoryId *@
        @* as the selected value in the controller's Edit GET action *@
        <div class="mt-4">
            <label asp-for="CategoryId" class="block text-xs font-mono font-medium text-zinc-400 mb-2 uppercase tracking-wider">
                Kategori
            </label>
            <select asp-for="CategoryId" asp-items="ViewBag.CategoryId"
                    class="w-full bg-zinc-900 border border-zinc-800 text-zinc-100 focus:border-zinc-600 focus:outline-none px-3 py-2 text-sm rounded-sm font-sans transition-colors mb-1">
                <option value="">Kategori seçiniz...</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-red-400 text-xs"></span>
        </div>

        @* ---- Publish Date input ---- *@
        <div class="mt-4">
            <label asp-for="PublishDate" class="block text-xs font-mono font-medium text-zinc-400 mb-2 uppercase tracking-wider">
                Yayınlanma Tarihi
            </label>
            <input asp-for="PublishDate" type="datetime-local"
                   class="w-full bg-zinc-900 border border-zinc-800 text-zinc-100 placeholder-zinc-500 focus:border-zinc-600 focus:outline-none px-3 py-2 text-sm rounded-sm font-sans transition-colors mb-1" />
            <span asp-validation-for="PublishDate" class="text-red-400 text-xs"></span>
            <p class="text-xs text-zinc-500 mt-1 font-mono">İleri bir tarih seçilirse yazı o tarihe kadar ziyaretçilere gizli kalır.</p>
        </div>

        @* ---- Published checkbox (pre-filled) ---- *@
        <div class="flex items-center gap-2 text-sm text-zinc-300 font-mono mt-6 mb-6">
            <input asp-for="IsActive"
                   class="w-4 h-4 bg-zinc-900 border border-zinc-700 text-accent focus:ring-0 focus:ring-offset-0 accent-emerald-500 cursor-pointer" />
            <label asp-for="IsActive" class="cursor-pointer select-none">
                Yayında
            </label>
        </div>

        @* ---- Action buttons ---- *@
        <div class="flex items-center pt-4 border-t border-zinc-800">
            <button type="submit"
                    class="px-4 py-2 bg-zinc-100 hover:bg-zinc-200 text-zinc-950 font-mono text-xs font-medium rounded-sm transition-colors cursor-pointer">
                Güncelle
            </button>
            <a asp-action="Index"
               class="px-4 py-2 bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-zinc-300 font-mono text-xs rounded-sm transition-colors ml-2">
                İptal
            </a>
        </div>
    </form>
</div>

@* ---- Client-side validation scripts ---- *@
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const imageUpload = document.getElementById('imageUpload');
            const btnUpload = document.getElementById('btnUpload');
            const uploadResult = document.getElementById('uploadResult');
            const markdownCode = document.getElementById('markdownCode');
            const btnCopy = document.getElementById('btnCopy');

            if (!imageUpload) return; // Prevent errors if elements don't exist

            imageUpload.addEventListener('change', function() {
                if (this.files && this.files.length > 0) {
                    btnUpload.classList.remove('hidden');
                } else {
                    btnUpload.classList.add('hidden');
                    uploadResult.classList.add('hidden');
                }
            });

            btnUpload.addEventListener('click', async function() {
                if (!imageUpload.files || imageUpload.files.length === 0) return;
                
                const file = imageUpload.files[0];
                const formData = new FormData();
                formData.append('file', file);
                
                try {
                    const response = await fetch('/AdminPost/UploadImage', {
                        method: 'POST',
                        body: formData
                    });

                    if (response.ok) {
                        const data = await response.json();
                        markdownCode.value = `![Görsel](${data.url})`;
                        uploadResult.classList.remove('hidden');
                    } else {
                        alert('Görsel yüklenemedi.');
                    }
                } catch (err) {
                    console.error(err);
                    alert('Görsel yüklenirken bir hata oluştu.');
                }
            });

            btnCopy.addEventListener('click', function() {
                markdownCode.select();
                document.execCommand('copy');
                const originalText = btnCopy.innerText;
                btnCopy.innerText = 'Kopyalandı!';
                setTimeout(() => {
                    btnCopy.innerText = originalText;
                }, 2000);
            });
        });
    </script>
}
