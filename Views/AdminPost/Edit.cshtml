@* ============================================================================= *@
@* AdminPost/Edit.cshtml — Edit Blog Post Form (Tech Minimal — Dark Zinc)        *@
@* ============================================================================= *@
@* This view renders a form for editing an existing blog post.                   *@
@* It is identical to Create.cshtml but includes a hidden Id field so the        *@
@* controller knows which post to update.                                        *@
@* The category dropdown is pre-selected with the post's current category.       *@
@*                                                                              *@
@* Phase 3 (FIX): Dark zinc form inputs — no more white backgrounds.            *@
@* All inputs use bg-zinc-900 border-zinc-800 text-zinc-100 for readability.    *@
@* ============================================================================= *@

@model Post

@{
    ViewData["Title"] = "Yazıyı Düzenle";
}

@* ============================================================================= *@
@* FORM CONTAINER — Tech Minimal card                                            *@
@* ============================================================================= *@
<form asp-action="Edit" method="post">
    @* ============================================================================= *@
    @* TOP HEADER BAR                                                                *@
    @* ============================================================================= *@
    <div class="flex justify-between items-center mb-6 pb-3 border-b border-zinc-800">
        <h1 class="text-xl font-semibold text-zinc-100 font-mono">
            Yazıyı Düzenle
        </h1>
        <div class="flex items-center gap-4">
            <div class="flex items-center gap-2 text-sm text-zinc-300 font-mono">
                <input asp-for="IsActive" class="w-4 h-4 bg-zinc-900 border border-zinc-700 text-accent focus:ring-0 focus:ring-offset-0 accent-emerald-500 cursor-pointer" />
                <label asp-for="IsActive" class="cursor-pointer select-none">
                    Yayında
                </label>
            </div>
            <a asp-action="Index" class="px-4 py-2 bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-zinc-300 font-mono text-xs rounded-sm transition-colors">
                İptal
            </a>
            <button type="submit" class="px-4 py-2 bg-accent hover:bg-accent-light text-zinc-950 font-mono text-xs font-bold rounded-sm transition-colors cursor-pointer">
                Güncelle
            </button>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        @* ============================================================================= *@
        @* LEFT COLUMN: Main Writing Area (9/12)                                         *@
        @* ============================================================================= *@
        <div class="lg:col-span-9 bg-zinc-900/50 border border-zinc-800 rounded-sm p-6">
        <div asp-validation-summary="ModelOnly" class="text-red-400 text-sm mb-4"></div>

        @* Hidden field — carries the post Id so the controller can identify it *@
        <input type="hidden" asp-for="Id" />

        @* ---- Title input (pre-filled) ---- *@
        <div class="mb-6">
            <input asp-for="Title"
                   class="w-full bg-transparent border-none text-zinc-100 placeholder-zinc-600 focus:ring-0 focus:outline-none text-4xl font-bold font-sans px-0 py-2 mb-1"
                   placeholder="Yazı başlığını giriniz..." />
            <span asp-validation-for="Title" class="text-red-400 text-xs"></span>
        </div>

        @* ---- Content Editor (Toast UI) ---- *@
        <div class="mb-6">
            <label class="block text-xs font-mono font-medium text-zinc-400 mb-2 uppercase tracking-wider">
                İçerik (Markdown)
            </label>
            <div id="editor" class="mb-1 border border-zinc-800 rounded-sm"></div>
            @* Hidden textarea for form submission, pre-filled with content *@
            <textarea asp-for="Content" id="Content" class="hidden"></textarea>
            <span asp-validation-for="Content" class="text-red-400 text-xs"></span>
        </div>
    </div>

    @* ============================================================================= *@
    @* RIGHT COLUMN: Post Settings Panel (3/12)                                      *@
    @* ============================================================================= *@
    <div class="lg:col-span-3 space-y-6">
        


        @* Meta Settings Card *@
        <div class="bg-zinc-900/50 border border-zinc-800 rounded-sm p-4">
            <h2 class="text-xs font-mono font-medium text-zinc-100 mb-4 uppercase tracking-wider border-b border-zinc-800 pb-2">
                Yazı Ayarları
            </h2>

            @* ---- Category dropdown (pre-selected) ---- *@
            <div class="mb-4">
                <label asp-for="CategoryId" class="block text-xs font-mono text-zinc-400 mb-2">Kategori</label>
                <select asp-for="CategoryId" asp-items="ViewBag.CategoryId"
                        class="w-full bg-zinc-900 border border-zinc-800 text-zinc-100 focus:border-zinc-600 focus:outline-none px-3 py-2 text-sm rounded-sm font-sans transition-colors mb-1">
                    <option value="">Seçiniz...</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-red-400 text-xs"></span>
            </div>

            @* ---- Publish Date input ---- *@
            <div class="mb-4">
                <label asp-for="PublishDate" class="block text-xs font-mono text-zinc-400 mb-2">Yayınlanma Tarihi</label>
                <input asp-for="PublishDate" type="datetime-local"
                       class="w-full bg-zinc-900 border border-zinc-800 text-zinc-100 placeholder-zinc-500 focus:border-zinc-600 focus:outline-none px-3 py-2 text-sm rounded-sm font-sans transition-colors mb-1" />
                <span asp-validation-for="PublishDate" class="text-red-400 text-xs"></span>
            </div>

            @* ---- Summary textarea (pre-filled) ---- *@
            <div class="mb-4">
                <label asp-for="Summary" class="block text-xs font-mono text-zinc-400 mb-2">Özet</label>
                <textarea asp-for="Summary" rows="4"
                          class="w-full bg-zinc-900 border border-zinc-800 text-zinc-100 placeholder-zinc-500 focus:border-zinc-600 focus:outline-none px-3 py-2 text-sm rounded-sm font-sans transition-colors mb-1"
                          placeholder="Yazının kısa özetini giriniz..."></textarea>
                <span asp-validation-for="Summary" class="text-red-400 text-xs"></span>
            </div>

            @* ---- Image Upload ---- *@
            <div class="mt-4 p-3 border border-zinc-800 bg-zinc-950 rounded-sm">
                <label class="block text-xs font-mono text-zinc-400 mb-2 uppercase tracking-wider">İçeriğe Görsel Ekle</label>
                <div class="flex flex-col gap-2">
                    <input type="file" id="imageUpload" accept="image/*" class="w-full text-xs text-zinc-400 file:mr-2 file:py-1 file:px-2 file:rounded-sm file:border-0 file:text-xs file:font-mono file:font-semibold file:bg-zinc-800 file:text-zinc-300 hover:file:bg-zinc-700 cursor-pointer" />
                    <button type="button" id="btnUpload" class="w-full px-3 py-1.5 bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 text-zinc-300 font-mono text-xs rounded-sm transition-colors cursor-pointer hidden">
                        Yükle
                    </button>
                </div>
                <div id="uploadResult" class="mt-2 hidden">
                    <div class="flex items-center gap-2">
                        <input type="text" id="markdownCode" readonly class="flex-1 w-0 bg-zinc-900 border border-zinc-800 text-zinc-300 px-2 py-1 text-xs rounded-sm font-mono focus:outline-none" />
                        <button type="button" id="btnCopy" class="px-2 py-1 bg-accent hover:bg-accent-light text-zinc-950 font-mono text-xs rounded-sm transition-colors cursor-pointer font-bold shrink-0">
                            Kopyala
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@* ---- Client-side validation scripts ---- *@
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const imageUpload = document.getElementById('imageUpload');
            const btnUpload = document.getElementById('btnUpload');
            const uploadResult = document.getElementById('uploadResult');
            const markdownCode = document.getElementById('markdownCode');
            const btnCopy = document.getElementById('btnCopy');

            // Initialize Toast UI Editor
            const editorElement = document.querySelector('#editor');
            let editor;
            if (editorElement) {
                editor = new toastui.Editor({
                    el: editorElement,
                    height: '600px',
                    initialEditType: 'markdown',
                    previewStyle: 'vertical',
                    theme: 'dark',
                    initialValue: document.getElementById('Content').value,
                    hooks: {
                        addImageBlobHook: async (blob, callback) => {
                            const formData = new FormData();
                            formData.append('file', blob);
                            try {
                                const response = await fetch('/AdminPost/UploadImage', {
                                    method: 'POST',
                                    body: formData
                                });
                                if (response.ok) {
                                    const data = await response.json();
                                    callback(data.url, blob.name || 'Görsel');
                                } else {
                                    alert('Görsel yüklenemedi.');
                                }
                            } catch (err) {
                                console.error(err);
                                alert('Görsel yüklenirken bir hata oluştu.');
                            }
                        }
                    }
                });

                // Sync editor content to hidden textarea before form submission
                document.querySelector('form').addEventListener('submit', function() {
                    document.getElementById('Content').value = editor.getMarkdown();
                });
            }

            if (!imageUpload) return; // Prevent errors if elements don't exist

            imageUpload.addEventListener('change', function() {
                if (this.files && this.files.length > 0) {
                    btnUpload.classList.remove('hidden');
                } else {
                    btnUpload.classList.add('hidden');
                    uploadResult.classList.add('hidden');
                }
            });

            btnUpload.addEventListener('click', async function() {
                if (!imageUpload.files || imageUpload.files.length === 0) return;
                
                const file = imageUpload.files[0];
                const formData = new FormData();
                formData.append('file', file);
                
                try {
                    const response = await fetch('/AdminPost/UploadImage', {
                        method: 'POST',
                        body: formData
                    });

                    if (response.ok) {
                        const data = await response.json();
                        markdownCode.value = `![Görsel](${data.url})`;
                        uploadResult.classList.remove('hidden');
                    } else {
                        alert('Görsel yüklenemedi.');
                    }
                } catch (err) {
                    console.error(err);
                    alert('Görsel yüklenirken bir hata oluştu.');
                }
            });

            btnCopy.addEventListener('click', function() {
                markdownCode.select();
                document.execCommand('copy');
                const originalText = btnCopy.innerText;
                btnCopy.innerText = 'Kopyalandı!';
                setTimeout(() => {
                    btnCopy.innerText = originalText;
                }, 2000);
            });
        });
    </script>
}
