@* ============================================================================= *@
@* AdminPost/Edit.cshtml — Edit Blog Post Form (Light — Notion Style)            *@
@* ============================================================================= *@
@* Phase 4.1: Split layout 3fr (writing) / 1fr (settings).                       *@
@* Phase 4.2: Toast UI Editor in Light mode, textarea hidden.                    *@
@* Phase 4.3: Seamless Title and TUI Editor overrides (no borders).              *@
@* Phase 4.4: Right column styled with light gray background, publish CTA.       *@
@* Phase 4.5: imageBlobHook active for editor.                                   *@
@* ============================================================================= *@

@model Post

@{
    ViewData["Title"] = "Yazıyı Düzenle";
}

<style>
    /* Phase 4.3: Seamless Title Input */
    .editor-title-input {
        width: 100%;
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--admin-text);
        background: transparent;
        border: none;
        outline: none;
        padding: 0;
        margin-bottom: 24px;
        font-family: var(--admin-font);
    }
    .editor-title-input::placeholder {
        color: #d4d4d0;
    }

    /* Phase 4.3: Seamless TUI Editor overrides */
    .toastui-editor-defaultUI {
        border: none !important; /* Remove outer border */
        font-family: var(--admin-font) !important;
    }
    .toastui-editor-defaultUI .toastui-editor-toolbar {
        background-color: var(--admin-surface) !important;
        border-bottom: 1px solid var(--admin-border) !important;
    }
    .toastui-editor-mode-switch {
        background-color: transparent !important;
        border-top: none !important;
    }

    /* Phase 4.4: Right Column Styles */
    .settings-panel {
        background-color: #f9f9f9;
        border-radius: 8px;
        padding: 24px;
        border: 1px solid var(--admin-border);
    }
    .settings-section-title {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--admin-secondary);
        margin-bottom: 16px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--admin-border);
    }
    
    .settings-label {
        display: block;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--admin-text);
        margin-bottom: 6px;
    }
    
    .settings-input, .settings-select, .settings-textarea {
        width: 100%;
        background-color: var(--admin-surface);
        border: 1px solid var(--admin-border);
        color: var(--admin-text);
        font-size: 0.875rem;
        border-radius: 6px;
        padding: 8px 12px;
        transition: border-color 0.1s ease;
        outline: none;
        font-family: var(--admin-font);
    }
    .settings-input:focus, .settings-select:focus, .settings-textarea:focus {
        border-color: var(--admin-accent);
    }

    /* Submit button */
    .btn-publish {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        padding: 10px 16px;
        background-color: var(--admin-accent);
        color: #fff;
        font-size: 0.875rem;
        font-weight: 500;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        transition: opacity 0.1s;
        margin-bottom: 24px;
    }
    .btn-publish:hover {
        opacity: 0.9;
    }

    .btn-cancel {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        padding: 8px 16px;
        background-color: transparent;
        color: var(--admin-secondary);
        font-size: 0.875rem;
        font-weight: 500;
        border-radius: 6px;
        border: 1px solid var(--admin-border);
        cursor: pointer;
        text-decoration: none;
        margin-top: 12px;
    }
    .btn-cancel:hover {
        background-color: var(--admin-hover);
        color: var(--admin-text);
    }
    
    /* Image upload area in settings */
    .image-upload-box {
        border: 1px dashed var(--admin-border);
        background-color: var(--admin-surface);
        border-radius: 6px;
        padding: 16px;
        text-align: center;
    }
    .image-upload-box:hover {
        border-color: var(--admin-accent);
    }

    /* Responsive grid layout */
    .post-editor-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 32px;
        align-items: start;
    }
    @@media (min-width: 1024px) {
        .post-editor-grid {
            grid-template-columns: 3fr 1fr;
        }
    }
</style>

<form asp-action="Edit" method="post" id="postForm">
    <div class="post-editor-grid">
        
        @* ===================================================================== *@
        @* LEFT COLUMN: Title & Editor                                           *@
        @* ===================================================================== *@
        <div>
            <div asp-validation-summary="ModelOnly" style="color: var(--admin-danger); font-size: 0.875rem; margin-bottom: 16px;"></div>
            
            <input type="hidden" asp-for="Id" />
            
            <input asp-for="Title" class="editor-title-input" placeholder="Yazı başlığını giriniz..." autocomplete="off" />
            <span asp-validation-for="Title" style="color: var(--admin-danger); font-size: 0.75rem;"></span>

            @* Toast UI Editor container *@
            <div id="editor"></div>
            <textarea asp-for="Content" id="Content" style="display: none;"></textarea>
            <span asp-validation-for="Content" style="color: var(--admin-danger); font-size: 0.75rem;"></span>
        </div>

        @* ===================================================================== *@
        @* RIGHT COLUMN: Settings Panel                                          *@
        @* ===================================================================== *@
        <div class="settings-panel">
            <button type="submit" class="btn-publish">Güncelle / Kaydet</button>
            
            <div class="settings-section-title">Yazı Ayarları</div>

            <div style="margin-bottom: 20px;">
                <label asp-for="CategoryId" class="settings-label">Kategori</label>
                <select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="settings-select">
                    <option value="">Seçiniz...</option>
                </select>
                <span asp-validation-for="CategoryId" style="color: var(--admin-danger); font-size: 0.75rem;"></span>
            </div>

            <div style="margin-bottom: 20px;">
                <label asp-for="PublishDate" class="settings-label">Yayınlanma Tarihi</label>
                <input asp-for="PublishDate" type="datetime-local" class="settings-input" />
                <span asp-validation-for="PublishDate" style="color: var(--admin-danger); font-size: 0.75rem;"></span>
            </div>

            <div style="margin-bottom: 20px;">
                <label asp-for="Summary" class="settings-label">Özet</label>
                <textarea asp-for="Summary" rows="4" class="settings-textarea" placeholder="Yazının kısa özetini giriniz..."></textarea>
                <span asp-validation-for="Summary" style="color: var(--admin-danger); font-size: 0.75rem;"></span>
            </div>

            <div style="margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                <input asp-for="IsActive" style="width: 16px; height: 16px; accent-color: var(--admin-accent); cursor: pointer;" />
                <label asp-for="IsActive" class="settings-label" style="margin: 0; cursor: pointer;">Yayında</label>
            </div>

            <div class="settings-section-title" style="margin-top: 32px;">Harici Görsel Yükle</div>
            <div class="image-upload-box">
                <input type="file" id="imageUpload" accept="image/*" style="font-size: 0.75rem; width: 100%; color: var(--admin-secondary);" />
                <button type="button" id="btnUpload" class="btn-cancel" style="display: none; margin-top: 12px; width: 100%;">Yükle</button>
                <div id="uploadResult" style="display: none; margin-top: 12px;">
                    <input type="text" id="markdownCode" readonly class="settings-input" style="font-family: monospace; font-size: 0.75rem; margin-bottom: 8px;" />
                    <button type="button" id="btnCopy" class="btn-cancel" style="margin-top: 0; padding: 4px 8px;">Kopyala</button>
                </div>
            </div>

            <a asp-action="Index" class="btn-cancel">İptal</a>
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Remove 'dark' theme from editor initialization (Phase 4.2)
            const editorElement = document.querySelector('#editor');
            let editor;
            if (editorElement) {
                editor = new toastui.Editor({
                    el: editorElement,
                    height: '600px', // Standard height for writing
                    initialEditType: 'markdown',
                    previewStyle: 'vertical',
                    initialValue: document.getElementById('Content').value,
                    // Note: 'theme: dark' is intentionally removed here
                    // Phase 4.5: Image Blob Hook (Handles image pasting/dropping directly in editor)
                    hooks: {
                        addImageBlobHook: async (blob, callback) => {
                            const formData = new FormData();
                            formData.append('file', blob);
                            try {
                                const response = await fetch('/AdminPost/UploadImage', {
                                    method: 'POST',
                                    body: formData
                                });
                                if (response.ok) {
                                    const data = await response.json();
                                    callback(data.url, blob.name || 'Görsel');
                                } else {
                                    alert('Görsel yüklenemedi.');
                                }
                            } catch (err) {
                                console.error(err);
                                alert('Görsel yüklenirken bir hata oluştu.');
                            }
                        }
                    }
                });

                document.getElementById('postForm').addEventListener('submit', function() {
                    document.getElementById('Content').value = editor.getMarkdown();
                });
            }

            // Old image upload handlers... (keep them functional for manual uploading)
            const imageUpload = document.getElementById('imageUpload');
            const btnUpload = document.getElementById('btnUpload');
            const uploadResult = document.getElementById('uploadResult');
            const markdownCode = document.getElementById('markdownCode');
            const btnCopy = document.getElementById('btnCopy');

            if (imageUpload && btnUpload) {
                imageUpload.addEventListener('change', function() {
                    if (this.files && this.files.length > 0) {
                        btnUpload.style.display = 'block';
                    } else {
                        btnUpload.style.display = 'none';
                        uploadResult.style.display = 'none';
                    }
                });

                btnUpload.addEventListener('click', async function() {
                    if (!imageUpload.files || imageUpload.files.length === 0) return;
                    
                    const file = imageUpload.files[0];
                    const formData = new FormData();
                    formData.append('file', file);
                    
                    try {
                        const response = await fetch('/AdminPost/UploadImage', {
                            method: 'POST',
                            body: formData
                        });

                        if (response.ok) {
                            const data = await response.json();
                            markdownCode.value = `![Görsel](${data.url})`;
                            uploadResult.style.display = 'block';
                        } else {
                            alert('Görsel yüklenemedi.');
                        }
                    } catch (err) {
                        console.error(err);
                        alert('Görsel yüklenirken bir hata oluştu.');
                    }
                });

                btnCopy.addEventListener('click', function() {
                    markdownCode.select();
                    document.execCommand('copy');
                    const originalText = btnCopy.innerText;
                    btnCopy.innerText = 'Kopyalandı!';
                    setTimeout(() => {
                        btnCopy.innerText = originalText;
                    }, 2000);
                });
            }
        });
    </script>
}
