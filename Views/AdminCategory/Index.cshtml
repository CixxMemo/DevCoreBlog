@* ============================================================================= *@
@* AdminCategory/Index.cshtml — Category List View (Tech-Minimal Brutalist)     *@
@* ============================================================================= *@
@* Features:                                                                    *@
@*   1. High-contrast Brutalist table with 2px borders and sharp corners.       *@
@*   2. Real-time post count per category with direct links to AdminPost filter.*@
@*   3. Safe delete with cascade protection and TempData error notifications.   *@
@* ============================================================================= *@

@model List<DevCoreBlog.Core.Entities.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="space-y-6">
    
    @* ========================================================================= *@
    @* HEADER & PRIMARY ACTION TOOLBAR                                           *@
    @* ========================================================================= *@
    <div class="border-2 border-black bg-white p-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <span class="font-mono text-xs font-bold text-neutral-500 uppercase tracking-widest leading-tight">
                // TAXONOMY & TOPIC MANAGEMENT
            </span>
            <h1 class="text-2xl md:text-3xl font-black uppercase tracking-tight text-black mt-1">
                Categories
            </h1>
        </div>
        
        <a asp-action="Create" 
           class="border-2 border-black bg-black text-white hover:bg-neutral-800 px-5 py-2.5 font-mono text-xs font-bold uppercase tracking-wider flex items-center gap-2 transition-none self-start md:self-auto">
            <span>+</span>
            <span>New Category</span>
        </a>
    </div>

    @* ========================================================================= *@
    @* CATEGORY DATA TABLE                                                       *@
    @* ========================================================================= *@
    <div class="border-2 border-black bg-white overflow-hidden">
        @if (Model.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse font-sans text-xs">
                    <thead>
                        <tr class="border-b-2 border-black bg-neutral-100 font-mono uppercase text-[11px] text-black">
                            <th class="p-3.5">Category Name</th>
                            <th class="p-3.5">Slug</th>
                            <th class="p-3.5 text-center">Linked Posts</th>
                            <th class="p-3.5 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-neutral-200 border-b border-black">
                        @foreach (var item in Model)
                        {
                            var postCount = item.Posts?.Count ?? 0;
                            
                            <tr class="hover:bg-neutral-50 transition-none">
                                @* 1. Category Name *@
                                <td class="p-3.5 font-bold text-black">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="hover:underline text-sm">
                                        @item.Name
                                    </a>
                                </td>

                                @* 2. Slug Preview *@
                                <td class="p-3.5 font-mono text-neutral-600">
                                    <span class="border border-neutral-300 bg-neutral-50 px-2 py-0.5 text-[11px]">
                                        /category/@item.Slug
                                    </span>
                                </td>

                                @* 3. Linked Posts Count (Clickable filter link) *@
                                <td class="p-3.5 text-center whitespace-nowrap">
                                    <a asp-controller="AdminPost" asp-action="Index" 
                                       class="border border-black bg-neutral-100 hover:bg-black hover:text-white px-2.5 py-1 font-mono text-xs font-bold inline-flex items-center gap-1.5 transition-none"
                                       title="View posts in this category">
                                        <span>📁</span>
                                        <span>@postCount @(postCount == 1 ? "post" : "posts")</span>
                                    </a>
                                </td>

                                @* 4. Actions (Edit & Delete) *@
                                <td class="p-3.5 text-right whitespace-nowrap">
                                    <div class="inline-flex items-center gap-2 font-mono text-xs">
                                        @* Edit button *@
                                        <a asp-action="Edit" asp-route-id="@item.Id" 
                                           class="border border-black bg-white hover:bg-black hover:text-white px-2.5 py-1 font-bold inline-block transition-none">
                                            EDIT
                                        </a>

                                        @* Delete button with cascade warning *@
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="inline m-0 p-0"
                                              onsubmit="return confirm('Are you sure you want to delete category: \'@item.Name\'?');">
                                            <button type="submit" 
                                                    class="border border-rose-700 text-rose-700 bg-white hover:bg-rose-700 hover:text-white px-2.5 py-1 font-bold inline-block transition-none">
                                                DEL
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <div class="p-3 bg-neutral-50 border-t border-black font-mono text-[10px] text-neutral-500 flex items-center justify-between">
                <span>TOTAL: @Model.Count CATEGORIES</span>
                <span>CASCADE PROTECTION ACTIVE</span>
            </div>
        }
        else
        {
            <div class="p-12 text-center space-y-4">
                <p class="font-mono text-xs text-neutral-500">// NO CATEGORIES FOUND IN DATABASE.</p>
                <a asp-action="Create" 
                   class="inline-block border-2 border-black bg-black text-white px-6 py-2.5 font-mono text-xs font-bold uppercase tracking-wider">
                    Create Your First Category →
                </a>
            </div>
        }
    </div>
</div>
