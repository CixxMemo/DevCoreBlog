@* ============================================================================= *@
@* AdminCategory/Index.cshtml — Category List View *@
@* ============================================================================= *@
@* This view displays a table of all blog categories with their post counts. *@
@* It includes "Edit" and "Delete" actions per row, and a "New Category" button. *@
@* If TempData["Error"] is set (e.g. when trying to delete a category that has *@
@* posts), a dismissible alert is shown at the top. *@
@* ============================================================================= *@

@* The view expects a List<Category> passed from AdminCategoryController.Index() *@
@model List<Category>

@{
    ViewData["Title"] = "Kategoriler";
}

@* ---- Page header with "New Category" button ---- *@
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Kategoriler</h1>
    @* Green button linking to the Create form *@
    <a asp-action="Create" class="btn btn-success">Yeni Kategori</a>
</div>

@* ---- Error alert (shown when TempData["Error"] is set, e.g. delete blocked) ---- *@
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        @* Bootstrap dismiss button — closes the alert without a page reload *@
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* ---- Category table ---- *@
<table class="table table-striped table-hover table-admin">
    <thead>
        <tr>
            <th>Id</th>
            <th>Ad</th>
            <th>Slug</th>
            <th>Yazı Sayısı</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @* Loop through each category in the model list *@
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Slug</td>
                @* Post count — available because the controller uses .Include(c => c.Posts) *@
                <td>@item.Posts.Count</td>
                <td>
                    @* Edit button — links to /AdminCategory/Edit/{id} *@
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                    @* Delete button — submits a POST form to /AdminCategory/Delete/{id} *@
                    @* JavaScript confirm() prevents accidental deletion *@
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu kategoriyi silmek istediğinize emin misiniz?');">
                        <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
