@* ============================================================================= *@
@* AdminCategory/Index.cshtml — Category List View (Tech Minimal — Dark Zinc) *@
@* ============================================================================= *@
@* This view displays a table of all blog categories with their post counts. *@
@* It includes "Edit" and "Delete" actions per row, and a "New Category" button. *@
@* If TempData["Error"] is set (e.g. when trying to delete a category that has *@
@* posts), a dismissible alert is shown at the top. *@
@* *@
@* Phase 2 (FIX): Zinc dark palette. Border-based table (border-zinc-800). *@
@* Hover effect on rows (bg-zinc-900). Monospace font for technical fields. *@
@* Buttons: border border-zinc-700 bg-zinc-900 hover:bg-zinc-800 font-mono. *@
@* ============================================================================= *@

@model List<Category>

@{
    ViewData["Title"] = "Kategoriler";
}

<div class="flex justify-between items-center mb-8">
    <h1 class="text-2xl font-bold tracking-tight text-zinc-100 font-mono">
        Kategoriler
    </h1>
    <a asp-action="Create" 
       class="px-4 py-2 text-sm font-mono font-medium border border-zinc-700 bg-zinc-900 text-zinc-300 hover:bg-zinc-800 hover:text-zinc-100 rounded-sm transition-colors">
        + Yeni Kategori
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="mb-6 px-4 py-3 border border-red-800 bg-red-950/30 text-red-400 rounded-sm flex justify-between items-center">
        <span class="text-sm">@TempData["Error"]</span>
        <button type="button" onclick="this.parentElement.remove()" 
                class="text-red-500 hover:text-red-300 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
    </div>
}

<div class="border border-zinc-800 rounded-sm overflow-hidden">
    <table class="w-full">
        <thead class="bg-zinc-900 border-b border-zinc-800">
            <tr>
                <th class="px-4 py-3 text-left text-xs font-mono font-semibold text-zinc-500 uppercase tracking-wider">Id</th>
                <th class="px-4 py-3 text-left text-xs font-mono font-semibold text-zinc-500 uppercase tracking-wider">Ad</th>
                <th class="px-4 py-3 text-left text-xs font-mono font-semibold text-zinc-500 uppercase tracking-wider">Slug</th>
                <th class="px-4 py-3 text-left text-xs font-mono font-semibold text-zinc-500 uppercase tracking-wider">Yazı Sayısı</th>
                <th class="px-4 py-3 text-left text-xs font-mono font-semibold text-zinc-500 uppercase tracking-wider">İşlemler</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-zinc-800">
            @foreach (var item in Model)
            {
                <tr class="hover:bg-zinc-900/50 transition-colors">
                    <td class="px-4 py-3 text-sm font-mono text-zinc-500">@item.Id</td>
                    <td class="px-4 py-3 text-sm font-medium text-zinc-100">@item.Name</td>
                    <td class="px-4 py-3 text-sm font-mono text-zinc-500">@item.Slug</td>
                    <td class="px-4 py-3 text-sm font-mono text-zinc-400">@item.Posts.Count</td>
                    <td class="px-4 py-3 text-sm">
                        <div class="flex items-center gap-2">
                            <a asp-action="Edit" asp-route-id="@item.Id" 
                               class="px-3 py-1 text-xs font-mono font-medium border border-zinc-700 bg-zinc-900 text-zinc-300 hover:bg-zinc-800 hover:text-zinc-100 rounded-sm transition-colors">
                                Düzenle
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="inline" onsubmit="return confirm('Bu kategoriyi silmek istediğinize emin misiniz?');">
                                <button type="submit" 
                                        class="px-3 py-1 text-xs font-mono font-medium border border-zinc-700 bg-zinc-900 text-zinc-300 hover:bg-zinc-800 hover:text-red-400 rounded-sm transition-colors">
                                    Sil
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="border border-zinc-800 rounded-sm p-12 text-center mt-8">
        <p class="text-zinc-500 font-mono text-sm">Henüz kategori yok.</p>
    </div>
}
