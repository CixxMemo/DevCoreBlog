@* ============================================================================= *@
@* AdminCategory/Edit.cshtml — Edit Category Form (Tech-Minimal Brutalist)        *@
@* ============================================================================= *@
@* Features:                                                                    *@
@*   1. Stable public URL shown alongside editable category name.               *@
@*   2. Tech-Minimal brutalist form structure with 2px borders.                 *@
@* ============================================================================= *@

@model DevCoreBlog.Models.Admin.CategoryFormInput

@{
    ViewData["Title"] = "Kategoriyi düzenle";
}

<div class="max-w-xl mx-auto space-y-6">

    @* Card Wrapper *@
    <div class="border-2 border-black bg-white p-6 md:p-8 space-y-6">

        @* Header *@
        <div class="border-b-2 border-black pb-4">
            <span class="font-mono text-[10px] font-bold text-neutral-500 uppercase tracking-widest">// KATEGORİ AYARLARI</span>
            <h1 class="text-2xl font-black uppercase tracking-tight text-black mt-1">
                Kategoriyi düzenle
            </h1>
        </div>

        <form asp-action="Edit" method="post" class="space-y-5">
            @* Hidden Id *@
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="EditVersion" />

            @* Validation Summary *@
            <div asp-validation-summary="ModelOnly" role="alert" class="border-2 border-rose-600 bg-rose-50 p-3 font-mono text-xs font-bold text-rose-700"></div>
            @if (Context.Response.StatusCode == 409)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="inline-block max-w-full whitespace-normal break-words border-2 border-black px-3 py-2 font-mono text-xs font-bold underline focus:outline-2 focus:outline-offset-2">Güncel kategoriyi yeniden aç</a>
            }

            @* Category Name Input *@
            <div>
                <label for="category-name-input" class="block font-mono text-xs font-bold uppercase text-black mb-1.5">
                    Kategori adı
                </label>
                <input asp-for="Name"
                       id="category-name-input"
                       class="w-full border-2 border-black p-3 font-mono text-sm text-black placeholder-neutral-400 focus:outline-none focus:bg-neutral-50"
                       placeholder="Örn. Yapay zekâ, Felsefe…"
                       autocomplete="off" />
                <span asp-validation-for="Name" class="font-mono text-xs text-rose-600 block mt-1"></span>
            </div>

            @* The stored slug is server-owned and does not change with the name. *@
            <div class="border-2 border-black bg-neutral-50 p-3 space-y-1 font-mono text-xs">
                <div class="text-[10px] font-bold text-neutral-500 uppercase">// Kalıcı adres</div>
                <div class="font-bold text-black break-all">
                    <span class="text-neutral-500">/category/</span>
                    <span id="slug-preview" class="text-black bg-yellow-100 px-1">@Model.Slug</span>
                </div>
            </div>

            @* Action Buttons *@
            <div class="border-t-2 border-black pt-5 flex items-center gap-3">
                <button type="submit"
                        class="border-2 border-black bg-black text-white hover:bg-neutral-800 px-6 py-2.5 font-mono text-xs font-bold uppercase tracking-wider transition-none">
                    Kategoriyi güncelle
                </button>
                <a asp-action="Index"
                   class="border-2 border-black bg-white hover:bg-neutral-100 text-black px-6 py-2.5 font-mono text-xs font-bold uppercase tracking-wider transition-none">
                    Vazgeç
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
