@* ============================================================================= *@
@* AdminCategory/Edit.cshtml — Edit Category Form View (Light — Notion Style)    *@
@* ============================================================================= *@
@* Phase 5.1: Clean, centered, white card layout. Minimalist inputs.             *@
@* ============================================================================= *@

@model Category

@{
    ViewData["Title"] = "Kategori Düzenle";
}

<style>
    .form-card {
        max-width: 500px;
        margin: 40px auto;
        background-color: var(--admin-surface);
        border: 1px solid var(--admin-border);
        border-radius: 8px;
        padding: 32px;
    }
    
    .form-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--admin-text);
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--admin-border);
    }
    
    .form-label {
        display: block;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--admin-text);
        margin-bottom: 6px;
    }
    
    .form-input {
        width: 100%;
        background-color: var(--admin-surface);
        border: 1px solid var(--admin-border);
        color: var(--admin-text);
        font-size: 0.875rem;
        border-radius: 6px;
        padding: 10px 12px;
        transition: border-color 0.1s ease;
        outline: none;
        font-family: var(--admin-font);
        margin-bottom: 4px;
    }
    .form-input:focus {
        border-color: var(--admin-accent);
    }
    
    .form-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 32px;
    }
    
    .btn-submit {
        padding: 8px 20px;
        background-color: var(--admin-accent);
        color: #fff;
        font-size: 0.875rem;
        font-weight: 500;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        transition: opacity 0.1s;
    }
    .btn-submit:hover {
        opacity: 0.9;
    }
    
    .btn-cancel {
        padding: 8px 16px;
        background-color: transparent;
        color: var(--admin-secondary);
        font-size: 0.875rem;
        font-weight: 500;
        border-radius: 6px;
        border: 1px solid var(--admin-border);
        cursor: pointer;
        text-decoration: none;
        transition: all 0.1s;
    }
    .btn-cancel:hover {
        background-color: var(--admin-hover);
        color: var(--admin-text);
    }
</style>

<div class="form-card">
    <h1 class="form-title">Kategori Düzenle</h1>

    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" style="color: var(--admin-danger); font-size: 0.875rem; margin-bottom: 16px;"></div>
        <input type="hidden" asp-for="Id" />
        
        <div>
            <label asp-for="Name" class="form-label">Kategori Adı</label>
            <input asp-for="Name" class="form-input" placeholder="Kategori adını giriniz..." autocomplete="off" />
            <span asp-validation-for="Name" style="color: var(--admin-danger); font-size: 0.75rem;"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-submit">Güncelle</button>
            <a asp-action="Index" class="btn-cancel">İptal</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
