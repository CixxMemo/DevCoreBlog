@* ============================================================================= *@
@* Home/Detail.cshtml — Single Blog Post Detail View (Terminal Theme)            *@
@* ============================================================================= *@
@* This view displays a single blog post in detail. It shows the post title,    *@
@* category badge (linked to the category page), creation date, reading time,   *@
@* view count, and the full post content rendered from Markdown.                *@
@* A link back to the home page is provided at the bottom.                      *@
@*                                                                              *@
@* Terminal Theme: #0d1117 bg, #10b981 accent, monospace meta, sharp edges.     *@
@* ============================================================================= *@

@using DevCoreBlog.Core.Entities
@using DevCoreBlog.Core.Shared.Helpers
@model Post

@{
    ViewData["Title"] = Model.Title;
    // Set the terminal breadcrumb path for the topbar
    ViewData["TerminalPath"] = $"posts/{Model.Slug}";
}

<article class="max-w-3xl mx-auto w-full animate-fade-up">
    @* Post title — large, bold, high contrast *@
    <h1 class="text-3xl md:text-5xl font-bold tracking-tight mb-8 font-sans" style="color: var(--text-primary);">
        @Model.Title
    </h1>

    @* Terminal Status Bar for Meta Information *@
    <div class="bg-zinc-950 border border-zinc-800 p-4 mb-10 flex flex-col sm:flex-row sm:items-center justify-between font-mono text-sm shadow-sm" style="border-left: 3px solid var(--accent);">
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-zinc-400">
            <span>
                <span class="text-orange-500">~</span>/author: <span class="text-white">root</span>
            </span>
            <span>
                <span class="text-orange-500">~</span>/date: <span class="text-white">@Model.PublishDate.ToString("yyyy-MM-dd")</span>
            </span>
            <span>
                <span class="text-orange-500">~</span>/read_time: <span class="text-white">@ViewBag.ReadingTime min</span>
            </span>
        </div>
        <div class="flex items-center gap-4 mt-4 sm:mt-0">
            @if (Model.Category != null)
            {
                <a href="/kategori/@Model.Category.Slug" class="text-zinc-400 hover:text-yellow-400 transition-colors">
                    [tag: @Model.Category.Name.ToLower()]
                </a>
            }
            <span class="text-zinc-600">| views: @ViewBag.ViewCount</span>
        </div>
    </div>

    @* ===================================================================== *@
    @* POST CONTENT — Markdown → HTML (via Markdig)                          *@
    @* ===================================================================== *@
    @* MarkdownHelper.ToHtml() converts the raw Markdown content to HTML.    *@
    @* @Html.Raw() renders the HTML without escaping (required for tags).    *@
    @* Prism.js (loaded in _Layout.cshtml) highlights code blocks            *@
    @* automatically via the "language-*" classes Markdig generates.         *@
    @* ===================================================================== *@
    <div class="markdown-content prose prose-invert max-w-none leading-loose text-lg" style="color: var(--text-secondary);">
        @Html.Raw(MarkdownHelper.ToHtml(Model.Content))
    </div>

    @* Navigation — back to home page & Related Posts *@
    <div class="mt-16 pt-8 border-t border-zinc-800">
        @if (ViewBag.RelatedPosts != null && ((IEnumerable<DevCoreBlog.Core.Entities.Post>)ViewBag.RelatedPosts).Any())
        {
            <div class="mb-10">
                <h3 class="text-xl font-bold mb-6 font-mono text-white">
                    > similar_posts.ls
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    @foreach (var relatedPost in (IEnumerable<DevCoreBlog.Core.Entities.Post>)ViewBag.RelatedPosts)
                    {
                        <a href="/yazi/@relatedPost.Slug" 
                           class="block p-5 transition-all duration-200 group bg-zinc-950 border border-zinc-800 hover:border-orange-500">
                            <h4 class="text-base font-bold mb-3 line-clamp-2 transition-colors text-zinc-200 group-hover:text-yellow-400">
                                @relatedPost.Title
                            </h4>
                            <time class="font-mono text-xs text-zinc-500">
                                @relatedPost.PublishDate.ToString("yyyy-MM-dd")
                            </time>
                        </a>
                    }
                </div>
            </div>
        }

        <a href="/" 
           class="inline-block px-5 py-3 text-sm font-mono transition-colors bg-zinc-900 border border-zinc-700 text-zinc-300 hover:bg-zinc-800 hover:text-yellow-400 hover:border-orange-500">
            ← cd ~/home
        </a>
    </div>
</article>
