@* ============================================================================= *@
@* Home/Detail.cshtml — Single Blog Post Detail View (Tech Minimal)              *@
@* ============================================================================= *@

@using DevCoreBlog.Core.Entities
@using DevCoreBlog.Core.Shared.Helpers
@model Post

@{
    ViewData["Title"] = Model.Title;
    ViewData["TerminalPath"] = $"posts/{Model.Slug}";
}

<article class="max-w-4xl mx-auto w-full">
    @* Post Title *@
    <h1 class="text-2xl sm:text-4xl font-bold tracking-tight mb-6 font-sans text-gray-900 dark:text-zinc-100 leading-tight">
        @Model.Title
    </h1>

    @* Meta Info Bar (Tech Minimal) *@
    <div class="bg-white dark:bg-[#121215] border-2 border-gray-900 dark:border-zinc-700 p-4 mb-8 flex flex-col sm:flex-row sm:items-center justify-between font-mono text-xs gap-3">
        <div class="flex flex-wrap items-center gap-4 text-gray-600 dark:text-zinc-400">
            <span>
                <span class="text-primary font-bold">#</span> @(Model.Category?.Name ?? "General")
            </span>
            <span>|</span>
            <span>
                📅 @Model.PublishDate.ToString("MMM dd, yyyy")
            </span>
            <span>|</span>
            <span>
                ⏱ @ViewBag.ReadingTime min read
            </span>
        </div>
        <div class="text-gray-500 dark:text-zinc-400">
            👁 @Model.ViewCount views
        </div>
    </div>

    @* Optional Hero Thumbnail on detail page *@
    @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
    {
        <div class="mb-8 border-2 border-gray-900 dark:border-zinc-700 overflow-hidden">
            <img src="@Model.ThumbnailUrl" alt="@Model.Title" class="w-full max-h-96 object-cover" />
        </div>
    }

    @* Post Content — Markdown Rendered *@
    <div class="markdown-content text-gray-800 dark:text-zinc-200 leading-relaxed text-base">
        @Html.Raw(MarkdownHelper.ToHtml(Model.Content))
    </div>

    @* Footer Navigation *@
    <div class="mt-12 pt-6 border-t-2 border-gray-900 dark:border-zinc-700 flex justify-between items-center">
        <a href="/" class="px-4 py-2 border-2 border-gray-900 dark:border-zinc-700 text-xs font-mono font-bold text-gray-900 dark:text-zinc-200 hover:bg-gray-900 hover:text-white dark:hover:bg-primary dark:hover:text-white no-underline transition-none">
            ← Back to Home
        </a>
    </div>
</article>
