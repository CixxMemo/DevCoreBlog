@* ============================================================================= *@
@* Home/Detail.cshtml — Single Blog Post Detail View *@
@* ============================================================================= *@
@* This view displays a single blog post in detail. It shows the post title, *@
@* category badge (linked to the category page), creation date, and the full *@
@* post content. A link back to the home page is provided at the bottom. *@
@* This view is rendered by HomeController.Detail(string slug) action. *@
@* ============================================================================= *@

@* Import the Post model so we can use it in the @model directive *@
@using DevCoreBlog.Models
@* Declare the model type: a single Post object passed from HomeController.Detail() *@
@model Post

@* Set the page title to the post's title (shown in browser tab and <title> tag) *@
@{
    ViewData["Title"] = Model.Title;
}

@* --------------------------------------------------------------------------- *@
@* POST HEADER *@
@* --------------------------------------------------------------------------- *@
@* Main heading: the post title *@
<h1 class="mb-3">@Model.Title</h1>

@* Meta information row: category badge + creation date *@
<div class="mb-4">
    @* Category badge — links to the category page (/kategori/{slug}) *@
    @if (Model.Category != null)
    {
        <a href="/kategori/@Model.Category.Slug" class="badge text-bg-primary text-decoration-none">
            @Model.Category.Name
        </a>
    }
    @* Creation date formatted as dd.MM.yyyy (e.g. 05.08.2026) *@
    <small class="text-muted ms-2">@Model.CreatedAt.ToString("dd.MM.yyyy")</small>
</div>

@* --------------------------------------------------------------------------- *@
@* POST CONTENT *@
@* --------------------------------------------------------------------------- *@
@* The full post content. Rendered as HTML (for MVP, content is plain text from textarea). *@
<div class="post-content mb-4">
    @Model.Content
</div>

@* --------------------------------------------------------------------------- *@
@* NAVIGATION *@
@* --------------------------------------------------------------------------- *@
@* Link back to the home page (post list) *@
<a href="/" class="btn btn-outline-secondary">Ana Sayfaya Dön</a>
