@using DevCoreBlog.Models.Public
@using System.Globalization
@model PostDetailModel
@{
    var post = Model.Post;
    ViewData["Title"] = post.Title;
    ViewData["TerminalPath"] = $"posts/{post.Slug}";
}
<article class="reading-article">
    <h1 class="text-2xl sm:text-4xl font-bold tracking-tight mb-6 font-sans leading-tight">@post.Title</h1>
    <div class="public-detail-meta">
        <a class="post-category" href="@PublicUrls.CategoryPath(post.Category.Slug)">@post.Category.Name</a>
        <span>Published <time datetime="@post.PublishDate.ToString("O", CultureInfo.InvariantCulture)">@SiteDates.Date(post.PublishDate)</time></span>
        @if (post.UpdatedDate is { } updated)
        {
            <span>Updated <time datetime="@updated.ToString("O", CultureInfo.InvariantCulture)">@SiteDates.Date(updated)</time></span>
        }
        <span>@Model.Content.ReadingMinutes min read</span>
        <span>@post.ViewCount views</span>
    </div>
    @if (!string.IsNullOrEmpty(post.ThumbnailUrl))
    {
        <div class="mb-8 border-2 border-gray-900 dark:border-zinc-700 overflow-hidden">
            <img src="@post.ThumbnailUrl" alt="" class="public-detail-cover" />
        </div>
    }
    @if (Model.Content.Headings.Count >= 3)
    {
        <nav class="article-toc" aria-label="Table of contents">
            <h2 class="font-mono font-bold mb-3">On this page</h2>
            <ol>
                @foreach (var heading in Model.Content.Headings)
                {
                    <li class="@(heading.Level > 2 ? "toc-nested" : null)"><a href="#@heading.Id">@(string.IsNullOrWhiteSpace(heading.Title) ? "Section" : heading.Title)</a></li>
                }
            </ol>
        </nav>
    }
    <partial name="_RenderedMarkdown" model="Model.Content" />
    @if (Model.RelatedPosts.Count > 0)
    {
        <section class="mt-12" aria-labelledby="related-heading">
            <h2 id="related-heading" class="font-mono font-bold text-xl mb-6">Related articles</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var related in Model.RelatedPosts)
                {
                    <partial name="_PostCard" model="new PostCardModel(related, PostCardPresentation.Standard)" />
                }
            </div>
        </section>
    }
    <div class="mt-12 pt-6 border-t-2 border-gray-900 dark:border-zinc-700">
        <a href="/" class="underline font-mono">← Back to Home</a>
    </div>
</article>
@section Scripts {
    <script type="module" src="~/js/article-reading.js" asp-append-version="true"></script>
}
