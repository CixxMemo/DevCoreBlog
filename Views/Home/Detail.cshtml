@* ============================================================================= *@
@* Home/Detail.cshtml — Single Blog Post Detail View (Tech Minimal — Dark Zinc) *@
@* ============================================================================= *@
@* This view displays a single blog post in detail. It shows the post title, *@
@* category badge (linked to the category page), creation date, and the full *@
@* post content. A link back to the home page is provided at the bottom. *@
@* *@
@* Phase 2 (FIX): Zinc dark palette. Sharp borders, monospace meta tags. *@
@* Tags styled with font-mono text-xs bg-zinc-900 border-zinc-800. *@
@* ============================================================================= *@

@using DevCoreBlog.Models
@using DevCoreBlog.Helpers
@model Post

@{
    ViewData["Title"] = Model.Title;
}

<article class="max-w-3xl">
    @* Post title — large, bold, high contrast *@
    <h1 class="text-3xl font-bold tracking-tight mb-4 text-zinc-100">
        @Model.Title
    </h1>

    @* Meta information row: category badge + creation date + reading time + view count *@
    <div class="flex items-center gap-3 mb-8 pb-6 border-b border-zinc-800">
        @if (Model.Category != null)
        {
            <a href="/kategori/@Model.Category.Slug" 
               class="font-mono text-xs text-zinc-400 bg-zinc-900 px-2 py-1 rounded-sm border border-zinc-800 hover:border-accent hover:text-accent transition-colors">
                @Model.Category.Name
            </a>
        }
        <time class="font-mono text-xs text-zinc-500">
            @Model.CreatedDate.ToString("dd.MM.yyyy")
        </time>
        <span class="font-mono text-xs text-zinc-500">
            @ViewBag.ReadingTime min read
        </span>
        <span class="font-mono text-xs text-zinc-500">
            @ViewBag.ViewCount views
        </span>
    </div>

    @* ===================================================================== *@
    @* POST CONTENT — Markdown → HTML (via Markdig)                          *@
    @* ===================================================================== *@
    @* MarkdownHelper.ToHtml() converts the raw Markdown content to HTML.    *@
    @* @Html.Raw() renders the HTML without escaping (required for tags).    *@
    @* Prism.js (loaded in _Layout.cshtml) highlights code blocks            *@
    @* automatically via the "language-*" classes Markdig generates.         *@
    @* ===================================================================== *@
    <div class="markdown-content prose prose-invert max-w-none text-zinc-300 leading-relaxed">
        @Html.Raw(MarkdownHelper.ToHtml(Model.Content))
    </div>

    @* Navigation — back to home page *@
    <div class="mt-12 pt-6 border-t border-zinc-800">
        <a href="/" 
           class="inline-block px-4 py-2 text-sm font-mono font-medium border border-zinc-700 text-zinc-300 hover:border-accent hover:text-accent rounded-sm transition-colors">
            ← Ana Sayfaya Dön
        </a>
    </div>
</article>
