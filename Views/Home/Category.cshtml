@* ============================================================================= *@
@* Home/Category.cshtml — Category Posts List View (Terminal Theme)              *@
@* ============================================================================= *@
@* This view displays all published posts in a specific category. The category  *@
@* name is shown as a heading, followed by a list of posts in the same card     *@
@* structure as the home page. If there are no posts in the category, a         *@
@* friendly message is shown instead.                                           *@
@* This view is rendered by HomeController.Category(string slug) action.        *@
@* ============================================================================= *@

@using DevCoreBlog.Models
@model List<Post>

@{
    ViewData["Title"] = ViewBag.CategoryName;
    // Set the terminal breadcrumb path for the topbar
    ViewData["TerminalPath"] = $"kategori/{ViewBag.CategorySlug}";
}

@* Page heading — bold, high contrast, monospace *@
<h1 class="text-2xl font-bold tracking-tight mb-8 font-mono" style="color: var(--text-primary);">
    "@ViewBag.CategoryName" Kategorisi
</h1>

@if (Model.Any())
{
    <div class="space-y-4">
        @foreach (var item in Model)
        {
            @* Post card — Terminal-styled with orange hover border *@
            <article class="p-6 transition-colors duration-200"
                     style="background-color: var(--bg-card); border: 1px solid var(--border);"
                     onmouseover="this.style.borderColor='var(--accent)';"
                     onmouseout="this.style.borderColor='var(--border)';">
                <h2 class="text-lg font-semibold mb-3">
                    <a asp-controller="Home" asp-action="Detail" asp-route-slug="@item.Slug" 
                       class="transition-colors"
                       style="color: var(--text-primary); text-decoration: none;"
                       onmouseover="this.style.color='var(--accent)';"
                       onmouseout="this.style.color='var(--text-primary)';">
                        @item.Title
                    </a>
                </h2>

                <div class="flex items-center gap-3 mb-4">
                    @if (item.Category != null)
                    {
                        <a href="/kategori/@item.Category.Slug" 
                           class="font-mono text-xs px-2 py-1 transition-colors"
                           style="color: var(--text-secondary); background: var(--bg-surface); border: 1px solid var(--border);"
                           onmouseover="this.style.borderColor='var(--accent)'; this.style.color='var(--accent)';"
                           onmouseout="this.style.borderColor='var(--border)'; this.style.color='var(--text-secondary)';">
                            @item.Category.Name
                        </a>
                    }
                    <time class="font-mono text-xs" style="color: var(--text-muted);">
                        @item.CreatedDate.ToString("yyyy-MM-dd")
                    </time>
                </div>

                <p class="text-sm leading-relaxed mb-4" style="color: var(--text-secondary);">
                    @item.Summary
                </p>

                <a href="/yazi/@item.Slug" 
                   class="inline-block px-3 py-1.5 text-xs font-mono font-medium transition-colors"
                   style="border: 1px solid var(--border); color: var(--text-secondary);"
                   onmouseover="this.style.borderColor='var(--accent)'; this.style.color='var(--accent)';"
                   onmouseout="this.style.borderColor='var(--border)'; this.style.color='var(--text-secondary)';">
                    Devamını Oku →
                </a>
            </article>
        }
    </div>

    @* Pagination *@
    @if (ViewBag.TotalPages > 1)
    {
        <div class="mt-8 flex justify-between items-center pt-6" style="border-top: 1px solid var(--border);">
            @if (ViewBag.CurrentPage > 1)
            {
                <a href="?page=@(ViewBag.CurrentPage - 1)" 
                   class="px-4 py-2 text-sm font-mono font-medium transition-colors"
                   style="border: 1px solid var(--border); color: var(--text-secondary);"
                   onmouseover="this.style.borderColor='var(--accent)'; this.style.color='var(--accent)';"
                   onmouseout="this.style.borderColor='var(--border)'; this.style.color='var(--text-secondary)';">
                    ← Önceki Sayfa
                </a>
            }
            else
            {
                <div></div>
            }

            <span class="font-mono text-xs" style="color: var(--text-muted);">
                Sayfa @ViewBag.CurrentPage / @ViewBag.TotalPages
            </span>

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <a href="?page=@(ViewBag.CurrentPage + 1)" 
                   class="px-4 py-2 text-sm font-mono font-medium transition-colors"
                   style="border: 1px solid var(--border); color: var(--text-secondary);"
                   onmouseover="this.style.borderColor='var(--accent)'; this.style.color='var(--accent)';"
                   onmouseout="this.style.borderColor='var(--border)'; this.style.color='var(--text-secondary)';">
                    Sonraki Sayfa →
                </a>
            }
            else
            {
                <div></div>
            }
        </div>
    }
}
else
{
    <div class="p-12 text-center" style="border: 1px solid var(--border);">
        <p class="font-mono text-sm" style="color: var(--text-muted);">Bu kategoride yazı yok.</p>
    </div>
}
