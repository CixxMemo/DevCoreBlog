@using DevCoreBlog.Models.Public
@model PublicListPageModel
@{
    ViewData["Title"] = Model.CategoryName;
}
<div class="w-full max-w-5xl mx-auto">
    <header class="border-b-2 border-gray-900 dark:border-zinc-700 pb-4 mb-6">
        <h1 class="text-2xl font-mono font-bold mb-3 break-words"># @Model.CategoryName</h1>
        <p>@Model.Result.TotalCount yazı · Bu sayfada @Model.Result.Posts.Count yazı · Sayfa @Model.Paging.Page / @Model.Paging.TotalPages</p>
    </header>
    <form method="get" class="public-list-filters" aria-label="Kategori filtreleri">
        <partial name="_PublicKindFilter" model='new PublicKindFilterModel("category-kind", Model.Paging.Kind)' />
        <div>
            <label for="category-page-size">Sayfa başına yazı</label>
            <select id="category-page-size" name="pageSize">
                @foreach (var size in DevCoreBlog.Core.Validation.PublicListBounds.PageSizes)
                {
                    <option value="@size" selected="@(size == Model.Paging.PageSize)">@size</option>
                }
            </select>
        </div>
        <button type="submit">Filtreleri uygula</button>
        <a asp-controller="Home" asp-action="Search" asp-route-category="@Model.Paging.Slug" asp-route-kind="@Model.Paging.Kind" class="underline">Bu kategoride ara</a>
    </form>
    @if (Model.Result.Posts.Count > 0)
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
            @foreach (var item in Model.Result.Posts)
            {
                <partial name="_PostCard" model="new PostCardModel(item)" />
            }
        </div>
    }
    else
    {
        <partial name="_PublicEmptyState" model='"Bu kategoride henüz yayımlanmış yazı yok."' />
        <a href="/" class="underline">Ana sayfaya dön</a>
    }
    <partial name="_PublicPaging" model="Model.Paging" />
</div>
