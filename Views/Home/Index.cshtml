@using DevCoreBlog.Models.Public
@model HomePageModel
@{
    ViewData["Title"] = "Home";
    // Feature cards are a partition of page one, never additional duplicates.
    var features = Model.CurrentPage == 1 ? Model.Posts.Take(3).ToList() : new List<DevCoreBlog.Core.Entities.Post>();
    var feed = Model.Posts.Skip(features.Count).ToList();
}
<div class="w-full min-w-0">
    <header class="mb-6 border-b-2 border-gray-900 dark:border-zinc-700 pb-4">
        <h1 class="font-mono font-bold text-2xl mb-2">DevCoreBlog</h1>
        <p class="font-mono text-sm">@Model.TotalCount articles · @Model.Posts.Count on this page · Page @Model.CurrentPage of @Model.TotalPages</p>
    </header>
    <div class="flex flex-col xl:flex-row gap-8 min-w-0">
        <div class="flex-1 min-w-0">
            @if (features.Count > 0)
            {
                <section id="home-featured" aria-label="Latest featured articles" class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-10">
                    <div class="@(features.Count > 1 ? "lg:col-span-7" : "lg:col-span-12")">
                        <partial name="_PostCard" model="new PostCardModel(features[0], PostCardPresentation.Featured)" />
                    </div>
                    @if (features.Count > 1)
                    {
                        <div class="lg:col-span-5 flex flex-col gap-6">
                            @foreach (var post in features.Skip(1))
                            {
                                <partial name="_PostCard" model="new PostCardModel(post, PostCardPresentation.Compact)" />
                            }
                        </div>
                    }
                </section>
            }
            @if (feed.Count > 0)
            {
                <section aria-labelledby="latest-heading">
                    <h2 id="latest-heading" class="font-mono font-bold text-xl border-b-2 border-gray-900 dark:border-zinc-700 pb-2 mb-6">Latest Articles</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
                        @foreach (var post in feed)
                        {
                            <partial name="_PostCard" model="new PostCardModel(post, PostCardPresentation.Standard)" />
                        }
                    </div>
                </section>
            }
            @if (Model.TotalCount == 0)
            {
                <partial name="_PublicEmptyState" model='"No articles published yet."' />
            }
        @* --- 4. Pagination Controls --- *@
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Article pages" class="flex flex-wrap gap-3 justify-between items-center pt-6 border-t-2 border-gray-900 dark:border-zinc-700 font-mono text-xs font-bold">
                @if (Model.CurrentPage > 1)
                {
                    <a href="?page=@(Model.CurrentPage - 1)" class="px-4 py-2 border-2 border-gray-900 dark:border-zinc-700 text-gray-900 dark:text-zinc-100 hover:bg-gray-900 hover:text-white dark:hover:bg-primary dark:hover:text-white no-underline transition-none">
                        &lt; Previous
                    </a>
                }
                else
                {
                    <span class="px-4 py-2 border-2 border-gray-200 dark:border-zinc-800 text-gray-300 dark:text-zinc-600 cursor-not-allowed">
                        &lt; Previous
                    </span>
                }

                <span class="text-gray-600 dark:text-zinc-400">
                    Page @(Model.CurrentPage) of @(Model.TotalPages)
                </span>

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a href="?page=@(Model.CurrentPage + 1)" class="px-4 py-2 border-2 border-gray-900 dark:border-zinc-700 text-gray-900 dark:text-zinc-100 hover:bg-gray-900 hover:text-white dark:hover:bg-primary dark:hover:text-white no-underline transition-none">
                        Next &gt;
                    </a>
                }
                else
                {
                    <span class="px-4 py-2 border-2 border-gray-200 dark:border-zinc-800 text-gray-300 dark:text-zinc-600 cursor-not-allowed">
                        Next &gt;
                    </span>
                }
            </nav>
        }
        </div>
        <aside aria-label="Discover articles" class="w-full xl:w-80 flex-shrink-0 flex flex-col gap-6">
            <partial name="_MostRead" model="Model.MostRead" />
            @await Component.InvokeAsync("PublicCategoryNavigation", new { featured = true })
        </aside>
    </div>
</div>
