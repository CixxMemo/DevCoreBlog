@* ============================================================================= *@
@* Home/Index.cshtml — Public Home Page View (Tech Minimal)                      *@
@* ============================================================================= *@
@* Phase 3 Design:                                                               *@
@*   - Carousel: Shows top 3 latest posts with auto-slide and controls.          *@
@*   - Post Feed: Stacked list of remaining posts.                               *@
@*   - Card Design: Sharp edges (rounded-none), orange borders on hover.         *@
@* ============================================================================= *@

@using DevCoreBlog.Core.Entities
@model List<Post>

@{
    ViewData["Title"] = "Ana Sayfa";
    
    var heroPosts = Model.Take(3).ToList();
    var feedPosts = Model.Skip(3).ToList();
}

@if (Model.Any())
{
    @* ========================================================================= *@
    @* CAROUSEL (Adım 3.2 & 3.3)                                                 *@
    @* ========================================================================= *@
    <div id="hero-carousel" class="relative w-full overflow-hidden mb-12 bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark" style="background-color: var(--bg-card); border: 1px solid var(--border);">
        
        @* Carousel Track *@
        <div id="carousel-track" class="flex transition-transform duration-500 ease-in-out" style="transform: translateX(0%);">
            @for (int i = 0; i < heroPosts.Count; i++)
            {
                var post = heroPosts[i];
                <div class="w-full flex-shrink-0" style="padding: 3rem 2rem;">
                    <a href="/yazi/@post.Slug" class="flex flex-col justify-center items-center w-full h-full text-center" style="text-decoration: none;">
                        @if (!string.IsNullOrEmpty(post.ThumbnailUrl))
                        {
                            <img src="@post.ThumbnailUrl" alt="@post.Title" class="mx-auto h-48 sm:h-64 object-cover mb-6 w-full max-w-2xl" style="border: 1px solid var(--border);" />
                        }
                        @if (post.Category != null)
                        {
                            <span class="inline-block px-2 py-1 text-xs font-mono mb-4" style="background-color: var(--bg-surface); color: var(--text-secondary); border: 1px solid var(--border);">
                                @post.Category.Name
                            </span>
                        }
                        <h2 class="text-3xl sm:text-4xl font-bold mb-4 font-sans tracking-tight transition-colors" style="color: var(--text-primary);"
                            onmouseenter="this.style.color='var(--accent)';" onmouseleave="this.style.color='var(--text-primary)';">
                            @post.Title
                        </h2>
                        <p class="text-sm font-sans mx-auto max-w-2xl leading-relaxed" style="color: var(--text-secondary); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @post.Summary
                        </p>
                    </a>
                </div>
            }
        </div>

        @* Left / Right Arrows *@
        <button id="carousel-prev" class="absolute left-0 top-1/2 -translate-y-1/2 px-4 py-8 bg-transparent border-none cursor-pointer transition-colors" style="color: var(--text-muted);"
                onmouseenter="this.style.color='var(--accent)';" onmouseleave="this.style.color='var(--text-muted)';">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
        </button>
        <button id="carousel-next" class="absolute right-0 top-1/2 -translate-y-1/2 px-4 py-8 bg-transparent border-none cursor-pointer transition-colors" style="color: var(--text-muted);"
                onmouseenter="this.style.color='var(--accent)';" onmouseleave="this.style.color='var(--text-muted)';">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
        </button>

        @* Pagination Dots *@
        <div class="absolute bottom-4 left-0 right-0 flex justify-center gap-2">
            @for (int i = 0; i < heroPosts.Count; i++)
            {
                <button class="carousel-dot w-2 h-2 rounded-none border-none p-0 cursor-pointer" data-index="@i" style="background-color: @(i == 0 ? "var(--accent)" : "var(--border)");"></button>
            }
        </div>
    </div>

    @* Carousel Vanilla JS Logic *@
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const track = document.getElementById('carousel-track');
            const prevBtn = document.getElementById('carousel-prev');
            const nextBtn = document.getElementById('carousel-next');
            const dots = document.querySelectorAll('.carousel-dot');
            const totalSlides = @heroPosts.Count;
            let currentSlide = 0;
            let autoSlideInterval;

            function goToSlide(index) {
                if (index < 0) index = totalSlides - 1;
                if (index >= totalSlides) index = 0;
                
                currentSlide = index;
                track.style.transform = `translateX(-${currentSlide * 100}%)`;
                
                dots.forEach((dot, i) => {
                    dot.style.backgroundColor = (i === currentSlide) ? 'var(--accent)' : 'var(--border)';
                });
            }

            function nextSlide() { goToSlide(currentSlide + 1); }
            function prevSlide() { goToSlide(currentSlide - 1); }

            function startAutoSlide() {
                autoSlideInterval = setInterval(nextSlide, 8000); // 8 seconds
            }
            function stopAutoSlide() {
                clearInterval(autoSlideInterval);
            }

            nextBtn.addEventListener('click', () => { nextSlide(); stopAutoSlide(); startAutoSlide(); });
            prevBtn.addEventListener('click', () => { prevSlide(); stopAutoSlide(); startAutoSlide(); });
            
            dots.forEach(dot => {
                dot.addEventListener('click', (e) => {
                    const idx = parseInt(e.target.getAttribute('data-index'));
                    goToSlide(idx);
                    stopAutoSlide();
                    startAutoSlide();
                });
            });

            // Pause on hover
            const carousel = document.getElementById('hero-carousel');
            carousel.addEventListener('mouseenter', stopAutoSlide);
            carousel.addEventListener('mouseleave', startAutoSlide);

            startAutoSlide();
        });
    </script>

    @* ========================================================================= *@
    @* POST FEED (Adım 3.4 & 3.5)                                                *@
    @* ========================================================================= *@
    <div class="flex flex-col gap-6 mb-12">
        <h3 class="text-lg font-mono font-bold mb-4" style="color: var(--text-primary); border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;">
            Son Yazılar
        </h3>

        @foreach (var item in feedPosts)
        {
            @* Stacked Post Card — Tech Minimal (sharp edges, orange border on hover) with Thumbnail *@
            <a href="/yazi/@item.Slug" class="block transition-all duration-200" style="text-decoration: none;">
                <div class="flex flex-col sm:flex-row transition-colors" style="background-color: var(--bg-card); border: 1px solid var(--border);"
                     onmouseenter="this.style.borderColor='var(--accent)';" onmouseleave="this.style.borderColor='var(--border)';">
                    
                    @if (!string.IsNullOrEmpty(item.ThumbnailUrl))
                    {
                        <div class="sm:w-1/3 flex-shrink-0" style="border-bottom: 1px solid var(--border);">
                            <img src="@item.ThumbnailUrl" alt="@item.Title" class="w-full h-48 sm:h-full object-cover" 
                                 style="border-right: 1px solid var(--border);" />
                        </div>
                    }
                    
                    <div class="p-6 flex-grow flex flex-col justify-center">
                        <div class="flex items-center gap-3 mb-3">
                            <span class="font-mono text-xs" style="color: var(--text-muted);">
                                @item.PublishDate.ToString("dd MMM yyyy")
                            </span>
                            @if (item.Category != null)
                            {
                                <span style="color: var(--border);">|</span>
                                <span class="font-mono text-xs" style="color: var(--accent);">
                                    @item.Category.Name
                                </span>
                            }
                        </div>
                        
                        <h2 class="text-xl sm:text-2xl font-bold font-sans tracking-tight mb-3" style="color: var(--text-primary);">
                            @item.Title
                        </h2>
                        
                        <p class="text-sm font-sans leading-relaxed m-0" style="color: var(--text-secondary); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @item.Summary
                        </p>
                    </div>
                </div>
            </a>
        }
    </div>

    @* ========================================================================= *@
    @* PAGINATION                                                                *@
    @* ========================================================================= *@
    @if (ViewBag.TotalPages > 1)
    {
        <div class="flex justify-between items-center pt-6 font-mono text-sm" style="border-top: 1px solid var(--border);">
            @if (ViewBag.CurrentPage > 1)
            {
                <a href="?page=@(ViewBag.CurrentPage - 1)" class="px-4 py-2 transition-colors" style="border: 1px solid var(--border); color: var(--text-primary); text-decoration: none;"
                   onmouseenter="this.style.borderColor='var(--accent)'; this.style.color='var(--accent)';" onmouseleave="this.style.borderColor='var(--border)'; this.style.color='var(--text-primary)';">
                    &lt; Önceki
                </a>
            }
            else
            {
                <div></div>
            }

            <span style="color: var(--text-muted);">
                Sayfa @(ViewBag.CurrentPage) / @(ViewBag.TotalPages)
            </span>

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <a href="?page=@(ViewBag.CurrentPage + 1)" class="px-4 py-2 transition-colors" style="border: 1px solid var(--border); color: var(--text-primary); text-decoration: none;"
                   onmouseenter="this.style.borderColor='var(--accent)'; this.style.color='var(--accent)';" onmouseleave="this.style.borderColor='var(--border)'; this.style.color='var(--text-primary)';">
                    Sonraki &gt;
                </a>
            }
            else
            {
                <div></div>
            }
        </div>
    }
}
else
{
    @* Empty State *@
    <div class="p-12 text-center" style="background-color: var(--bg-card); border: 1px solid var(--border);">
        <p class="font-mono text-sm" style="color: var(--text-muted);">
            Henüz hiç yazı yayınlanmamış.
        </p>
    </div>
}
