@* ============================================================================= *@
@* Home/Index.cshtml — Public Home Page View (Phase 2 — Grid Card Layout)       *@
@* ============================================================================= *@
@* This is the main landing page of the blog. It displays a grid of published   *@
@* blog posts as terminal-styled cards.                                         *@
@*                                                                              *@
@* Phase 2 Card Design:                                                         *@
@*   - Header: Monospace date and category [2026-08-09] [C#]                    *@
@*   - Body: Post title in Terminal Orange, brief description                   *@
@*   - Interaction: Entire card is clickable, minimalist hover transition       *@
@*   - Grid: 2 columns on desktop, 1 column on mobile                          *@
@* ============================================================================= *@

@using DevCoreBlog.Models
@model List<Post>

@{
    ViewData["Title"] = "Ana Sayfa";
    // Set the terminal breadcrumb path for the topbar
    ViewData["TerminalPath"] = "posts";
}

@* Page heading — bold, high contrast, monospace *@
<h1 class="text-2xl font-bold tracking-tight mb-8 font-mono" style="color: var(--text-primary);">
    $ ls ./posts/
</h1>

@if (Model.Any())
{
    @* Post Grid — 2 columns on desktop, 1 on mobile *@
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        @{ int index = 0; }
        @foreach (var item in Model)
        {
            @* ── Post Card ── *@
            @* Entire card is wrapped in an <a> tag for full-card clickability *@
            <a href="/yazi/@item.Slug" 
               class="group block animate-fade-up post-card"
               style="animation-delay: @(index * 75)ms;">
                
                @* Card Header — Terminal-style meta: [date] [category] *@
                <div class="post-card-meta">
                    <span class="post-card-tag">[@item.CreatedDate.ToString("yyyy-MM-dd")]</span>
                    @if (item.Category != null)
                    {
                        <span class="post-card-tag">[@item.Category.Name]</span>
                    }
                </div>

                @* Card Body — Title (orange) + description *@
                <h2 class="post-card-title">
                    @item.Title
                </h2>

                <p class="post-card-summary leading-relaxed">
                    @item.Summary
                </p>

                @* Card Footer — Read more indicator *@
                <div class="post-card-footer">
                    <span>cat README.md</span>
                    <span class="post-card-arrow">&rarr;</span>
                </div>
            </a>
            index++;
        }
    </div>

    @* Pagination — terminal-styled page navigation *@
    @if (ViewBag.TotalPages > 1)
    {
        <div class="mt-8 flex justify-between items-center pt-6" style="border-top: 1px solid var(--border);">
            @if (ViewBag.CurrentPage > 1)
            {
                <a href="?page=@(ViewBag.CurrentPage - 1)" class="pagination-link">
                    ← prev
                </a>
            }
            else
            {
                <div></div>
            }

            <span class="font-mono text-xs" style="color: var(--text-muted);">
                [@ViewBag.CurrentPage/@ViewBag.TotalPages]
            </span>

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <a href="?page=@(ViewBag.CurrentPage + 1)" class="pagination-link">
                    next →
                </a>
            }
            else
            {
                <div></div>
            }
        </div>
    }
}
else
{
    <div class="p-12 text-center" style="border: 1px solid var(--border);">
        <p class="font-mono text-sm" style="color: var(--text-muted);">
            $ ls ./posts/<br>
            <span style="color: var(--accent);">0 results</span>
        </p>
    </div>
}
