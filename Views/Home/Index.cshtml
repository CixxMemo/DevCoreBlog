@* ============================================================================= *@
@* Home/Index.cshtml — Public Home Page View (Tech Minimal — Dark Zinc) *@
@* ============================================================================= *@
@* This is the main landing page of the blog. It displays a list of published *@
@* blog posts as minimalist cards with sharp borders, monospace meta tags, and *@
@* subtle hover states. Each card shows the post title, summary, category badge *@
@* (linked to the category page), creation date, and a "Read More" link. *@
@* If there are no published posts, a clean empty state message is shown. *@
@* *@
@* Phase 2 (FIX): Zinc dark palette. Sharp borders, no shadows, no gradients. *@
@* Tags/meta styled with font-mono text-xs bg-zinc-900 border-zinc-800. *@
@* ============================================================================= *@

@using DevCoreBlog.Models
@model List<Post>

@{
    ViewData["Title"] = "Ana Sayfa";
}

@* Page heading — bold, high contrast *@
<h1 class="text-2xl font-bold tracking-tight mb-8 text-zinc-100 font-mono">
    Yazılar
</h1>

@if (Model.Any())
{
    <div class="space-y-4">
        @foreach (var item in Model)
        {
            <article class="border border-zinc-800 rounded-sm p-6 hover:border-zinc-600 transition-colors">
                <h2 class="text-lg font-semibold mb-3">
                    <a asp-controller="Home" asp-action="Detail" asp-route-slug="@item.Slug" 
                       class="text-zinc-100 hover:text-accent transition-colors">
                        @item.Title
                    </a>
                </h2>

                <div class="flex items-center gap-3 mb-4">
                    @if (item.Category != null)
                    {
                        <a href="/kategori/@item.Category.Slug" 
                           class="font-mono text-xs text-zinc-400 bg-zinc-900 px-2 py-1 rounded-sm border border-zinc-800 hover:border-accent hover:text-accent transition-colors">
                            @item.Category.Name
                        </a>
                    }
                    <time class="font-mono text-xs text-zinc-500">
                        @item.CreatedDate.ToString("dd.MM.yyyy")
                    </time>
                </div>

                <p class="text-zinc-400 text-sm leading-relaxed mb-4">
                    @item.Summary
                </p>

                <a href="/yazi/@item.Slug" 
                   class="inline-block px-3 py-1.5 text-xs font-mono font-medium border border-zinc-700 text-zinc-300 hover:border-accent hover:text-accent rounded-sm transition-colors">
                    Devamını Oku →
                </a>
            </article>
        }
    </div>
}
else
{
    <div class="border border-zinc-800 rounded-sm p-12 text-center">
        <p class="text-zinc-500 font-mono text-sm">Henüz yazı yok.</p>
    </div>
}
