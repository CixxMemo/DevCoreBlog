@using DevCoreBlog.Models.Public
@model PublicListPageModel
@{
    ViewData["Title"] = "Arama sonuçları";
    ViewData["SearchQuery"] = Model.Paging.Query;
}
<div class="w-full max-w-5xl mx-auto">
    <header class="border-b-2 border-gray-900 dark:border-zinc-700 pb-4 mb-6">
        <h1 class="text-2xl font-mono font-bold mb-3">Arama sonuçları</h1>
        <p class="break-words">Aranan ifade: <strong>@Model.Paging.Query</strong></p>
        <p>Kategori: @(Model.CategoryName ?? "Tüm kategoriler")</p>
        <p>@Model.Result.TotalCount yazı bulundu · Bu sayfada @Model.Result.Posts.Count yazı · Sayfa @Model.Paging.Page / @Model.Paging.TotalPages</p>
    </header>
    <form action="/ara" method="get" aria-label="Arama filtreleri" class="public-list-filters">
        <input type="hidden" name="query" value="@Model.Paging.Query" />
        <partial name="_PublicKindFilter" model='new PublicKindFilterModel("search-kind", Model.Paging.Kind)' />
        <div>
            <label for="search-category">Kategori</label>
            <select id="search-category" name="category">
                <option value="">Tüm kategoriler</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Slug" selected="@(category.Slug == Model.Paging.Category)">@category.Name</option>
                }
            </select>
        </div>
        <div>
            <label for="search-page-size">Sayfa başına yazı</label>
            <select id="search-page-size" name="pageSize">
                @foreach (var size in DevCoreBlog.Core.Validation.PublicListBounds.PageSizes)
                {
                    <option value="@size" selected="@(size == Model.Paging.PageSize)">@size</option>
                }
            </select>
        </div>
        <button type="submit">Filtreleri uygula</button>
    </form>
    @if (Model.Result.Posts.Count > 0)
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
            @foreach (var item in Model.Result.Posts)
            {
                <partial name="_PostCard" model="new PostCardModel(item)" />
            }
        </div>
    }
    else
    {
        <partial name="_PublicEmptyState" model='string.IsNullOrWhiteSpace(Model.Paging.Query) ? "Yazıları bulmak için bir arama ifadesi girin." : "Bu filtrelere uygun yazı bulunamadı. Başka bir ifade veya kategori deneyin."' />
        <a asp-controller="Home" asp-action="Search" asp-route-query="@Model.Paging.Query" asp-route-pageSize="@(Model.Paging.PageSize == 9 ? null : Model.Paging.PageSize)" asp-route-kind="@Model.Paging.Kind" class="underline">Kategori filtresini kaldır</a>
        <a href="/" class="underline ml-4">Ana sayfaya dön</a>
    }
    <partial name="_PublicPaging" model="Model.Paging" />
</div>
