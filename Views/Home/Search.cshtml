@using DevCoreBlog.Models.Public
@model PublicListPageModel
@{
    ViewData["Title"] = "Search Results";
    ViewData["SearchQuery"] = Model.Paging.Query;
}
<div class="w-full max-w-5xl mx-auto">
    <header class="border-b-2 border-gray-900 dark:border-zinc-700 pb-4 mb-6">
        <h1 class="text-2xl font-mono font-bold mb-3">Search Results</h1>
        <p class="break-words">Search query: <strong>@Model.Paging.Query</strong></p>
        <p>Category: @(Model.CategoryName ?? "All categories")</p>
        <p>@Model.Result.TotalCount articles found · @Model.Result.Posts.Count on this page · Page @Model.Paging.Page of @Model.Paging.TotalPages</p>
    </header>
    <form action="/ara" method="get" aria-label="Search filters" class="public-list-filters">
        <input type="hidden" name="query" value="@Model.Paging.Query" />
        <div>
            <label for="search-category">Category</label>
            <select id="search-category" name="category">
                <option value="">All categories</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Slug" selected="@(category.Slug == Model.Paging.Category)">@category.Name</option>
                }
            </select>
        </div>
        <div>
            <label for="search-page-size">Articles per page</label>
            <select id="search-page-size" name="pageSize">
                @foreach (var size in DevCoreBlog.Core.Validation.PublicListBounds.PageSizes)
                {
                    <option value="@size" selected="@(size == Model.Paging.PageSize)">@size</option>
                }
            </select>
        </div>
        <button type="submit">Apply filters</button>
    </form>
    @if (Model.Result.Posts.Count > 0)
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
            @foreach (var item in Model.Result.Posts)
            {
                <partial name="_PostCard" model="new PostCardModel(item)" />
            }
        </div>
    }
    else
    {
        <partial name="_PublicEmptyState" model='string.IsNullOrWhiteSpace(Model.Paging.Query) ? "Enter a search term to find articles." : "No articles match these filters. Try another term or category."' />
        <a asp-controller="Home" asp-action="Search" asp-route-query="@Model.Paging.Query" asp-route-pageSize="@(Model.Paging.PageSize == 9 ? null : Model.Paging.PageSize)" class="underline">Clear category filter</a>
        <a href="/" class="underline ml-4">Back to Home</a>
    }
    <partial name="_PublicPaging" model="Model.Paging" />
</div>
