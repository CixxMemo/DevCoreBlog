@* ============================================================================= *@
@* Home/Search.cshtml — Search Results View (Tech Minimal — Dark Zinc)           *@
@* ============================================================================= *@
@* This view displays search results when a user searches for posts.             *@
@* It shows the search query and a list of matching posts (if any).              *@
@* Each post is displayed as a card with title, summary, category, and date.     *@
@*                                                                              *@
@* The search query is passed via ViewBag.SearchQuery from the controller.       *@
@* The posts are passed as the model (IEnumerable<Post>).                        *@
@* ============================================================================= *@

@using DevCoreBlog.Models
@model IEnumerable<Post>

@{
    ViewData["Title"] = "Arama Sonuçları";
}

<article class="max-w-3xl">
    @* Page title with search query *@
    <h1 class="text-3xl font-bold tracking-tight mb-4 text-zinc-100">
        Arama Sonuçları
    </h1>

    @* Search query display — shows what the user searched for *@
    @if (!string.IsNullOrEmpty(ViewBag.SearchQuery))
    {
        <p class="font-mono text-sm text-zinc-400 mb-8 pb-6 border-b border-zinc-800">
            "<span class="text-accent">@ViewBag.SearchQuery</span>" için arama sonuçları:
        </p>
    }

    @* ===================================================================== *@
    @* SEARCH RESULTS — List of matching posts                               *@
    @* ===================================================================== *@
    @* If there are results, display them as cards. Otherwise, show a        *@
    @* "no results" message.                                                 *@
    @* ===================================================================== *@
    @if (Model.Any())
    {
        <div class="space-y-6">
            @foreach (var post in Model)
            {
                @* Post card — Tech Minimal style (sharp edges, border, no shadow) *@
                <article class="border border-zinc-800 bg-zinc-900/30 p-6 hover:border-zinc-700 transition-colors">
                    @* Post title — linked to detail page *@
                    <h2 class="text-xl font-semibold mb-2">
                        <a href="/yazi/@post.Slug" 
                           class="text-zinc-100 hover:text-accent transition-colors">
                            @post.Title
                        </a>
                    </h2>

                    @* Meta information row: category badge + creation date *@
                    <div class="flex items-center gap-3 mb-3">
                        @if (post.Category != null)
                        {
                            <a href="/kategori/@post.Category.Slug" 
                               class="font-mono text-xs text-zinc-400 bg-zinc-900 px-2 py-1 rounded-sm border border-zinc-800 hover:border-accent hover:text-accent transition-colors">
                                @post.Category.Name
                            </a>
                        }
                        <time class="font-mono text-xs text-zinc-500">
                            @post.CreatedDate.ToString("dd.MM.yyyy")
                        </time>
                    </div>

                    @* Post summary — short excerpt *@
                    <p class="text-zinc-400 text-sm leading-relaxed mb-4">
                        @post.Summary
                    </p>

                    @* Read more link *@
                    <a href="/yazi/@post.Slug" 
                       class="inline-block text-sm font-mono text-accent hover:text-accent-light transition-colors">
                        Devamını oku →
                    </a>
                </article>
            }
        </div>
    }
    else
    {
        @* No results message — displayed when search returns empty *@
        <div class="border border-zinc-800 rounded-sm p-12 text-center">
            <p class="text-zinc-500 font-mono text-sm mb-2">
                Arama kriterlerinize uygun yazı bulunamadı.
            </p>
            <p class="text-zinc-600 font-mono text-xs">
                Farklı anahtar kelimeler deneyin veya <a href="/" class="text-accent hover:text-accent-light transition-colors">ana sayfaya</a> dönün.
            </p>
        </div>
    }

    @* Navigation — back to home page *@
    <div class="mt-12 pt-6 border-t border-zinc-800">
        <a href="/" 
           class="inline-block px-4 py-2 text-sm font-mono font-medium border border-zinc-700 text-zinc-300 hover:border-accent hover:text-accent rounded-sm transition-colors">
            ← Ana Sayfaya Dön
        </a>
    </div>
</article>
