@* ============================================================================= *@
@* Home/Search.cshtml — Search Results View (Tech Minimal)                       *@
@* ============================================================================= *@

@using DevCoreBlog.Core.Entities
@using DevCoreBlog.Models.Public
@model IEnumerable<Post>

@{
    ViewData["Title"] = "Search Results";
    ViewData["TerminalPath"] = "search";
}

<div class="w-full max-w-5xl mx-auto">
    @* Page title with search query *@
    <div class="border-b-2 border-gray-900 dark:border-zinc-700 pb-3 mb-8">
        <h1 class="text-2xl font-mono font-black uppercase tracking-tight text-gray-900 dark:text-zinc-100 mb-2">
            Search Results
        </h1>
        @if (!string.IsNullOrEmpty(ViewBag.SearchQuery))
        {
            <p class="font-mono text-xs text-gray-600 dark:text-zinc-400 m-0">
                Search query: <span class="text-primary font-bold">"@ViewBag.SearchQuery"</span>
            </p>
        }
    </div>

    <p class="font-mono text-sm mb-6">@Model.Count() articles found</p>

    @* Search Results *@
    @if (Model.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
            @foreach (var item in Model)
            {
                <partial name="_PostCard" model="new PostCardModel(item, PostCardPresentation.Standard)" />
            }
        </div>
    }
    else
    {
        <partial name="_PublicEmptyState" model='"No articles found matching your search criteria."' />
        <a href="/" class="inline-block px-4 py-2 border-2 border-gray-900 dark:border-zinc-700 text-xs font-mono font-bold text-gray-900 dark:text-zinc-200 hover:bg-gray-900 hover:text-white dark:hover:bg-primary dark:hover:text-white no-underline">
            [ Back to Home ]
        </a>
    }
</div>
