@using DevCoreBlog.Models.Public
<section aria-labelledby="contact-title" class="w-full max-w-3xl border-2 border-gray-900 dark:border-zinc-700 bg-white dark:bg-[#121215] p-6 space-y-6">
    <h1 id="contact-title" class="text-3xl font-mono font-bold">İletişim</h1>
    <p class="leading-relaxed">@SiteIdentity.Name ile e-posta üzerinden iletişime geçebilir veya GitHub profilini ziyaret edebilirsiniz.</p>
    <p><span class="font-bold">E-posta:</span> <a href="mailto:@SiteIdentity.Email" class="text-primary underline break-all">@SiteIdentity.Email</a></p>
    <p><span class="font-bold">GitHub:</span> <a href="@SiteIdentity.GitHubUrl" class="text-primary underline break-all">github.com/CixxMemo</a></p>
    <p class="text-sm text-gray-600 dark:text-zinc-400">E-posta bağlantısı e-posta uygulamanızı açar. Bu sayfa üzerinden mesaj toplanmaz.</p>
</section>
