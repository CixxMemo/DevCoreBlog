@using DevCoreBlog.Models.Public
<section aria-labelledby="contact-title" class="w-full max-w-3xl border-2 border-gray-900 dark:border-zinc-700 bg-white dark:bg-[#121215] p-6 space-y-6">
    <h1 id="contact-title" class="text-3xl font-mono font-bold">Contact</h1>
    <p class="leading-relaxed">You can reach @SiteIdentity.Name by email or visit his GitHub profile.</p>
    <p><span class="font-bold">Email:</span> <a href="mailto:@SiteIdentity.Email" class="text-primary underline break-all">@SiteIdentity.Email</a></p>
    <p><span class="font-bold">GitHub:</span> <a href="@SiteIdentity.GitHubUrl" class="text-primary underline break-all">github.com/CixxMemo</a></p>
    <p class="text-sm text-gray-600 dark:text-zinc-400">The email link opens your email application. This page does not submit a message through DevCoreBlog.</p>
</section>
