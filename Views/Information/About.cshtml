@using DevCoreBlog.Models.Public
<section aria-labelledby="about-title" class="w-full max-w-3xl border-2 border-gray-900 dark:border-zinc-700 bg-white dark:bg-[#121215] p-6 space-y-6">
    <h1 id="about-title" class="text-3xl font-mono font-bold">About DevCoreBlog</h1>
    <h2 class="text-xl font-bold">@SiteIdentity.Name</h2>
    <p class="leading-relaxed">@SiteIdentity.Biography</p>
    <p><a href="@SiteIdentity.GitHubUrl" class="text-primary underline">Find me on GitHub</a></p>
    <p><a href="/contact" class="text-primary underline">Get in touch</a></p>
</section>
