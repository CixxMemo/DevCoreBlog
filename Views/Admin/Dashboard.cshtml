@* ============================================================================= *@
@* Admin/Dashboard.cshtml — Admin Dashboard View (Tech Minimal — Dark Zinc) *@
@* ============================================================================= *@
@* This is the admin panel's main page. It shows two metric cards that link *@
@* to the Category and Post management sections. Each card displays the total *@
@* count of categories or posts, passed from AdminController via ViewBag. *@
@* *@
@* Phase 2 (FIX): Zinc dark palette. Sharp bordered metric cards *@
@* (border border-zinc-800, bg-zinc-900/50, rounded-sm, p-5). *@
@* Buttons: border border-zinc-700 bg-zinc-900 hover:bg-zinc-800 font-mono. *@
@* ============================================================================= *@

@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="text-2xl font-bold tracking-tight mb-8 text-zinc-100 font-mono">
    Admin Paneli
</h1>

@* Dashboard cards row — two cards side by side on medium+ screens *@
<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-4">
    @* Category Management Card — shows total category count from ViewBag *@
    <div class="border border-zinc-800 bg-zinc-900/50 rounded-sm p-5">
        <h5 class="text-sm font-mono font-semibold text-zinc-400 uppercase tracking-wider mb-2">
            Kategori Yönetimi
        </h5>
        <p class="text-4xl font-bold text-zinc-100 mb-3 font-mono">@ViewBag.CategoryCount</p>
        <p class="text-sm text-zinc-400 mb-4">
            Blog yazılarınız için kategorileri ekleyin, düzenleyin veya silin.
        </p>
        <a href="/AdminCategory" 
           class="inline-block px-4 py-2 text-sm font-mono font-medium border border-zinc-700 bg-zinc-900 text-zinc-300 hover:bg-zinc-800 hover:text-zinc-100 rounded-sm transition-colors">
            Kategorilere Git →
        </a>
    </div>
    
    @* Post Management Card — shows total post count from ViewBag *@
    <div class="border border-zinc-800 bg-zinc-900/50 rounded-sm p-5">
        <h5 class="text-sm font-mono font-semibold text-zinc-400 uppercase tracking-wider mb-2">
            Yazı Yönetimi
        </h5>
        <p class="text-4xl font-bold text-zinc-100 mb-3 font-mono">@ViewBag.PostCount</p>
        <p class="text-sm text-zinc-400 mb-4">
            Blog yazılarınızı oluşturun, düzenleyin ve yayınlayın.
        </p>
        <a href="/AdminPost" 
           class="inline-block px-4 py-2 text-sm font-mono font-medium border border-zinc-700 bg-zinc-900 text-zinc-300 hover:bg-zinc-800 hover:text-zinc-100 rounded-sm transition-colors">
            Yazılara Git →
        </a>
    </div>
</div>
