@* ============================================================================= *@
@* Admin/Dashboard.cshtml — Admin Dashboard View *@
@* ============================================================================= *@
@* This is the admin panel's main page. It shows two Bootstrap cards that link *@
@* to the Category and Post management sections. *@
@* *@
@* In Phase 6 (step 6.2), this view will be updated to show total counts of *@
@* categories and posts on the dashboard cards. *@
@* ============================================================================= *@

@{
    ViewData["Title"] = "Dashboard";
}

<h1>Admin Paneli</h1>

@* Dashboard cards row — two cards side by side on medium+ screens *@
<div class="row mt-4">
    @* ---- Category Management Card ---- *@
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Kategori Yönetimi</h5>
                <p class="card-text">Blog yazılarınız için kategorileri ekleyin, düzenleyin veya silin.</p>
                @* Link to the category list page *@
                <a href="/AdminCategory" class="btn btn-primary">Kategorilere Git</a>
            </div>
        </div>
    </div>
    @* ---- Post Management Card ---- *@
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Yazı Yönetimi</h5>
                <p class="card-text">Blog yazılarınızı oluşturun, düzenleyin ve yayınlayın.</p>
                @* Link to the post list page *@
                <a href="/AdminPost" class="btn btn-primary">Yazılara Git</a>
            </div>
        </div>
    </div>
</div>
