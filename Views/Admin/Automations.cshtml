@* ============================================================================= *@
@* Admin/Automations.cshtml — Automations & Integration Documentation Hub        *@
@* ============================================================================= *@
@* This view serves as the interactive command documentation for:               *@
@*   1. Inbound Webhook Pipeline (n8n, Make.com, AI agents).                     *@
@*   2. Public Read-Only Portfolio Showcase API (React portfolio integration).   *@
@*   3. Live Category ID reference table and copyable cURL / JSON test snippets. *@
@* ============================================================================= *@

@model DevCoreBlog.Models.Admin.AutomationsViewModel

@{
    ViewData["Title"] = "Otomasyonlar ve API";
    var categories = Model.Categories;
    var corsOrigins = Model.CorsOrigins.Count == 0 ? "Yapılandırılmadı" : string.Join(",", Model.CorsOrigins);
    var defaultCategoryId = categories.FirstOrDefault()?.Id ?? 1;
}

<div class="space-y-8">
    
    @* ========================================================================= *@
    @* PAGE HEADER & STATUS PANEL                                                *@
    @* ========================================================================= *@
    <div class="border-2 border-black bg-white p-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="font-mono text-xs font-bold text-neutral-500 uppercase tracking-widest leading-tight">
                // DIŞ BAĞLANTILAR VE OTOMASYONLAR
            </div>
            <h1 class="text-2xl md:text-3xl font-black uppercase tracking-tight text-black mt-1">
                Otomasyonlar ve API
            </h1>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <span class="border-2 border-black bg-emerald-100 text-emerald-900 font-mono text-xs font-bold px-3 py-1 uppercase flex items-center gap-1.5">
                <span class="w-2 h-2 bg-emerald-600 inline-block"></span>
                <span>WEBHOOK ADRESİ</span>
            </span>
            <span class="border-2 border-black bg-neutral-100 font-mono text-xs font-bold px-3 py-1 uppercase text-neutral-700">
                İSTEK SINIRI VAR
            </span>
        </div>
    </div>

    @* ========================================================================= *@
    @* SECTION 1: INBOUND WEBHOOK (n8n, Make.com, AI Agents)                    *@
    @* ========================================================================= *@
    <div class="border-2 border-black bg-white">
        
        @* Card Header *@
        <div class="border-b-2 border-black p-4 md:p-5 bg-neutral-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div class="flex items-center gap-3">
                <span class="border-2 border-black bg-black text-white font-mono text-xs font-bold px-2 py-0.5 uppercase">
                    POST
                </span>
                <h2 class="text-lg font-black uppercase tracking-tight text-black">
                    Dışarıdan yazı kabul eden webhook
                </h2>
            </div>
            <span class="font-mono text-xs text-neutral-600">
                Varsayılan: 5 istek/dakika • JSON sınırı 2 MiB
            </span>
        </div>

        @* Card Body *@
        <div class="p-6 space-y-6">
            
            @* Endpoint Details Grid *@
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 font-mono text-xs">
                <div class="border border-black p-3 bg-neutral-50 space-y-1">
                    <span class="text-neutral-500 uppercase text-[10px] font-bold block">İSTEK ADRESİ:</span>
                    <strong class="text-black text-sm block">/api/webhooks/posts</strong>
                </div>

                <div class="border border-black p-3 bg-neutral-50 space-y-1">
                    <span class="text-neutral-500 uppercase text-[10px] font-bold block">ZORUNLU YETKİ BAŞLIĞI:</span>
                    <strong class="text-black text-sm block">X-DevCore-Secret</strong>
                </div>

                <div class="border border-black p-3 bg-neutral-50 space-y-1">
                    <span class="text-neutral-500 uppercase text-[10px] font-bold block">GÜVENLİK KARŞILAŞTIRMASI:</span>
                    <strong class="text-emerald-700 text-sm block">Sabit sürede bayt karşılaştırması</strong>
                </div>
            </div>

            @* Security & Behavior Bullet Points *@
            <div class="border-l-4 border-black bg-neutral-50 p-4 font-mono text-xs text-neutral-700 space-y-1">
                <p><strong>• Varsayılan taslak:</strong> <code>"isPublished": true</code> yalnız sunucuda şu ayar açıksa yayımlar: <code>ALLOW_WEBHOOK_PUBLISH=true</code>. Aksi durumda yazı taslak kalır.</p>
                <p><strong>• Otomatik oluşturma:</strong> Adres ve oluşturulma tarihi sunucuda üretilir. Markdown, yazı sayfasında güvenli gösterilir.</p>
                <p><strong>• Güvenli tekrarlar:</strong> Her yeni yazı için bir <code>Idempotency-Key</code> üretin ve aynı içerikle yapılan her tekrarda yeniden kullanın. 1–128 ASCII harfi, rakam, nokta, alt çizgi veya kısa çizgi kullanın. Aynı anahtar farklı alanlarla kullanılırsa dönen yanıt: <code>409 Conflict</code>.</p>
                <p><strong>• İstemci geçişi:</strong> Bu başlığı içermeyen mevcut istekler çalışır; yinelenen kayıt koruması sağlamaz. Başarılı anahtarlar yazı silinse de süresiz korunur. Başarısız istek anahtarı tüketmez; <code>429</code> veya <code>5xx</code> yanıtında aynı anahtarla, bekleme süresini artırarak tekrar deneyin.</p>
                <p><strong>• Gizli anahtarla yetkilendirme:</strong> <code>X-DevCore-Secret</code> değerini özel yapılandırmanızdan gönderin. Sunucu anahtarı sabit sürede karşılaştırır; yetkisiz isteği JSON okumadan reddeder.</p>
            </div>

            @* JSON Payload Template Box *@
            <div class="space-y-2">
                <div class="flex items-center justify-between font-mono text-xs">
                    <span class="font-bold uppercase text-neutral-600">// n8n / Make.com JSON istek şablonu:</span>
                    <button type="button" 
                            data-copy-snippet="webhook-payload-snippet"
                            class="border border-black bg-white hover:bg-black hover:text-white px-2.5 py-1 font-mono text-xs font-bold uppercase transition-none">
                        JSON kopyala
                    </button>
                </div>
                
                <pre id="webhook-payload-snippet" class="border-2 border-black bg-neutral-900 text-neutral-100 p-4 font-mono text-xs overflow-x-auto selection:bg-neutral-700">{
  "title": "Autonomous AI Workflows with .NET 10",
  "content": "## Introduction\n\nAutomated article body written in full Markdown with code blocks and links.\n\n```csharp\npublic void RunWorkflow() => Console.WriteLine(\"Automated\");\n```",
  "summary": "How automation pipelines prepare posts for DevCoreBlog.",
  "excerpt": "A deep dive into webhook integration pipelines.",
  "coverImageUrl": "https://res.cloudinary.com/demo/image/upload/sample.jpg",
  "categoryId": @defaultCategoryId,
  "isPublished": false
}</pre>
            </div>

            @* cURL Terminal Test Snippet *@
            <div class="space-y-2">
                <div class="flex items-center justify-between font-mono text-xs">
                    <span class="font-bold uppercase text-neutral-600">// cURL test komutu:</span>
                    <button type="button" 
                            data-copy-snippet="curl-snippet"
                            class="border border-black bg-white hover:bg-black hover:text-white px-2.5 py-1 font-mono text-xs font-bold uppercase transition-none">
                        cURL kopyala
                    </button>
                </div>

                <pre id="curl-snippet" class="border-2 border-black bg-neutral-900 text-emerald-400 p-4 font-mono text-xs overflow-x-auto whitespace-pre-wrap selection:bg-neutral-700">curl -X POST "@(Model.SiteUrl)/api/webhooks/posts" \
  -H "Content-Type: application/json" \
  -H "X-DevCore-Secret: YOUR_WEBHOOK_SECRET" \
  -H "Idempotency-Key: YOUR_UNIQUE_POST_KEY" \
  -d '{"title":"Test Post from cURL","content":"# Hello World\nTesting webhook ingestion.","categoryId":@defaultCategoryId,"isPublished":false}'</pre>
            </div>

            @* Category ID Reference Table *@
            <div class="space-y-2">
                <div class="font-mono text-xs font-bold uppercase text-neutral-600">
                    // Etkin kategori kimlikleri (categoryId alanı için):
                </div>

                @if (categories.Any())
                {
                    <div class="border border-black overflow-x-auto">
                        <table class="w-full text-left font-mono text-xs">
                            <thead class="bg-neutral-100 border-b border-black text-[10px] uppercase">
                                <tr>
                                    <th class="p-2.5">CategoryId</th>
                                    <th class="p-2.5">Kategori adı</th>
                                    <th class="p-2.5">Adres</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-neutral-200">
                                @foreach (var cat in categories)
                                {
                                    <tr class="hover:bg-neutral-50">
                                        <td class="p-2.5 font-bold text-black">@cat.Id</td>
                                        <td class="p-2.5 font-semibold">@cat.Name</td>
                                        <td class="p-2.5 text-neutral-500">/category/@cat.Slug</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 border border-black font-mono text-xs text-neutral-500">
                        Kategori bulunamadı. Webhook kullanmadan önce kategori oluşturun.
                    </div>
                }
            </div>
        </div>
    </div>

    @* ========================================================================= *@
    @* SECTION 2: PORTFOLIO SHOWCASE PUBLIC FEED (React Portfolio Integration)   *@
    @* ========================================================================= *@
    <div class="border-2 border-black bg-white">
        
        @* Card Header *@
        <div class="border-b-2 border-black p-4 md:p-5 bg-neutral-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div class="flex items-center gap-3">
                <span class="border-2 border-black bg-emerald-600 text-white font-mono text-xs font-bold px-2 py-0.5 uppercase">
                    GET
                </span>
                <h2 class="text-lg font-black uppercase tracking-tight text-black">
                    Portföy akışı (son 3 yazı)
                </h2>
            </div>
            <span class="font-mono text-xs text-neutral-600">
                En fazla 30 istek/dakika • Her istekte güncel veri
            </span>
        </div>

        @* Card Body *@
        <div class="p-6 space-y-6">
            
            @* Endpoint Details Grid *@
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 font-mono text-xs">
                <div class="border border-black p-3 bg-neutral-50 space-y-1">
                    <span class="text-neutral-500 uppercase text-[10px] font-bold block">İSTEK ADRESİ:</span>
                    <strong class="text-black text-sm block">/api/public/posts/latest</strong>
                </div>

                <div class="border border-black p-3 bg-neutral-50 space-y-1">
                    <span class="text-neutral-500 uppercase text-[10px] font-bold block">CORS İZİNLİ KAYNAKLAR:</span>
                    <strong class="text-black text-xs block truncate" title="@corsOrigins">@corsOrigins</strong>
                </div>

                <div class="border border-black p-3 bg-neutral-50 space-y-1">
                    <span class="text-neutral-500 uppercase text-[10px] font-bold block">YANIT İÇERİĞİ:</span>
                    <strong class="text-emerald-700 text-sm block">En fazla 3 görünür yazı dizisi</strong>
                </div>
            </div>

            <p class="font-mono text-xs text-neutral-700">Bu akış herkese açıktır. CORS, hangi tarayıcı kaynaklarının yanıtı okuyabildiğini belirler; kimlik doğrulamaz. Bağlantılar yapılandırılmış site adresini kullanır. Taslak, ileri tarihli ve etkin olmayan içerikler dışlanır; yanıtlar önbelleğe alınmaz.</p>

            @* React Code Snippet Box *@
            <div class="space-y-2">
                <div class="flex items-center justify-between font-mono text-xs">
                    <span class="font-bold uppercase text-neutral-600">// React / Next.js bağlantı örneği:</span>
                    <button type="button" 
                            data-copy-snippet="react-snippet"
                            class="border border-black bg-white hover:bg-black hover:text-white px-2.5 py-1 font-mono text-xs font-bold uppercase transition-none">
                        Kodu kopyala
                    </button>
                </div>

                <pre id="react-snippet" class="border-2 border-black bg-neutral-900 text-neutral-100 p-4 font-mono text-xs overflow-x-auto selection:bg-neutral-700">// In your React Portfolio Component:
async function getLatestArticles() {
  const res = await fetch("@(Model.SiteUrl)/api/public/posts/latest", {
    cache: 'no-store' // Recheck publication visibility on each request
  });
  
  if (!res.ok) throw new Error("Failed to fetch blog posts");
  return res.json();
}

// Response Schema (illustrative values):
// [
//   {
//     "id": 12,
//     "title": "Vibe Coding: The Future of Automation",
//     "slug": "vibe-coding-the-future-of-automation",
//     "summary": "How AI-assisted architectures accelerate freelance delivery.",
//     "excerpt": "A deep dive into vibe coding.",
//     "coverImageUrl": "https://res.cloudinary.com/...",
//     "publishDate": "2026-08-20T00:00:00Z",
//     "url": "@(Model.SiteUrl)/post/vibe-coding-the-future-of-automation",
//     "categoryName": "Vibe Coding"
//   }
// ]</pre>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/automation-copy.js" asp-append-version="true"></script>
}
