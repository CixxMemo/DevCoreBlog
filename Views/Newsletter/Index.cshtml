@model DevCoreBlog.Models.Public.NewsletterTeaserListModel
@inject DevCoreBlog.Services.Subscriptions.SubscriptionRegistrationAvailability RegistrationAvailability
@{ ViewData["Title"] = "Bülten"; }
<link rel="stylesheet" href="~/css/newsletter-teasers.css" asp-append-version="true" />
<section class="newsletter-teasers" aria-labelledby="newsletter-teaser-heading">
    <h1 id="newsletter-teaser-heading">Bülten</h1>
    <p>Yayımlanmış sayıların başlıkları ve kısa özetleri.</p>
    <p>Tam sayıları okumak için aktif aboneliğinizle <a href="/sign-in" class="font-bold underline">okuyucu girişi yapın</a>. Oturumunuz açıksa <a href="/bultenler" class="font-bold underline">bülten arşivine geçin</a>.</p>
    @if (!RegistrationAvailability.CanRegister) { <p>Abonelik başvuruları şu anda kapalı.</p> }
    <p><a href="/abone-ol" class="font-bold underline">Bültene abone ol</a></p>
    @if (Model.Result.Items.Count == 0)
    {
        <p class="public-empty-state">Henüz yayımlanmış bülten tanıtımı yok.</p>
    }
    @foreach (var item in Model.Result.Items)
    {
        <article class="newsletter-teaser">
            <h2>@item.Title</h2>
            @if (!string.IsNullOrWhiteSpace(item.Summary)) { <p>@item.Summary</p> }
        </article>
    }
    @if (Model.Page > 1 || Model.HasNext)
    {
        <nav aria-label="Bülten tanıtımı sayfaları">
            @if (Model.Page > 1) { <a asp-action="Index" asp-route-page="@(Model.Page - 1)">Önceki</a> }
            <span>Sayfa @Model.Page</span>
            @if (Model.HasNext) { <a asp-action="Index" asp-route-page="@(Model.Page + 1)">Sonraki</a> }
        </nav>
    }
</section>
