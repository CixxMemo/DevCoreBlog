@model DevCoreBlog.Models.Admin.DocumentPostFormInput
@{
    ViewData["Title"] = Model.IsNewsletter ? (Model.Id > 0 ? "Bülteni düzenle" : "Yeni bülten") : (Model.Id > 0 ? "Yazıyı düzenle" : "Yeni yazı");
}
<link rel="stylesheet" href="~/generated/tiptap/editor.css" asp-append-version="true" />
<partial name="~/Views/AdminWriting/_DocumentPostForm.cshtml" model="Model" />
@section Scripts {
    <script type="module" src="~/generated/tiptap/form.js" asp-append-version="true"></script>
}
