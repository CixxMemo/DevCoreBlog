@* ============================================================================= *@
@* _ViewStart.cshtml — Root View Layout Assignment *@
@* ============================================================================= *@
@* This file runs BEFORE every view in the Views/ folder (and subfolders). *@
@* It sets the default layout to "_Layout.cshtml" (the public site layout). *@
@* Admin views override this in their own _ViewStart.cshtml files. *@
@* ============================================================================= *@

@{
    @* Set the default layout for all views to the public site layout *@
    Layout = "_Layout";
}
