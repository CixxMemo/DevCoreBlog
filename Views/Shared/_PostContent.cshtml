@model string
@inject DevCoreBlog.Services.Interfaces.ISafeMarkdownRenderer MarkdownRenderer
@* Detail and private preview share the same trusted render boundary and typography. *@
<div class="markdown-content text-gray-800 dark:text-zinc-200 leading-relaxed text-base min-w-0 overflow-x-auto">
    @Html.Raw(MarkdownRenderer.ToSafeHtml(Model))
</div>
