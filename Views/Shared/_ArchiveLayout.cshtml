@{ Layout = null; }
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <title>@ViewData["Title"] — Aether Letter</title>
    <link rel="stylesheet" href="~/generated/tailwind-public.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/newsletter-archive.css" asp-append-version="true" />
</head>
<body class="archive-page">
    <a href="#archive-content" class="archive-skip">İçeriğe geç</a>
    <header class="archive-header">
        <a href="/" class="font-mono font-bold">Aether Letter</a>
        <nav aria-label="Okuyucu gezinmesi">
            <a href="/bultenler">Bülten arşivi</a>
            <a href="/abonelik/oturum">Oturum</a>
        </nav>
        <form action="/abonelik/oturumu-kapat" method="post">
            @Html.AntiForgeryToken()
            <button type="submit">Bu cihazdaki oturumu kapat</button>
        </form>
    </header>
    <main id="archive-content" tabindex="-1">@RenderBody()</main>
</body>
</html>
