@* ============================================================================= *@
@* _Layout.cshtml — Public Site Master Layout (Hybrid CLI & Bento UI)           *@
@* ============================================================================= *@
@* This is the main layout template for the public-facing (visitor) pages.      *@
@* It defines the Bento Grid structure:                                         *@
@*   - TOPBAR: Terminal-style prompt breadcrumb ([devcore@system] ~/path $▌)    *@
@*   - SIDEBAR: Left panel for shortcut cards (populated in Phase 2)            *@
@*   - CONTENT: Main content area where @RenderBody() renders                   *@
@*   - FOOTER: Simple copyright bar                                             *@
@*                                                                              *@
@* Design System: "Modern Terminal" palette                                     *@
@*   - Background: Deep Charcoal #0d1117 (GitHub Dark)                          *@
@*   - Cards: #161b22 with 1px #30363d borders                                  *@
@*   - Accent: Terminal Orange #FF8C00, Cyber Yellow #FFD700                     *@
@*   - Fonts: JetBrains Mono (headers/UI), Inter (body text)                    *@
@*   - Shape: Sharp edges (0-4px radius), solid 1px borders                     *@
@*                                                                              *@
@* The layout injects ApplicationDbContext to dynamically load categories       *@
@* for the sidebar and mobile navigation.                                       *@
@* ============================================================================= *@

@* Inject the database context to access categories for navigation *@
@inject DevCoreBlog.Data.ApplicationDbContext DbContext

<!DOCTYPE html>
<html lang="tr">
<head>
    <script>
        // Apply dark mode immediately to prevent flash of light theme
        // Since terminal theme is dark-first, we default to dark
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DevCoreBlog</title>
    
    @* ============================================================================= *@
    @* DYNAMIC SEO — Open Graph (OG) Meta Tags                                       *@
    @* ============================================================================= *@
    @* These meta tags are used by social media platforms (Facebook, Twitter,        *@
    @* LinkedIn, etc.) to display rich previews when a page is shared.               *@
    @*                                                                              *@
    @* The values are set dynamically via ViewBag in each controller action:         *@
    @*   - ViewBag.OgTitle: Custom title for the page (defaults to ViewData.Title)   *@
    @*   - ViewBag.OgDescription: Short description (defaults to site description)   *@
    @*   - ViewBag.OgUrl: Canonical URL of the page (defaults to current URL)        *@
    @*   - ViewBag.OgType: Type of content (article, website, etc.)                  *@
    @*                                                                              *@
    @* If ViewBag values are not set, fallback values are used.                      *@
    @* ============================================================================= *@
    <meta property="og:title" content="@(ViewBag.OgTitle ?? ViewData["Title"])" />
    <meta property="og:description" content="@(ViewBag.OgDescription ?? "DevCoreBlog - ASP.NET Core, C#, ve modern web geliştirme hakkında teknik yazılar")" />
    <meta property="og:type" content="@(ViewBag.OgType ?? "website")" />
    <meta property="og:url" content="@(ViewBag.OgUrl ?? Context.Request.Path)" />
    <meta property="og:site_name" content="DevCoreBlog" />
    
    @* Twitter Card meta tags (similar to OG but for Twitter) *@
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@(ViewBag.OgTitle ?? ViewData["Title"])" />
    <meta name="twitter:description" content="@(ViewBag.OgDescription ?? "DevCoreBlog - ASP.NET Core, C#, ve modern web geliştirme hakkında teknik yazılar")" />
    
    @* ============================================================================= *@
    @* Google Fonts — JetBrains Mono (UI/Headers) + Inter (Body Text)                *@
    @* ============================================================================= *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    
    @* ============================================================================= *@
    @* Tailwind CSS Play CDN — INLINE config (Terminal Theme palette)                 *@
    @* ============================================================================= *@
    @* The Play CDN requires config to be INLINE in a <script> tag, NOT an external *@
    @* file. The config must be set before the CDN script processes the DOM.         *@
    @* ============================================================================= *@
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'sans-serif'],
                        mono: ['JetBrains Mono', 'ui-monospace', 'SFMono-Regular', 'Menlo', 'Monaco', 'Consolas', 'monospace'],
                    },
                    colors: {
                        // Terminal Orange/Yellow — primary accent for interactive elements
                        accent: {
                            DEFAULT: '#f97316', // orange-500
                            light: '#facc15',   // yellow-400
                            dark: '#ea580c',    // orange-600
                        },
                        // GitHub Dark palette — background surfaces
                        surface: {
                            primary: '#0d1117',
                            card: '#161b22',
                            elevated: '#1c2128',
                        },
                        // Terminal border color
                        terminal: {
                            border: '#30363d',
                            text: '#E6EDF3',
                            muted: '#8b949e',
                            dim: '#484f58',
                        },
                    },
                },
            },
        }
    </script>
    
    @* ============================================================================= *@
    @* CSS Files — Terminal theme (new) + site styles (existing)                      *@
    @* ============================================================================= *@
    @* terminal-theme.css: Grid layout, topbar, sidebar, CSS variables               *@
    @* site.css: Markdown content styling, animations, Prism.js overrides            *@
    @* ============================================================================= *@
    <link rel="stylesheet" href="~/css/terminal-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @* ============================================================================= *@
    @* Prism.js — Syntax Highlighting for Code Blocks (Tomorrow Night theme)         *@
    @* ============================================================================= *@
    @* Prism.js highlights <code> blocks that have a "language-*" class.            *@
    @* Markdig generates these classes automatically from Markdown fenced code       *@
    @* blocks (e.g., ```csharp → <code class="language-csharp">).                   *@
    @*                                                                              *@
    @* "Tomorrow Night" theme matches the terminal dark palette:                    *@
    @*   - Dark background (#1d1f21) with light text (#c5c8c6)                     *@
    @*   - Sharp, monospaced code rendering                                         *@
    @*   - No rounded corners, no glassmorphism                                     *@
    @*                                                                              *@
    @* Components loaded:                                                           *@
    @*   - prism-core: The engine that parses and highlights code                   *@
    @*   - prism-autoloader: Auto-loads language grammars on demand                 *@
    @*   - prism-show-language: Displays the language label on each code block      *@
    @* ============================================================================= *@
    <link href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.30.0/themes/prism-tomorrow.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.30.0/plugins/show-language/prism-show-language.min.css" rel="stylesheet" />
</head>
<body class="m-0 p-0 bg-[#0d1117] text-[#E6EDF3] font-sans antialiased overflow-x-hidden">
    @* ============================================================================= *@
    @* BENTO GRID WRAPPER — Contains all page areas in a CSS Grid layout             *@
    @* ============================================================================= *@
    <div class="site-grid max-w-[1440px] mx-auto w-full border-x border-[#30363d]">
    
        @* ============================================================================= *@
        @* TOPBAR — Terminal-style Prompt Header                                         *@
        @* ============================================================================= *@
        @* Displays a terminal prompt as a dynamic breadcrumb.                           *@
        @* The path changes based on which page the user is on:                          *@
        @*   Home    → ~/posts                                                           *@
        @*   Detail  → ~/posts/slug                                                       *@
        @*   Category→ ~/kategori/slug                                                    *@
        @*   Search  → ~/ara                                                              *@
        @* ============================================================================= *@
        <header class="site-topbar">
            @* Central Command Line (Top Bar) *@
            <div class="topbar-central-cli">
                <span class="cli-prompt">devcore:~$</span>
                <input id="central-cli-input" type="text" autocomplete="off" spellcheck="false"
                       placeholder="Aramak için kelime veya komut girin... (Ctrl+K)" />
            </div>

            @* Right side: Actions (dark mode toggle + mobile menu) *@
            <div class="topbar-actions">
                @* Dark Mode Toggle Button *@
                <button id="theme-toggle" type="button" aria-label="Toggle Dark Mode">
                    <svg id="theme-toggle-dark-icon" class="w-5 h-5 hidden" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
                    </svg>
                    <svg id="theme-toggle-light-icon" class="w-5 h-5 hidden" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4.22 4.22a1 1 0 011.415 0l.884.884a1 1 0 01-1.414 1.415l-.884-.884a1 1 0 010-1.415zM10 6a4 4 0 100 8 4 4 0 000-8zm-4.22 8.22a1 1 0 01-1.415 0l-.884-.884a1 1 0 011.414-1.415l.884.884a1 1 0 010 1.415zM2 10a1 1 0 011-1h1a1 1 0 110 2H3a1 1 0 01-1-1zm15 0a1 1 0 011-1h1a1 1 0 110 2h-1a1 1 0 01-1-1zM4.22 4.22a1 1 0 010 1.415l-.884.884a1 1 0 01-1.414-1.415l.884-.884a1 1 0 011.415 0zM15.78 15.78a1 1 0 010 1.415l-.884.884a1 1 0 01-1.414-1.415l.884-.884a1 1 0 011.415 0z"></path>
                    </svg>
                </button>

                @* Mobile hamburger menu button (visible on small screens) *@
                <button id="mobile-menu-button" type="button" class="sm:hidden" aria-label="Toggle mobile menu">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
            </div>
        </header>

        @* ============================================================================= *@
        @* MOBILE NAVIGATION — Slide-down panel (hidden by default)                      *@
        @* ============================================================================= *@
        @* On mobile, this panel slides down below the topbar with navigation links,     *@
        @* categories, and a search form. Toggled by the hamburger button.               *@
        @* ============================================================================= *@
        <div id="mobile-menu" class="mobile-nav">
            <a href="/">~/home</a>
            
            @* Mobile search form *@
            <div style="padding: 0.5rem 0;">
                <form action="/ara" method="get">
                    <input type="text" name="query" 
                           placeholder="$ grep ..." 
                           style="width: 100%; background: var(--bg-surface); border: 1px solid var(--border); color: var(--text-primary); font-family: var(--font-mono); font-size: 0.75rem; padding: 0.5rem 0.75rem; outline: none;" />
                </form>
            </div>
            
            <div class="mobile-nav-label">Kategoriler</div>
            @foreach (var cat in DbContext.Categories.ToList())
            {
                <a href="/kategori/@cat.Slug">@cat.Name</a>
            }
        </div>

        @* ============================================================================= *@
        @* SIDEBAR — Left Panel with Interactive Shortcut Cards (Phase 2)                 *@
        @* ============================================================================= *@
        @* The sidebar contains actionable "Cards" grouped by function:                   *@
        @*   1. Quick Actions: Home, Latest Post shortcuts                                *@
        @*   2. Search: Terminal grep-style search input                                  *@
        @*   3. Categories: Dynamic category list from database                           *@
        @*   4. Links: External links (GitHub, etc.)                                      *@
        @*                                                                                *@
        @* Each card: 1px solid #30363d border.                                           *@
        @* On hover: border glows #FF8C00, text turns #FFD700.                            *@
        @* ============================================================================= *@
        <aside class="site-sidebar">

            @* Logo Area *@
            <div class="sidebar-logo">
                <a href="/">
                    <span class="logo-text">devcore</span><span class="logo-cursor">_</span>
                </a>
            </div>

            @* Navigation Links *@
            <div class="sidebar-nav" style="margin-bottom: 1rem;">
                <a href="/" class="sidebar-nav-link">
                    <span class="nav-icon">~/</span> Ana Sayfa
                </a>
            </div>

            @* ── Card 1: Categories ── *@
            @* Dynamic category list loaded from the database *@
            <div class="sidebar-card">
                <div class="sidebar-card-header">
                    <span class="sidebar-card-icon">[#]</span> Kategoriler
                </div>
                <div class="sidebar-card-body">
                    @foreach (var cat in DbContext.Categories.ToList())
                    {
                        <a href="/kategori/@cat.Slug" class="sidebar-link">
                            <span class="sidebar-link-icon">›</span> @cat.Name
                        </a>
                    }
                </div>
            </div>

            @* ── Card 4: Links ── *@
            @* External links — GitHub, social profiles, etc. *@
            <div class="sidebar-card">
                <div class="sidebar-card-header">
                    <span class="sidebar-card-icon">🔗</span> Links
                </div>
                <div class="sidebar-card-body">
                    <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="sidebar-link">
                        <span class="sidebar-link-icon">↗</span> GitHub
                    </a>
                    <a href="#" class="sidebar-link">
                        <span class="sidebar-link-icon">›</span> ./portfolio.sh
                    </a>
                </div>
            </div>

        </aside>

        @* ============================================================================= *@
        @* MAIN CONTENT — Blog posts, articles, and page content render here             *@
        @* ============================================================================= *@
        <main class="site-content">
            @RenderBody()
        </main>

        @* ============================================================================= *@
        @* FOOTER                                                                        *@
        @* ============================================================================= *@
        <footer class="site-footer">
            <p>&copy; @DateTime.Now.Year - DevCoreBlog. All rights reserved.</p>
        </footer>
    </div>

    @* ============================================================================= *@
    @* COMMAND PALETTE MODAL — Hidden overlay triggered by `/` or `Ctrl+K`            *@
    @* ============================================================================= *@
    @* This modal sits outside the grid wrapper (fixed position).                     *@
    @* When opened, it shows a large input + filtered command list.                   *@
    @* Design: Solid dark bg + orange border (NO glassmorphism per AGENTS.md).        *@
    @* ============================================================================= *@
    <div id="cmd-palette-overlay" class="cmd-palette-overlay">
        <div id="cmd-palette-modal" class="cmd-palette-modal">
            @* Command input — monospace, large, with placeholder *@
            <input id="cmd-palette-input" 
                   class="cmd-palette-input" 
                   type="text" 
                   placeholder="Bir komut yazın... (/home, /grep, /focus)" 
                   autocomplete="off" 
                   spellcheck="false" />
            
            @* Filtered results list — populated by JavaScript *@
            <div id="cmd-palette-results" class="cmd-palette-results">
                @* Results are dynamically rendered by command-palette.js *@
            </div>

            @* Footer — keyboard shortcut hints *@
            <div class="cmd-palette-footer">
                <span>
                    <span class="cmd-kbd">↑↓</span> gezin
                    <span class="cmd-kbd">↵</span> çalıştır
                    <span class="cmd-kbd">esc</span> kapat
                </span>
                <span>DevCoreBlog Terminal</span>
            </div>
        </div>
    </div>

    @* ============================================================================= *@
    @* JavaScript — Mobile menu toggle + Dark mode toggle                             *@
    @* ============================================================================= *@
    <script>
        // Mobile menu toggle — show/hide the mobile navigation panel
        document.getElementById('mobile-menu-button').addEventListener('click', function() {
            document.getElementById('mobile-menu').classList.toggle('is-open');
        });

        // Theme toggle logic — switch between dark and light mode
        var themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
        var themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');

        // Show the correct icon based on current theme
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            themeToggleLightIcon.classList.remove('hidden');
        } else {
            themeToggleDarkIcon.classList.remove('hidden');
        }

        // Toggle button click handler
        var themeToggleBtn = document.getElementById('theme-toggle');
        themeToggleBtn.addEventListener('click', function() {
            themeToggleDarkIcon.classList.toggle('hidden');
            themeToggleLightIcon.classList.toggle('hidden');

            if (localStorage.getItem('theme')) {
                if (localStorage.getItem('theme') === 'light') {
                    document.documentElement.classList.add('dark');
                    localStorage.setItem('theme', 'dark');
                } else {
                    document.documentElement.classList.remove('dark');
                    localStorage.setItem('theme', 'light');
                }
            } else {
                if (document.documentElement.classList.contains('dark')) {
                    document.documentElement.classList.remove('dark');
                    localStorage.setItem('theme', 'light');
                } else {
                    document.documentElement.classList.add('dark');
                    localStorage.setItem('theme', 'dark');
                }
            }
        });
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @* Command Palette — Keyboard shortcuts and command execution *@
    <script src="~/js/command-palette.js" asp-append-version="true"></script>
    @* Terminal Logic (Phase 3) *@
    <script src="~/js/terminal.js" asp-append-version="true"></script>

    @* ============================================================================= *@
    @* Prism.js — Syntax Highlighting Scripts                                        *@
    @* ============================================================================= *@
    @* prism-core: The main engine that walks the DOM and highlights <code> blocks.  *@
    @* prism-autoloader: Detects the "language-*" class and loads the grammar file   *@
    @*   on demand (e.g., prism-csharp.min.js). This avoids loading all languages.   *@
    @* prism-show-language: Adds a small "C#" / "Python" label to each code block    *@
    @*   so readers know which language they are looking at.                         *@
    @* ============================================================================= *@
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.30.0/components/prism-core.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.30.0/plugins/autoloader/prism-autoloader.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.30.0/plugins/show-language/prism-show-language.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
