@* ============================================================================= *@
@* _Layout.cshtml — Public Site Master Layout (Tech Minimal)                    *@
@* ============================================================================= *@
@* This is the main layout template for the public-facing (visitor) pages.      *@
@* Structure:                                                                   *@
@*   - TOPBAR: Logo, Search, Theme Toggle (built in Faz 2)                     *@
@*   - SIDEBAR: Category navigation (built in Faz 2)                           *@
@*   - CONTENT: Main content area where @RenderBody() renders                   *@
@*   - FOOTER: Copyright + social links (built in Faz 2)                       *@
@*                                                                              *@
@* Design System: "Tech Minimal" palette                                       *@
@*   - Light: White bg, dark text, orange/yellow accents                       *@
@*   - Dark: Near-black bg, light text, same accents                           *@
@*   - Fonts: JetBrains Mono (headers/UI), Inter (body text)                   *@
@*   - Shape: Sharp edges (0px radius), solid 1px borders                      *@
@*                                                                              *@
@* The layout injects ApplicationDbContext to dynamically load categories       *@
@* for the sidebar and mobile navigation.                                       *@
@* ============================================================================= *@

@* Inject the database context to access categories for navigation *@
@inject DevCoreBlog.Data.ApplicationDbContext DbContext

<!DOCTYPE html>
<html lang="tr">
<head>
    <script>
        // Apply dark mode immediately to prevent flash of wrong theme
        // Respects user preference from localStorage, falls back to system preference
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DevCoreBlog</title>
    
    @* ============================================================================= *@
    @* DYNAMIC SEO — Open Graph (OG) Meta Tags                                       *@
    @* ============================================================================= *@
    @* These meta tags are used by social media platforms (Facebook, Twitter,        *@
    @* LinkedIn, etc.) to display rich previews when a page is shared.               *@
    @*                                                                              *@
    @* The values are set dynamically via ViewBag in each controller action:         *@
    @*   - ViewBag.OgTitle: Custom title for the page (defaults to ViewData.Title)   *@
    @*   - ViewBag.OgDescription: Short description (defaults to site description)   *@
    @*   - ViewBag.OgUrl: Canonical URL of the page (defaults to current URL)        *@
    @*   - ViewBag.OgType: Type of content (article, website, etc.)                  *@
    @*                                                                              *@
    @* If ViewBag values are not set, fallback values are used.                      *@
    @* ============================================================================= *@
    <meta property="og:title" content="@(ViewBag.OgTitle ?? ViewData["Title"])" />
    <meta property="og:description" content="@(ViewBag.OgDescription ?? "DevCoreBlog - ASP.NET Core, C#, ve modern web geliştirme hakkında teknik yazılar")" />
    <meta property="og:type" content="@(ViewBag.OgType ?? "website")" />
    <meta property="og:url" content="@(ViewBag.OgUrl ?? Context.Request.Path)" />
    <meta property="og:site_name" content="DevCoreBlog" />
    
    @* Twitter Card meta tags (similar to OG but for Twitter) *@
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@(ViewBag.OgTitle ?? ViewData["Title"])" />
    <meta name="twitter:description" content="@(ViewBag.OgDescription ?? "DevCoreBlog - ASP.NET Core, C#, ve modern web geliştirme hakkında teknik yazılar")" />
    
    @* ============================================================================= *@
    @* Google Fonts — JetBrains Mono (UI/Headers) + Inter (Body Text)                *@
    @* ============================================================================= *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    
    @* ============================================================================= *@
    @* Tailwind CSS Play CDN — INLINE config (Tech Minimal palette)                  *@
    @* ============================================================================= *@
    @* The Play CDN requires config to be INLINE in a <script> tag, NOT an external *@
    @* file. The config must be set before the CDN script processes the DOM.         *@
    @* ============================================================================= *@
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            // Dark mode via 'dark' class on <html> — toggled by JS and system preference
            darkMode: 'class',
            theme: {
                extend: {
                    // Typography — Inter for body, JetBrains Mono for code/UI
                    fontFamily: {
                        sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'sans-serif'],
                        mono: ['JetBrains Mono', 'ui-monospace', 'SFMono-Regular', 'Menlo', 'Monaco', 'Consolas', 'monospace'],
                    },
                    // Tech Minimal Color Palette — orange/yellow accents on neutral base
                    colors: {
                        accent: {
                            DEFAULT: '#f97316', // Orange-500 — primary interactive color
                            light: '#facc15',   // Yellow-400 — hover/highlight
                            dark: '#ea580c',    // Orange-600 — pressed/active
                        },
                        surface: {
                            light: '#ffffff',   // Light mode background
                            dark: '#0a0a0a',    // Dark mode background
                        },
                        border: {
                            light: '#e5e5e5',   // Light mode borders
                            dark: '#262626',    // Dark mode borders
                        },
                    },
                    // Sharp edges — Tech Minimal has NO rounded corners
                    borderRadius: {
                        'none': '0',
                        'sm': '0',
                        'DEFAULT': '0',
                        'md': '0',
                        'lg': '0',
                    },
                },
            },
        }
    </script>
    
    @* ============================================================================= *@
    @* CSS Files — Site styles                                                        *@
    @* ============================================================================= *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @* ============================================================================= *@
    @* Prism.js — Syntax Highlighting for Code Blocks (Tomorrow Night theme)         *@
    @* ============================================================================= *@
    @* Prism.js highlights <code> blocks that have a "language-*" class.            *@
    @* Markdig generates these classes automatically from Markdown fenced code       *@
    @* blocks (e.g., ```csharp → <code class="language-csharp">).                   *@
    @*                                                                              *@
    @* "Tomorrow Night" theme matches the terminal dark palette:                    *@
    @*   - Dark background (#1d1f21) with light text (#c5c8c6)                     *@
    @*   - Sharp, monospaced code rendering                                         *@
    @*   - No rounded corners, no glassmorphism                                     *@
    @*                                                                              *@
    @* Components loaded:                                                           *@
    @*   - prism-core: The engine that parses and highlights code                   *@
    @*   - prism-autoloader: Auto-loads language grammars on demand                 *@
    @*   - prism-show-language: Displays the language label on each code block      *@
    @* ============================================================================= *@
    <link href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.30.0/themes/prism-tomorrow.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.30.0/plugins/show-language/prism-show-language.min.css" rel="stylesheet" />
</head>
<body class="m-0 p-0 font-sans antialiased overflow-x-hidden" style="background-color: var(--bg-primary); color: var(--text-primary);">
    @* ============================================================================= *@
    @* SITE WRAPPER — Max-width container for all page content                       *@
    @* ============================================================================= *@
    <div class="site-wrapper max-w-[1440px] mx-auto w-full min-h-screen flex flex-col">
    
        @* ============================================================================= *@
        @* TOPBAR — Site navigation bar (Tech Minimal)                                   *@
        @* ============================================================================= *@
        @* Structure: [Logo] — [Search] — [Login + Theme Toggle + Mobile Menu]           *@
        @* Design: Sticky, full-width, sharp bottom border, no shadows                  *@
        @* ============================================================================= *@
        <header id="site-topbar" class="sticky top-0 z-50 w-full" style="background-color: var(--bg-primary); border-bottom: 1px solid var(--border);">
            <div class="flex items-center justify-between px-4 sm:px-6 h-14 max-w-[1440px] mx-auto">

                @* === LEFT: Logo/Banner === *@
                @* Monospace font, orange accent color, sharp and clean *@
                <a href="/" class="flex items-center gap-2 no-underline flex-shrink-0" style="text-decoration: none;">
                    <span class="font-mono font-bold text-xl tracking-tight" style="color: var(--accent);">DevCore</span>
                    <span class="font-mono font-bold text-xl tracking-tight" style="color: var(--text-primary);">Blog</span>
                </a>

                @* === CENTER: Search Input === *@
                @* Sharp edges, orange border on focus, hidden on mobile (shown in mobile menu) *@
                @if (ViewData["HideSearch"] as bool? != true)
                {
                    <div class="hidden sm:block flex-grow max-w-md mx-4 lg:mx-8">
                        <form action="/ara" method="get" class="w-full">
                            <input id="topbar-search" type="text" name="query" 
                                   placeholder="Yazılarda ara..." 
                                   autocomplete="off"
                                   class="w-full text-sm font-sans outline-none transition-colors"
                                   style="background-color: var(--bg-surface); border: 1px solid var(--border); color: var(--text-primary); padding: 0.5rem 0.75rem;"
                                   onfocus="this.style.borderColor='var(--accent)'" 
                                   onblur="this.style.borderColor='var(--border)'" />
                        </form>
                    </div>
                }
                else
                {
                    <div class="hidden sm:block flex-grow max-w-md mx-4 lg:mx-8"></div>
                }
                @* === RIGHT: Login + Theme Toggle + Mobile Menu === *@
                <div class="flex items-center gap-2 sm:gap-3">
                    @* Login Button — sharp edges, orange border, Tech Minimal *@
                    <a href="/Account/Login" 
                       class="hidden sm:inline-flex items-center text-xs font-mono font-medium px-3 py-1.5 transition-colors"
                       style="border: 1px solid var(--accent); color: var(--accent); text-decoration: none;"
                       onmouseenter="this.style.backgroundColor='var(--accent)'; this.style.color='#fff';"
                       onmouseleave="this.style.backgroundColor='transparent'; this.style.color='var(--accent)';">
                        Giriş Yap
                    </a>

                    @* Separator — thin vertical line between login and toggle *@
                    <span class="hidden sm:block w-px h-5" style="background-color: var(--border);"></span>

                    @* Dark Mode Toggle Button (Güneş/Ay) *@
                    <button id="theme-toggle" type="button" aria-label="Toggle Dark Mode" class="p-1 cursor-pointer" style="background: none; border: none; color: var(--text-secondary);">
                        <svg id="theme-toggle-dark-icon" class="w-5 h-5 hidden" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
                        </svg>
                        <svg id="theme-toggle-light-icon" class="w-5 h-5 hidden" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4.22 4.22a1 1 0 011.415 0l.884.884a1 1 0 01-1.414 1.415l-.884-.884a1 1 0 010-1.415zM10 6a4 4 0 100 8 4 4 0 000-8zm-4.22 8.22a1 1 0 01-1.415 0l-.884-.884a1 1 0 011.414-1.415l.884.884a1 1 0 010 1.415zM2 10a1 1 0 011-1h1a1 1 0 110 2H3a1 1 0 01-1-1zm15 0a1 1 0 011-1h1a1 1 0 110 2h-1a1 1 0 01-1-1zM4.22 4.22a1 1 0 010 1.415l-.884.884a1 1 0 01-1.414-1.415l.884-.884a1 1 0 011.415 0zM15.78 15.78a1 1 0 010 1.415l-.884.884a1 1 0 01-1.414-1.415l.884-.884a1 1 0 011.415 0z"></path>
                        </svg>
                    </button>

                    @* Mobile hamburger menu button (visible on small screens only) *@
                    <button id="mobile-menu-button" type="button" class="sm:hidden p-1 cursor-pointer" aria-label="Toggle mobile menu" style="background: none; border: none; color: var(--text-secondary);">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>

            </div>
        </header>

        @* ============================================================================= *@
        @* MOBILE NAVIGATION — Slide-down panel (hidden by default)                      *@
        @* Will be restyled in Faz 2. Keeping functional for now.                        *@
        @* ============================================================================= *@
        <div id="mobile-menu" style="display: none; background-color: var(--bg-card); border-bottom: 1px solid var(--border); padding: 1rem 1.5rem;">
            <a href="/" style="display: block; padding: 0.5rem 0; color: var(--text-secondary); font-family: var(--font-mono); font-size: 0.875rem; text-decoration: none;">Ana Sayfa</a>
            
            @* Mobile search form *@
            <div style="padding: 0.5rem 0;">
                <form action="/ara" method="get">
                    <input type="text" name="query" 
                           placeholder="Ara..." 
                           style="width: 100%; background: var(--bg-surface); border: 1px solid var(--border); color: var(--text-primary); font-family: var(--font-sans); font-size: 0.875rem; padding: 0.5rem 0.75rem; outline: none;" />
                </form>
            </div>
            
            <div style="font-size: 0.625rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); margin-top: 0.75rem; margin-bottom: 0.25rem; font-family: var(--font-mono);">Kategoriler</div>
            @foreach (var cat in DbContext.Categories.ToList())
            {
                <a href="/kategori/@cat.Slug" style="display: block; padding: 0.5rem 0; color: var(--text-secondary); font-family: var(--font-mono); font-size: 0.875rem; text-decoration: none;">@cat.Name</a>
            }
        </div>

        @* ============================================================================= *@
        @* CONTENT AREA — Sidebar + Main Content in a grid layout                        *@
        @* ============================================================================= *@
        @* Desktop: [Sidebar 240px] [Main Content flex-grow]                             *@
        @* Mobile: Sidebar hidden, Main Content full-width                               *@
        @* ============================================================================= *@
        <div class="flex flex-grow w-full max-w-[1440px] mx-auto">

            @* ================================================================= *@
            @* SIDEBAR — Left category navigation (hidden on mobile)             *@
            @* ================================================================= *@
            @* Tech Minimal: sharp edges, 1px borders, no rounded corners        *@
            @* Hover: orange border + orange text                                *@
            @* ================================================================= *@
            @if (ViewData["HideSidebar"] as bool? != true)
            {
                <aside class="hidden md:block flex-shrink-0 w-60" style="background-color: var(--bg-card); border-right: 1px solid var(--border);">
                <nav class="p-4" style="position: sticky; top: 3.5rem;">

                    @* Home Link *@
                    <a href="/" class="flex items-center gap-2 px-3 py-2 mb-1 text-sm font-mono transition-colors"
                       style="color: var(--text-primary); text-decoration: none; border: 1px solid transparent;"
                       onmouseenter="this.style.borderColor='var(--accent)'; this.style.color='var(--accent)';"
                       onmouseleave="this.style.borderColor='transparent'; this.style.color='var(--text-primary)';">
                        <span style="color: var(--accent);">›</span> Ana Sayfa
                    </a>

                    @* Category Section Label *@
                    <div class="mt-4 mb-2 px-3" style="font-size: 0.625rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); font-family: var(--font-mono);">
                        Kategoriler
                    </div>

                    @* Category Links — loaded from database *@
                    @foreach (var cat in DbContext.Categories.ToList())
                    {
                        <a href="/kategori/@cat.Slug" 
                           class="flex items-center gap-2 px-3 py-2 mb-1 text-sm font-mono transition-colors"
                           style="color: var(--text-secondary); text-decoration: none; border: 1px solid transparent;"
                           onmouseenter="this.style.borderColor='var(--accent)'; this.style.color='var(--accent)';"
                           onmouseleave="this.style.borderColor='transparent'; this.style.color='var(--text-secondary)';">
                            <span style="color: var(--text-muted);">›</span> @cat.Name
                        </a>
                    }
                </nav>
            </aside>
            }

            @* ================================================================= *@
            @* MAIN CONTENT — Blog posts, articles, and page content             *@
            @* ================================================================= *@
            <main class="flex-grow min-w-0" style="padding: 2rem 1.5rem;">
                <div class="max-w-[900px] mx-auto w-full">
                    @RenderBody()
                </div>
            </main>

        </div>

        @* ============================================================================= *@
        @* FOOTER — Social links + Copyright                                             *@
        @* ============================================================================= *@
        @* Tech Minimal: sharp top border, monospace text, icon links                    *@
        @* ============================================================================= *@
        <footer style="background-color: var(--bg-card); border-top: 1px solid var(--border);">
            <div class="max-w-[1440px] mx-auto px-4 sm:px-6 py-6">

                @* Social Links Row *@
                <div class="flex items-center justify-center gap-6 mb-4">
                    @* Portfolio (Web Site) *@
                    <a href="https://mehmetcankocakurt.com" target="_blank" rel="noopener noreferrer"
                       class="transition-colors" style="color: var(--text-muted); text-decoration: none;"
                       onmouseenter="this.style.color='var(--accent)';" onmouseleave="this.style.color='var(--text-muted)';"
                       aria-label="Portfolio">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="square" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
                        </svg>
                    </a>

                    @* GitHub *@
                    <a href="https://github.com/CixxMemo" target="_blank" rel="noopener noreferrer"
                       class="transition-colors" style="color: var(--text-muted); text-decoration: none;"
                       onmouseenter="this.style.color='var(--accent)';" onmouseleave="this.style.color='var(--text-muted)';"
                       aria-label="GitHub">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"></path>
                        </svg>
                    </a>

                    @* LinkedIn *@
                    <a href="https://linkedin.com/in/mehmetcankocakurt" target="_blank" rel="noopener noreferrer"
                       class="transition-colors" style="color: var(--text-muted); text-decoration: none;"
                       onmouseenter="this.style.color='var(--accent)';" onmouseleave="this.style.color='var(--text-muted)';"
                       aria-label="LinkedIn">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
                        </svg>
                    </a>

                    @* Twitter (X) *@
                    <a href="https://x.com/CixxMemo" target="_blank" rel="noopener noreferrer"
                       class="transition-colors" style="color: var(--text-muted); text-decoration: none;"
                       onmouseenter="this.style.color='var(--accent)';" onmouseleave="this.style.color='var(--text-muted)';"
                       aria-label="Twitter (X)">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
                        </svg>
                    </a>
                </div>

                @* Copyright Text *@
                <p class="text-center font-mono text-xs" style="color: var(--text-muted);">
                    &copy; @DateTime.Now.Year DevCoreBlog. All rights reserved.
                </p>

            </div>
        </footer>
    </div>

    @* ============================================================================= *@
    @* JavaScript — Mobile menu toggle + Dark mode toggle                             *@
    @* ============================================================================= *@
    <script>
        // =================================================================
        // Mobile Menu Toggle
        // =================================================================
        // Clicking the hamburger button shows/hides the mobile navigation
        document.getElementById('mobile-menu-button').addEventListener('click', function() {
            var menu = document.getElementById('mobile-menu');
            menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        });

        // =================================================================
        // Theme Toggle (Dark/Light Mode)
        // =================================================================
        // How it works:
        //   1. On page load, check if dark mode is active
        //   2. Show the correct icon (sun = currently dark, moon = currently light)
        //   3. On button click, toggle between dark and light
        //   4. Save the choice to localStorage so it persists across page reloads
        // =================================================================

        // Grab the icon elements
        var darkIcon = document.getElementById('theme-toggle-dark-icon');   // Moon icon (shown when light mode is active)
        var lightIcon = document.getElementById('theme-toggle-light-icon'); // Sun icon (shown when dark mode is active)

        // Check if dark mode is currently active
        // Dark mode is active if: user set it manually OR system prefers dark
        var isDark = document.documentElement.classList.contains('dark');

        // Show the correct icon based on current state
        // When dark mode is ON → show sun icon (so user can switch to light)
        // When dark mode is OFF → show moon icon (so user can switch to dark)
        if (isDark) {
            lightIcon.classList.remove('hidden');
        } else {
            darkIcon.classList.remove('hidden');
        }

        // Toggle button click handler
        document.getElementById('theme-toggle').addEventListener('click', function() {
            // Toggle the icons
            darkIcon.classList.toggle('hidden');
            lightIcon.classList.toggle('hidden');

            // Toggle the 'dark' class on <html>
            var isCurrentlyDark = document.documentElement.classList.contains('dark');

            if (isCurrentlyDark) {
                // Switch to light mode
                document.documentElement.classList.remove('dark');
                localStorage.setItem('theme', 'light');
            } else {
                // Switch to dark mode
                document.documentElement.classList.add('dark');
                localStorage.setItem('theme', 'dark');
            }
        });
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* ============================================================================= *@
    @* Prism.js — Syntax Highlighting Scripts                                        *@
    @* ============================================================================= *@
    @* prism-core: The main engine that walks the DOM and highlights <code> blocks.  *@
    @* prism-autoloader: Detects the "language-*" class and loads the grammar file   *@
    @*   on demand (e.g., prism-csharp.min.js). This avoids loading all languages.   *@
    @* prism-show-language: Adds a small "C#" / "Python" label to each code block    *@
    @*   so readers know which language they are looking at.                         *@
    @* ============================================================================= *@
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.30.0/components/prism-core.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.30.0/plugins/autoloader/prism-autoloader.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.30.0/plugins/show-language/prism-show-language.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
