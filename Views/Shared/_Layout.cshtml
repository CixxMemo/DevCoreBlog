@* ============================================================================= *@
@* _Layout.cshtml — Public Site Master Layout (Tech Minimal & Merlin Kazanı Style)*@
@* ============================================================================= *@
@* This layout structures the site with a fixed left sidebar (Tech Minimal)      *@
@* and a flexible main content area for the middle feed and right trending bar.  *@
@*                                                                              *@
@* Architecture:                                                                *@
@*   - Body: flex container with flat background                                *@
@*   - Sidebar: fixed w-64 panel with sharp 2px border, zero radius, flat colors*@
@*   - Main: flex-1 ml-64 content canvas with gap for center/right columns       *@
@* ============================================================================= *@

@inject DevCoreBlog.Data.ApplicationDbContext DbContext

<!DOCTYPE html>
<html lang="tr">
<head>
    <script>
        // Dark mode preference initialization to prevent flash
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DevCoreBlog</title>
    
    @* Open Graph (OG) Meta Tags for Social Previews *@
    <meta property="og:title" content="@(ViewBag.OgTitle ?? ViewData["Title"])" />
    <meta property="og:description" content="@(ViewBag.OgDescription ?? "DevCoreBlog - ASP.NET Core, C#, ve modern web geliştirme hakkında teknik yazılar")" />
    <meta property="og:type" content="@(ViewBag.OgType ?? "website")" />
    <meta property="og:url" content="@(ViewBag.OgUrl ?? Context.Request.Path)" />
    <meta property="og:site_name" content="DevCoreBlog" />
    
    @* Twitter Card Meta Tags *@
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@(ViewBag.OgTitle ?? ViewData["Title"])" />
    <meta name="twitter:description" content="@(ViewBag.OgDescription ?? "DevCoreBlog - ASP.NET Core, C#, ve modern web geliştirme hakkında teknik yazılar")" />
    
    @* Google Fonts — JetBrains Mono for tech headings/UI, Inter for body text *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700;800&display=swap" rel="stylesheet">
    
    @* Tailwind CSS Play CDN with Tech Minimal Flat Configuration *@
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'sans-serif'],
                        mono: ['JetBrains Mono', 'ui-monospace', 'SFMono-Regular', 'Menlo', 'Monaco', 'Consolas', 'monospace'],
                    },
                    colors: {
                        primary: '#4f46e5',      // Flat Indigo accent for badges and active states
                        background: '#f9fafb',   // Main page background
                        surface: '#ffffff',      // Card and sidebar panel surface
                        border: '#1f2937',       // High-contrast sharp borders
                        accent: {
                            DEFAULT: '#4f46e5',
                            light: '#6366f1',
                            dark: '#4338ca',
                        },
                    },
                    borderRadius: {
                        'none': '0',
                        'sm': '0',
                        'DEFAULT': '0',
                        'md': '0',
                        'lg': '0',
                        'xl': '0',
                        '2xl': '0',
                        '3xl': '0',
                        'full': '0',
                    },
                },
            },
        }
    </script>
    
    @* Site Custom CSS *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @* Prism.js Syntax Highlighting Styles *@
    <link href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.30.0/themes/prism-tomorrow.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.30.0/plugins/show-language/prism-show-language.min.css" rel="stylesheet" />
</head>
<body class="flex bg-background min-h-screen text-gray-900 font-sans">

    @* ============================================================================= *@
    @* LEFT SIDEBAR — Tech Minimal Fixed Category & Navigation Panel (Faz 2)         *@
    @* ============================================================================= *@
    @* Fixed w-64 sidebar with 2px solid border, zero shadows, flat list links.       *@
    <aside class="w-64 fixed top-0 left-0 h-screen bg-surface border-r-2 border-border flex flex-col justify-between z-40 overflow-y-auto">
        <div>
            @* Logo Block — Sharp monospace branding *@
            <div class="p-4 border-b-2 border-border bg-surface">
                <a href="/" class="block font-mono font-black text-xl tracking-tight text-gray-900 no-underline hover:text-primary">
                    <span class="text-primary">DEV</span>CORE<span class="text-xs ml-1 font-mono uppercase bg-border text-white px-1.5 py-0.5">BLOG</span>
                </a>
            </div>

            @* Navigation Menu Links — Merlin'in Kazanı style list with sharp hover *@
            <nav class="flex flex-col">
                <a href="/" class="block py-3 px-4 hover:bg-border hover:text-white rounded-none border-b border-gray-200 transition-none font-bold text-sm text-gray-900 no-underline">
                    Ana Sayfa
                </a>
                <a href="/kategori/haberler" class="block py-3 px-4 hover:bg-border hover:text-white rounded-none border-b border-gray-200 transition-none font-bold text-sm text-gray-900 no-underline">
                    Haberler
                </a>
                <a href="/kategori/kesfet" class="block py-3 px-4 hover:bg-border hover:text-white rounded-none border-b border-gray-200 transition-none font-bold text-sm text-gray-900 no-underline">
                    Keşfet
                </a>
                <a href="/kategori/vibe-coding" class="block py-3 px-4 hover:bg-border hover:text-white rounded-none border-b border-gray-200 transition-none font-bold text-sm text-gray-900 no-underline">
                    Vibe Coding
                </a>
                <a href="/kategori/ai" class="block py-3 px-4 hover:bg-border hover:text-white rounded-none border-b border-gray-200 transition-none font-bold text-sm text-gray-900 no-underline">
                    AI
                </a>
                <a href="/kategori/felsefe" class="block py-3 px-4 hover:bg-border hover:text-white rounded-none border-b border-gray-200 transition-none font-bold text-sm text-gray-900 no-underline">
                    Felsefe
                </a>

                @* Dynamic Categories from database (rendered if available) *@
                @if (DbContext.Categories.Any())
                {
                    <div class="px-4 py-2 text-[11px] font-mono font-bold uppercase tracking-wider text-gray-500 bg-gray-50 border-b border-gray-200">
                        Kategoriler
                    </div>
                    @foreach (var cat in DbContext.Categories.ToList())
                    {
                        <a href="/kategori/@cat.Slug" class="block py-2.5 px-4 hover:bg-border hover:text-white rounded-none border-b border-gray-100 transition-none text-xs font-semibold text-gray-700 no-underline">
                            # @cat.Name
                        </a>
                    }
                }
            </nav>
        </div>

        @* Sidebar Footer — Authentication links & Dark mode toggle *@
        <div class="p-4 border-t-2 border-border bg-gray-50">
            <div class="flex items-center justify-between mb-2">
                <a href="/Account/Login" class="text-xs font-mono font-bold text-primary hover:underline no-underline">
                    [Giriş Yap]
                </a>
                <button id="theme-toggle" type="button" aria-label="Toggle Dark Mode" class="p-1 text-gray-700 hover:text-primary cursor-pointer bg-transparent border-none">
                    <svg id="theme-toggle-dark-icon" class="w-4 h-4 hidden" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
                    </svg>
                    <svg id="theme-toggle-light-icon" class="w-4 h-4 hidden" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4.22 4.22a1 1 0 011.415 0l.884.884a1 1 0 01-1.414 1.415l-.884-.884a1 1 0 010-1.415zM10 6a4 4 0 100 8 4 4 0 000-8zm-4.22 8.22a1 1 0 01-1.415 0l-.884-.884a1 1 0 011.414-1.415l.884.884a1 1 0 010 1.415zM2 10a1 1 0 011-1h1a1 1 0 110 2H3a1 1 0 01-1-1zm15 0a1 1 0 011-1h1a1 1 0 110 2h-1a1 1 0 01-1-1zM4.22 4.22a1 1 0 010 1.415l-.884.884a1 1 0 01-1.414-1.415l.884-.884a1 1 0 011.415 0zM15.78 15.78a1 1 0 010 1.415l-.884.884a1 1 0 01-1.414-1.415l.884-.884a1 1 0 011.415 0z"></path>
                    </svg>
                </button>
            </div>
            <p class="text-[10px] font-mono text-gray-500 text-center m-0">
                &copy; @DateTime.Now.Year DevCoreBlog
            </p>
        </div>
    </aside>

    @* ============================================================================= *@
    @* RIGHT MAIN CONTENT AREA (Faz 2 Layout Canvas)                                 *@
    @* ============================================================================= *@
    @* Contains main content and right sidebar columns with flex and gap             *@
    <main class="flex-1 ml-64 p-6 lg:p-8 flex gap-8 min-w-0">
        @RenderBody()
    </main>

    @* Dark Mode Toggle Logic *@
    <script>
        var darkIcon = document.getElementById('theme-toggle-dark-icon');
        var lightIcon = document.getElementById('theme-toggle-light-icon');
        var isDark = document.documentElement.classList.contains('dark');

        if (isDark) {
            if (lightIcon) lightIcon.classList.remove('hidden');
        } else {
            if (darkIcon) darkIcon.classList.remove('hidden');
        }

        var themeToggleBtn = document.getElementById('theme-toggle');
        if (themeToggleBtn) {
            themeToggleBtn.addEventListener('click', function() {
                if (darkIcon) darkIcon.classList.toggle('hidden');
                if (lightIcon) lightIcon.classList.toggle('hidden');

                var isCurrentlyDark = document.documentElement.classList.contains('dark');
                if (isCurrentlyDark) {
                    document.documentElement.classList.remove('dark');
                    localStorage.setItem('theme', 'light');
                } else {
                    document.documentElement.classList.add('dark');
                    localStorage.setItem('theme', 'dark');
                }
            });
        }
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* Prism.js Highlighting Scripts *@
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.30.0/components/prism-core.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.30.0/plugins/autoloader/prism-autoloader.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.30.0/plugins/show-language/prism-show-language.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
