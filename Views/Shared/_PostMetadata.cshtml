@model DevCoreBlog.Core.ReadModels.PublicPostSummary
@using System.Globalization
<div class="post-metadata">
    <time datetime="@Model.PublishDate.ToString("O", CultureInfo.InvariantCulture)">@SiteDates.Date(Model.PublishDate)</time>
    <span>@Model.ViewCount görüntüleme</span>
    @if (Model.ReadingMinutes is { } minutes) { <span>@minutes dk okuma</span> }
</div>
