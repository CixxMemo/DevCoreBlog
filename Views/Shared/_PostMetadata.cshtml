@model DevCoreBlog.Core.Entities.Post
@using System.Globalization
@* Preserve the existing display culture; site timezone formatting belongs to F42. *@
<div class="post-metadata">
    <time datetime="@Model.PublishDate.ToString("O", CultureInfo.InvariantCulture)">@Model.PublishDate.ToString("MMM dd, yyyy")</time>
    <span>@Model.ViewCount views</span>
</div>
