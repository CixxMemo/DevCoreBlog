@model IReadOnlyList<Category>

<div class="bg-white dark:bg-[#121215] border-2 border-gray-900 dark:border-zinc-700 rounded-none p-4">
    <div class="flex items-center gap-2 border-b-2 border-gray-900 dark:border-zinc-700 pb-2 mb-3">
        <span class="w-2 h-2 bg-gray-900 dark:bg-zinc-200 inline-block"></span>
        <h3 class="font-mono font-bold text-xs uppercase tracking-wider text-gray-900 dark:text-zinc-100 m-0">
            Topics
        </h3>
    </div>
    <div class="flex flex-wrap gap-1.5">
        @foreach (var category in Model)
        {
            <a href="@PublicUrls.CategoryPath(category.Slug)" class="bg-gray-100 dark:bg-zinc-800 hover:bg-gray-900 hover:text-white dark:hover:bg-primary dark:hover:text-white border border-gray-300 dark:border-zinc-700 text-gray-800 dark:text-zinc-200 text-xs font-mono font-bold px-2 py-1 no-underline transition-none">
                #@category.Name
            </a>
        }
    </div>
@if (Model.Count == 0)
{
    <p class="text-sm">No active topics yet.</p>
}
</div>
