@* ============================================================================= *@
@* _AdminLayout.cshtml — Hardened Admin Panel Shell (Tech-Minimal Brutalist)     *@
@* ============================================================================= *@
@* This layout is the unified master template for the DevCoreBlog Admin Panel. *@
@* Adheres strictly to the Tech-Minimal design philosophy:                       *@
@*   - Sharp corners ONLY (rounded-none), flat high-contrast 2px black borders.   *@
@*   - Fixed left sidebar navigation (Dashboard, Posts, Categories, Automations).*@
@*   - Non-blocking Vanilla JS Toast Notification system + TempData support.     *@
@*   - Monospace typography accents for a developer-first command center feel.   *@
@* ============================================================================= *@

@{
    // Retrieve current controller and action from ASP.NET Core RouteData
    // Used for active sidebar link detection and dynamic breadcrumbs
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    // Map controller names to clean English display labels
    var controllerLabels = new Dictionary<string, string>
    {
        { "Admin", "Admin" },
        { "AdminCategory", "Categories" },
        { "AdminPost", "Posts" },
        { "AdminDocument", "Belgeler" }
    };

    // Map action names to human-readable breadcrumb segments
    var actionLabels = new Dictionary<string, string>
    {
        { "Index", "Overview" },
        { "Create", "New" },
        { "Edit", "Edit" },
        { "Dashboard", "Dashboard" },
        { "Automations", "Automations & API" },
        { "Preview", "Önizleme" }
    };

    var currentControllerLabel = controllerLabels.ContainsKey(currentController)
        ? controllerLabels[currentController]
        : currentController;

    var currentActionLabel = actionLabels.ContainsKey(currentAction)
        ? actionLabels[currentAction]
        : currentAction;

    // Get the authenticated admin username (defaults to "Admin" if null)
    var userName = User.Identity?.Name ?? "Admin";

    // Server-side TempData flash messages to be consumed by the Toast system
    var tempSuccess = TempData["Success"]?.ToString();
    var tempError = TempData["Error"]?.ToString();
    var tempMessage = TempData["Message"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <partial name="_SeoHead" model="@PageMetadata.Private(ViewData["Title"]?.ToString() ?? "Admin", Context.Request.Path.ToUriComponent())" />

    @* ========================================================================= *@
    @* Google Fonts — Inter (UI Sans) & JetBrains Mono (Technical Accents)       *@
    @* ========================================================================= *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />

    @* ========================================================================= *@
    @* Compiled Tailwind CSS — existing admin theme                         *@
    @* ========================================================================= *@
    <link rel="stylesheet" href="~/generated/tailwind-admin.css" asp-append-version="true" />

    @* ========================================================================= *@
    @* Tech Minimal Global Styles & Reset                                        *@
    @* ========================================================================= *@
    <link rel="stylesheet" href="~/css/admin-shell.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-mobile.css" asp-append-version="true" />
    
    @* Markdown / Toast UI Editor CSS for editor pages *@
    <link rel="stylesheet" href="~/generated/toastui/toastui-editor.min.css" asp-append-version="true" />
</head>
<body class="bg-[#f4f4f0] text-black font-sans antialiased selection:bg-black selection:text-white">
    
    @* ========================================================================= *@
    @* MAIN ADMIN SHELL — Full Height Responsive Flex Layout                     *@
    @* ========================================================================= *@
    <div class="admin-shell flex flex-col md:flex-row h-screen overflow-hidden">

        <div id="admin-drawer-backdrop" class="admin-drawer-backdrop" aria-hidden="true"></div>

        @* ===================================================================== *@
        @* FIXED LEFT SIDEBAR (w-64, border-r-2 border-black, bg-white)          *@
        @* ===================================================================== *@
        <aside id="admin-sidebar" class="admin-sidebar flex-shrink-0 border-r-2 border-black bg-white flex flex-col justify-between" aria-label="Admin navigation" aria-hidden="false">
            
            @* Top Section: Brand & Primary Navigation *@
            <div class="flex flex-col">
                
                @* Brand Header Box *@
                <div class="p-4 border-b-2 border-black bg-white">
                    <a asp-controller="Admin" asp-action="Dashboard" class="block">
                        <div class="font-mono text-[10px] font-bold text-neutral-500 uppercase tracking-widest leading-tight">
                            TERMINAL // ADMIN v8.0
                        </div>
                        <div class="text-lg font-black tracking-tight uppercase mt-0.5 text-black flex items-center gap-2">
                            <span>DevCoreBlog</span>
                            <span class="inline-block w-2 h-2 bg-emerald-500"></span>
                        </div>
                    </a>
                </div>

                @* Primary Navigation Group *@
                <nav class="flex flex-col">
                    <div class="px-4 py-2 bg-neutral-100 border-b border-black font-mono text-[10px] font-bold uppercase tracking-wider text-neutral-600">
                        // CORE NAVIGATION
                    </div>

                    @* 1. Dashboard *@
                    <a asp-controller="Admin" asp-action="Dashboard" 
                       class="admin-nav-item @(currentController == "Admin" && currentAction == "Dashboard" ? "active" : "")">
                        <svg class="w-4 h-4 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                        </svg>
                        Dashboard
                    </a>

                    @* 2. Posts *@
                    <a asp-controller="AdminPost" asp-action="Index" 
                       class="admin-nav-item @(currentController == "AdminPost" ? "active" : "")">
                        <svg class="w-4 h-4 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        Posts
                    </a>

                    @* 3. Categories *@
                    <a asp-controller="AdminCategory" asp-action="Index" 
                       class="admin-nav-item @(currentController == "AdminCategory" ? "active" : "")">
                        <svg class="w-4 h-4 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                        </svg>
                        Categories
                    </a>

                    @* 4. Automations & API Hub *@
                    <a asp-controller="Admin" asp-action="Automations" 
                       class="admin-nav-item @(currentController == "Admin" && currentAction == "Automations" ? "active" : "")">
                        <svg class="w-4 h-4 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                        Automations & API
                    </a>
                </nav>
            </div>

            @* Bottom Section: System & Logout *@
            <div class="flex flex-col border-t-2 border-black bg-white">
                <div class="px-4 py-2 bg-neutral-100 border-b border-black font-mono text-[10px] font-bold uppercase tracking-wider text-neutral-600">
                    // SYSTEM & CONTROLS
                </div>

                @* 5. View Public Site (New Tab) *@
                <a href="/" target="_blank" 
                   class="admin-nav-item text-neutral-800">
                    <svg class="w-4 h-4 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                    </svg>
                    View Public Site
                </a>

                @* 6. Sign Out Form *@
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                    <button type="submit" 
                            class="admin-nav-item w-full text-left text-rose-700 hover:text-white hover:bg-rose-700 border-b-0">
                        <svg class="w-4 h-4 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                        </svg>
                        Sign Out
                    </button>
                </form>
            </div>
        </aside>

        @* ===================================================================== *@
        @* MAIN CONTENT AREA (Header + View Body)                                *@
        @* ===================================================================== *@
        <div class="flex-1 flex flex-col min-w-0 min-h-0 overflow-hidden bg-[#f4f4f0]">
            
            @* Top Navigation / Breadcrumb Header *@
            <header class="admin-header border-b-2 border-black bg-white px-6 py-3.5 flex items-center justify-between flex-shrink-0">

                <button id="admin-menu-toggle" type="button" class="admin-menu-toggle" aria-controls="admin-sidebar" aria-expanded="false" aria-label="Open admin navigation">
                    <span aria-hidden="true">☰</span>
                </button>
                
                @* Left: Brutalist Breadcrumb Trail *@
                <div class="flex items-center gap-2 font-mono text-xs font-bold uppercase tracking-wider text-black">
                    <a asp-controller="Admin" asp-action="Dashboard" class="text-neutral-500 hover:text-black transition-none">
                        DEVCORE
                    </a>
                    <span class="text-neutral-400">//</span>
                    <span class="text-neutral-700">@currentControllerLabel</span>
                    @if (!string.IsNullOrEmpty(currentActionLabel) && currentActionLabel != currentControllerLabel)
                    {
                        <span class="text-neutral-400">//</span>
                        <span class="bg-black text-white px-1.5 py-0.5">@currentActionLabel</span>
                    }
                </div>

                @* Right: Admin Status & Profile Badge *@
                <div class="flex items-center gap-3">
                    <div class="border-2 border-black bg-neutral-100 px-3 py-1 font-mono text-xs font-bold text-black flex items-center gap-2">
                        <span class="w-2 h-2 bg-emerald-500 inline-block"></span>
                        <span>AUTH: @userName</span>
                    </div>
                </div>
            </header>

            @* Scrollable Main Content Body *@
            <main id="admin-page-content" class="flex-1 min-w-0 overflow-y-auto p-6 md:p-8">
                @RenderBody()
            </main>
        </div>
    </div>

    @* ========================================================================= *@
    @* GLOBAL TOAST NOTIFICATION CONTAINER (Fixed Top-Right)                    *@
    @* ========================================================================= *@
    <div id="admin-toast-container" data-success="@tempSuccess" data-error="@tempError" data-message="@tempMessage"
         class="fixed top-6 right-6 z-50 flex flex-col gap-2.5 max-w-sm w-full pointer-events-none" 
         aria-live="polite">
    </div>


    @* ========================================================================= *@
    @* GLOBAL CLIENT-SIDE SCRIPTS & TOAST ENGINE                                 *@
    @* ========================================================================= *@
    <script src="~/js/admin-drawer.js" asp-append-version="true"></script>
    
    @* Toast UI Editor core JS library for markdown editing *@
    <script src="~/generated/toastui/toastui-editor-all.min.js" asp-append-version="true"></script>

    <script src="~/js/admin-toast.js" asp-append-version="true"></script>

    @* Render view-specific scripts section if declared *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
