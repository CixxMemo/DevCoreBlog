@model IReadOnlyList<DevCoreBlog.Core.ReadModels.TopReadPost>
<section id="most-read" aria-labelledby="most-read-heading" class="bg-white dark:bg-[#121215] border-2 border-gray-900 dark:border-zinc-700 p-4">
    <h2 id="most-read-heading" class="font-mono font-bold text-lg mb-2">Most Read</h2>
    <p class="text-sm mb-4">All-time article requests, including bots.</p>
    @if (Model.Count > 0)
    {
        <ol>
            @for (var index = 0; index < Model.Count; index++)
            {
                var post = Model[index];
                <li class="border-t border-gray-200 dark:border-zinc-700 py-3">
                    <span class="text-sm font-mono">@(index + 1). @post.ViewCount views</span>
                    <a href="@PublicUrls.PostPath(post.Slug)" class="block font-bold underline mt-1 break-words">@post.Title</a>
                    <span class="text-sm">@post.CategoryName</span>
                </li>
            }
        </ol>
    }
    else
    {
        <p class="text-sm">No published articles to rank yet.</p>
    }
</section>
