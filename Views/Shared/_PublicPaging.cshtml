@model DevCoreBlog.Models.Public.PublicPagingModel
@if (Model.TotalPages > 1)
{
    <nav aria-label="Yazı sayfaları" class="flex flex-wrap gap-4 items-center justify-between border-t-2 border-gray-900 dark:border-zinc-700 pt-6 font-mono text-sm">
        @if (Model.Page > 1)
        {
            <a asp-controller="Home" asp-action="@Model.Action" asp-route-slug="@Model.Slug"
               asp-route-kind="@Model.Kind" asp-route-query="@Model.Query" asp-route-category="@Model.Category"
               asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@(Model.PageSize == 9 ? null : Model.PageSize)" class="underline">&lt; Önceki</a>
        }
        <span>Sayfa @Model.Page / @Model.TotalPages</span>
        @if (Model.Page < Model.TotalPages)
        {
            <a asp-controller="Home" asp-action="@Model.Action" asp-route-slug="@Model.Slug"
               asp-route-kind="@Model.Kind" asp-route-query="@Model.Query" asp-route-category="@Model.Category"
               asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@(Model.PageSize == 9 ? null : Model.PageSize)" class="underline">Sonraki &gt;</a>
        }
    </nav>
}
@if (Model.ActualTotalPages > Model.TotalPages)
{
    <p class="mt-4">Yalnızca ilk @Model.TotalPages sayfa gösterilebilir. Daha ilgili yazılar için aramanızı veya kategorinizi daraltın.</p>
}
