@* A native GET form remains usable without JavaScript on every public page. *@
<form action="/ara" method="get" role="search" aria-label="Yazı arama" class="public-search">
    <label for="global-search-input" class="sr-only">Yazılarda ara</label>
    <input type="search" id="global-search-input" name="query" maxlength="100"
           value="@(ViewData["SearchQuery"] as string ?? string.Empty)"
           placeholder="Yazılarda ara…" autocomplete="off" />
    @if (ViewData["SearchCategory"] is string categorySlug)
    {
        <input type="hidden" name="category" value="@categorySlug" />
    }
    @if (ViewData["SearchPageSize"] is int size && size != 9)
    {
        <input type="hidden" name="pageSize" value="@size" />
    }
    @if (ViewData["SearchKind"] is string kind && !string.IsNullOrEmpty(kind))
    {
        <input type="hidden" name="kind" value="@kind" />
    }
    <button type="submit">Ara</button>
    <kbd class="public-search-shortcut" aria-hidden="true">Ctrl + K / ⌘K</kbd>
</form>
