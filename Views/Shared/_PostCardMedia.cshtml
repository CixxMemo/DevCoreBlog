@model DevCoreBlog.Models.Public.PostCardModel
@* Covers are decorative within a link already named by the post title. *@
<div class="post-card-media">
    @if (!string.IsNullOrEmpty(Model.Post.ThumbnailUrl))
    {
        @* Dimensions reserve the existing 16:9 crop, not provider metadata. *@
        <img src="@Model.Post.ThumbnailUrl" alt="" width="1600" height="900"
             loading="@(Model.Presentation == DevCoreBlog.Models.Public.PostCardPresentation.Featured ? "eager" : "lazy")"
             fetchpriority="@(Model.Presentation == DevCoreBlog.Models.Public.PostCardPresentation.Featured ? "high" : "auto")" decoding="async" />
    }
    else
    {
        <div class="post-cover-placeholder" aria-hidden="true"><span>DEVCORE // POST</span></div>
    }
</div>
