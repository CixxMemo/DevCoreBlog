# =============================================================================
# DevCoreBlog - Environment Variables Example
# Local Development: copy this file to .env and fill in your actual values.
# Production uses an external service EnvironmentFile; see docs/DEPLOYMENT_SECURITY.md.
# =============================================================================

# PostgreSQL Connection String
DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=DevCoreBlogDb;Username=postgres;Password=your_password

# Required admin panel credentials. Generate the versioned PBKDF2 hash with:
# dotnet run --project tools/DevCoreBlog.PasswordHashTool
# Never store the plaintext password in this file or pass it as a shell argument.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Admin session policy. Increment the version to revoke every existing admin
# session without changing the password. The default lifetime is 30 minutes.
ADMIN_SESSION_VERSION=1
ADMIN_SESSION_LIFETIME_SECONDS=1800

# Publication forms use this IANA site time zone; database timestamps stay UTC.
SITE_TIME_ZONE=Europe/Istanbul

# Required public HTTPS origin in production; no path/query/fragment/credentials.
# Development may use a loopback HTTP origin; never derive public links from Host.
SITE_URL=https://your-blog.example

# Production only: an existing absolute directory on persistent, encrypted
# storage. On Unix, grant access only to the application account (mode 700).
DATA_PROTECTION_KEYS_PATH=

# CLOUDINARY CLOUD Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Inbound Webhook Secret (n8n, Make.com)
WEBHOOK_API_SECRET=your_secure_webhook_secret_here
# Default false. Set true only when authenticated automation may publish directly.
ALLOW_WEBHOOK_PUBLISH=false

# Public Portfolio Showcase CORS Allowed Origins (comma-separated)
PORTFOLIO_CORS_ORIGIN=http://localhost:3000,https://your-portfolio.example

# Production target: one Linux server, Nginx -> one Kestrel process on IPv4 loopback.
# Set in the service environment (Production never reads .env).
# Leave empty for ordinary local Development; nginx-loopback also supports local proxy tests.
DEPLOYMENT_PROFILE=
# Production nginx-loopback: ASPNETCORE_URLS=http://127.0.0.1:5000
# Never enable ASPNETCORE_FORWARDEDHEADERS_ENABLED or bind Kestrel to 0.0.0.0.
# Host allowlist is derived from SITE_URL; wildcard AllowedHosts overrides are ignored.
