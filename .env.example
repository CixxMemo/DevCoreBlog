# =============================================================================
# DevCoreBlog - Environment Variables Example
# Copy this file to .env and fill in your actual values.
# =============================================================================

# PostgreSQL Connection String
DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=DevCoreBlogDb;Username=postgres;Password=your_password

# Required admin panel credentials. Generate the versioned PBKDF2 hash with:
# dotnet run --project tools/DevCoreBlog.PasswordHashTool
# Never store the plaintext password in this file or pass it as a shell argument.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Admin session policy. Increment the version to revoke every existing admin
# session without changing the password. The default lifetime is 30 minutes.
ADMIN_SESSION_VERSION=1
ADMIN_SESSION_LIFETIME_SECONDS=1800

# Production only: an existing absolute directory on persistent, encrypted
# storage. On Unix, grant access only to the application account (mode 700).
DATA_PROTECTION_KEYS_PATH=

# CLOUDINARY CLOUD Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Inbound Webhook Secret (n8n, Make.com)
WEBHOOK_API_SECRET=your_secure_webhook_secret_here

# Public Portfolio Showcase CORS Allowed Origins (comma-separated)
PORTFOLIO_CORS_ORIGIN=http://localhost:3000,https://mehmetcan.dev
