<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Git ignores do not control SDK discovery or publish; exclude private inputs here too. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);node_modules/**;frontend/**;scripts/frontend/**;.env;.env.*;**/.env;**/.env.*;docs/**;.local/devcoreblog_vol1/**;AGENTS.md;.agents/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CloudinaryDotNet" Version="1.29.3" />
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="DevCoreBlog.Core\DevCoreBlog.Core.csproj" />
    <ProjectReference Include="DevCoreBlog.Data\DevCoreBlog.Data.csproj" />
    <ProjectReference Include="DevCoreBlog.Services\DevCoreBlog.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="DevCoreBlog.Core\**" />
    <Content Remove="DevCoreBlog.Core\**" />
    <EmbeddedResource Remove="DevCoreBlog.Core\**" />
    <None Remove="DevCoreBlog.Core\**" />

    <Compile Remove="DevCoreBlog.Data\**" />
    <Content Remove="DevCoreBlog.Data\**" />
    <EmbeddedResource Remove="DevCoreBlog.Data\**" />
    <None Remove="DevCoreBlog.Data\**" />

    <Compile Remove="DevCoreBlog.Services\**" />
    <Content Remove="DevCoreBlog.Services\**" />
    <EmbeddedResource Remove="DevCoreBlog.Services\**" />
    <None Remove="DevCoreBlog.Services\**" />

    <Compile Remove="tools\**" />
    <Content Remove="tools\**" />
    <EmbeddedResource Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="licenses/SkiaSharp/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Build before static web assets are discovered, including on a clean checkout. -->
  <Target Name="InstallFrontendDependencies" BeforeTargets="BuildFrontendAssets"
          Inputs="package.json;package-lock.json" Outputs="node_modules/.package-lock.json"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="npm ci --ignore-scripts --no-fund --no-audit" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
  <Target Name="BuildFrontendAssets" BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup>
      <Content Remove="wwwroot/generated/**" />
      <Content Include="wwwroot/generated/**" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
